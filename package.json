{
  "name": "dsh-collaborative-compaction",
  "version": "0.3.7",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./runtime": "./runtime.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "description": "DSH collaborative context compaction: existing summary + Claude native compaction + independent Terra review",
  "license": "MIT",
  "author": "ThirvenGree",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThirvenGree/dsh-collaborative-compaction.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "host.js",
    "runtime.js",
    "replay.js",
    "feedback.js",
    "policy-scope.js",
    "replay-schedule.js",
    "proposal.js",
    "harvest.js",
    "harvest-runner.js",
    "dynamic-bank.js",
    "challenge-bank.js",
    ".node-version",
    "scripts/check-dependencies.mjs",
    "examples/feedback-cases.json",
    "token-budget.js",
    "token-worker.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "patches",
    "install.ps1",
    "prepare-engine.ps1",
    "live-test.mjs",
    "replay-live.mjs",
    "replay-checkpoint.js",
    "calibration-budget.js"
  ],
  "dependencies": {
    "js-tiktoken": "1.0.21"
  }
}
