@@ -0,0 +1,39 @@
+import type { Session } from "./session.js";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+
+export function collaborativeEnabled(config: unknown): boolean {
+    const ext = (config as ResolvedKernelConfig | undefined)?.externalSummary;
+    return ext?.enabled === true && Array.isArray(ext.targets) && ext.targets.some((target) => target?.model === "dsh-collaborative-v1");
+}
+
+function copy<T>(value: T): T {
+    if (value instanceof Promise || typeof value === "function" || value === null || typeof value !== "object") return value;
+    if (value instanceof Map) return new Map([...value].map(([key, item]) => [key, copy(item)])) as T;
+    if (value instanceof Set) return new Set(value) as T;
+    if (value instanceof Date || value instanceof ArrayBuffer || ArrayBuffer.isView(value)) return structuredClone(value);
+    if (Array.isArray(value)) return value.map(copy) as T;
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, copy(item)])) as T;
+}
+
+/** The live session remains untouched while the existing engine works on its draft. */
+export function compressionDraft(session: Session): { draft: Session; commit(): void } {
+    const state = session.state;
+    const epoch = session.revisionEpoch;
+    const history = JSON.stringify(session.lastMessages);
+    const draft = copy(session);
+    return { draft, commit() {
+        if (session.state !== state || session.revisionEpoch !== epoch || JSON.stringify(session.lastMessages) !== history) {
+            throw new Error("Compression source changed; draft discarded");
+        }
+        const { lockChain, inFlight, lastSeen, ...changes } = draft;
+        void lockChain; void inFlight; void lastSeen;
+        Object.assign(session, changes);
+    } };
+}
+
+export function reviewedBlockSource(session: Session, blockId: string, fallback: string, config: unknown): string {
+    if (!collaborativeEnabled(config)) return fallback;
+    const original = session.blockContents.get(blockId)?.full?.text;
+    if (!original?.trim()) throw new Error("Original block history unavailable; refusing summary-only review");
+    return original;
+}
