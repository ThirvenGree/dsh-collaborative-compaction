index 0000000..8c85ef1
--- /dev/null
+++ b/src/collaborative-transaction.ts
@@ -0,0 +1,72 @@
+import { compressionDraftSessions, markDirty, type Session } from "./session.js";
+import { ccrEnabled, contentStoreOf } from "./store.js";
+import { isDeepStrictEqual } from "node:util";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+
+export function collaborativeEnabled(config: unknown): boolean {
+    const ext = (config as ResolvedKernelConfig | undefined)?.externalSummary;
+    return ext?.enabled === true && Array.isArray(ext.targets) && ext.targets.some((target) => target?.model === "dsh-collaborative-v1");
+}
+
+/** Only compression-owned fields are copied; runtime objects and lazy map identity stay live. */
+export function compressionDraft(session: Session): { draft: Session; commit(): void } {
+    const state = session.state, epoch = session.revisionEpoch;
+    const stateSnapshot = structuredClone(state);
+    const history = JSON.stringify(session.lastMessages);
+    const baseStats = structuredClone(session.stats), baseMetadata = structuredClone({ ...session.metadata });
+    const baseBlocks = new Map([...session.blockContents].map(([id, value]) => [id, structuredClone(value)]));
+    const baseLastCompress = structuredClone(session.lastCompress);
+    const liveStore = ccrEnabled(session) ? contentStoreOf(session) : session.contentStore;
+    const baseStore = liveStore ? JSON.parse(JSON.stringify(liveStore)) as NonNullable<Session["contentStore"]> : undefined;
+    const baseStoreDirty = session.contentStoreDirty;
+    const draft: Session = { ...session, state: structuredClone(state), stats: structuredClone(baseStats),
+        metadata: structuredClone(baseMetadata), meta: structuredClone(session.meta),
+        lastMessages: structuredClone(session.lastMessages), lastCompress: structuredClone(baseLastCompress),
+        contentStore: structuredClone(baseStore), blockContents: new Map([...baseBlocks].map(([id, value]) => [id, structuredClone(value)])) };
+    compressionDraftSessions.add(draft);
+    let committed = false;
+    return { draft, commit() {
+        if (committed) throw new Error("Compression transaction already committed");
+        if (session.state !== state || session.revisionEpoch !== epoch || !isDeepStrictEqual(session.state, stateSnapshot) || JSON.stringify(session.lastMessages) !== history) {
+            throw new Error("Compression source changed; draft discarded");
+        }
+        const operations: Array<() => void> = [];
+        function changes(base: Record<string, unknown>, next: Record<string, unknown>, live: Record<string, unknown>) {
+            for (const key of new Set([...Object.keys(base), ...Object.keys(next)])) {
+                if (isDeepStrictEqual(base[key], next[key]) && (key in base) === (key in next)) continue;
+                if (!isDeepStrictEqual(live[key], base[key]) || (key in live) !== (key in base)) throw new Error("Compression metadata changed");
+                operations.push(() => { if (key in next) live[key] = next[key]; else delete live[key]; });
+            }
+        }
+        changes(baseStats, draft.stats, session.stats);
+        changes(baseMetadata, draft.metadata, session.metadata);
+        for (const id of new Set([...baseBlocks.keys(), ...draft.blockContents.keys()])) {
+            const before = baseBlocks.get(id), after = draft.blockContents.get(id);
+            if (isDeepStrictEqual(before, after)) continue;
+            if (!isDeepStrictEqual(session.blockContents.get(id), before)) throw new Error("Compression block source changed");
+            operations.push(() => { if (after) session.blockContents.set(id, after); else session.blockContents.delete(id); });
+        }
+        if (!isDeepStrictEqual(baseLastCompress, draft.lastCompress)) {
+            if (!isDeepStrictEqual(session.lastCompress, baseLastCompress)) throw new Error("Compression receipt changed");
+            operations.push(() => { session.lastCompress = draft.lastCompress; });
+        }
+        if (!isDeepStrictEqual(baseStore, draft.contentStore)) {
+            if (session.contentStore !== liveStore || !isDeepStrictEqual(baseStore, liveStore ? JSON.parse(JSON.stringify(liveStore)) : undefined) || session.contentStoreDirty !== baseStoreDirty) throw new Error("Compression originals store changed");
+            operations.push(() => { session.contentStore = draft.contentStore; session.contentStoreDirty = draft.contentStoreDirty; });
+        }
+        // All conflict checks precede the synchronous commit. Preserve the LazyBlockContents instance.
+        for (const apply of operations) apply();
+        session.state = draft.state;
+        committed = true;
+        markDirty(session);
+    } };
+}
+
+export function reviewedBlockSource(session: Session, blockId: string, fallback: string, config: unknown): string {
+    if (!collaborativeEnabled(config)) return fallback;
+    const original = session.blockContents.get(blockId)?.full?.text;
+    if (!original?.trim()) throw new Error("Original block history unavailable; refusing summary-only review");
+    return original;
+}
+
+export function collaborativePlanningEnabled(config: unknown): boolean { return collaborativeEnabled(config) && (config as ResolvedKernelConfig).externalSummary?.modelPlanning !== false; }
