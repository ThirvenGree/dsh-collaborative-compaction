+process.env.COLLAB_FIXTURE_KEY = "fake";
+const SUMMARY = "Delivery is November 5. Budget is 1200 CNY. Do not publish until explicitly approved. The earlier November 3 date is superseded. Implementation is done, validation remains pending. Keep all original records recoverable.";
+const RAW = "Delivery changed from November 3 to November 5. Budget 1200 CNY. Do not publish. Implementation done, validation pending. ".repeat(100);
+async function fixture(fn: (ctx: ReturnType<typeof context>) => Promise<void>, reply: (n: number) => boolean = () => true, planning?: (input: {candidates:Array<{startId:string;endId:string}>}) => unknown) {
+    let n = 0;
+    const server = http.createServer((req, res) => { let body="";req.on("data",chunk=>body+=chunk);req.on("end", () => {
+        if (req.url === "/v1/plan") { res.setHeader("content-type", "application/json"); res.end(JSON.stringify(planning?planning(JSON.parse(body)):{decision:"legacy",ranges:[],reason:"fixture"})); return; }
+        if (!reply(++n)) { res.writeHead(401); res.end(JSON.stringify({error:"run=12345678-1234-1234-1234-123456789012 stage=fact-check"})); return; }
+        res.setHeader("content-type", "application/json"); res.end(JSON.stringify({ choices: [{ message: { content: SUMMARY }, finish_reason: "stop" }] }));
+    }); });
+    server.listen(0, "127.0.0.1"); await once(server, "listening");
+    try { await fn(context(`http://127.0.0.1:${(server.address() as import("node:net").AddressInfo).port}`)); }
+    finally { server.closeAllConnections(); await new Promise<void>((r) => server.close(() => r())); }
+}
+function context(url: string) {
+    const core = createCore(); const config = defaultConfig(400000) as ResolvedKernelConfig;
+    config.preserveRecentMessages = 0; config.preserveRecentTokens = 0; config.compress.minCompressRange = 100;
+    config.externalSummary = { enabled: true, targets: [{ name: "collaboration", model: "dsh-collaborative-v1", protocol: "openai", url, credentialRef: "env:COLLAB_FIXTURE_KEY", contextWindow: 1000000, outputTokens: 2000, stream: false }], budget: { totalTimeoutMs: 10000, targetTimeoutMs: 9000, maxSummaryBytes: 5000 }, concurrency: 1 };
+    const messages: CoreMessage[] = [{ id: "a", role: "assistant", contentType: "text", text: RAW }, { id: "u", role: "user", contentType: "text", text: "Proceed with validation." }, { id: "b", role: "assistant", contentType: "text", text: RAW }, { id: "latest", role: "user", contentType: "text", text: "Do not deploy." }];
+    const session = createSession("collab-" + Math.random());
+    session.state = core.processTurn({ messages, state: session.state, config, tokenCount: 30000, renderTags: "text-only" }).state;
+    return { core, config, session, messages, log: () => {} };
+}
