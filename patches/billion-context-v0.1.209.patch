diff --git a/src/collaborative-planner.ts b/src/collaborative-planner.ts
new file mode 100644
index 0000000..9c6e74b
--- /dev/null
+++ b/src/collaborative-planner.ts
@@ -0,0 +1,44 @@
+import type { CoreMessage } from "acp-kernel";
+import type { Session } from "./session.js";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+import { SummaryCredentialStore } from "./external-summary-credentials.js";
+export type PlanRange = { startId: string; endId: string };
+export type PlanDecision = { decision: "now" | "wait" | "uncertain" | "legacy"; ranges: PlanRange[]; reason: string };
+/** Model proposes only; eligible boundaries and the kernel's atomic preview remain authoritative. */
+export async function planHistory(config: ResolvedKernelConfig, session: Session, messages: CoreMessage[], ranges: PlanRange[], manual: boolean, signal?: AbortSignal): Promise<PlanDecision> {
+    if (config.externalSummary?.modelPlanning === false) return {decision:"legacy",ranges:[],reason:"Model planning disabled"};
+    if (!ranges.length) return { decision: "wait", ranges: [], reason: "No eligible history" };
+    const target = config.externalSummary?.targets.find(t => t.model === "dsh-collaborative-v1");
+    if (!target) throw new Error("Collaborative planner target missing");
+    const url = new URL(target.url);
+    if (!["127.0.0.1", "localhost", "[::1]"].includes(url.hostname) || url.protocol !== "http:") throw new Error("Planner requires the authenticated local adapter");
+    url.pathname = "/v1/plan";
+    const key = target.apiKey ?? new SummaryCredentialStore().resolve(target.credentialRef ?? "", process.env);
+    if (!key) throw new Error("Planner credential unavailable");
+    const rows = messages.map((m, i) => ({ ref: session.state.messageRefs.byRaw[m.id], index: i, role: m.role, text: (m.text ?? "").slice(0,500), excerpt: (m.text?.length ?? 0) > 500 }));
+    const positions = new Map(rows.filter(r=>r.ref).map(r => [r.ref, r.index]));
+    const eligible = ranges.filter(r => positions.has(r.startId) && positions.has(r.endId));
+    const visible = rows.filter(r => r.ref && eligible.some(e => r.index >= positions.get(e.startId)! && r.index <= positions.get(e.endId)!));
+    const input = { manual, contextLimit: config.modelContextLimit, latestUsageTokens: session.stats.lastInputTokens,
+        recentProtectedTokens: config.preserveRecentTokens, candidates: eligible,
+        messages: visible.length > 600 ? [...visible.slice(0,500), ...visible.slice(-100)] : visible,
+        omittedMessageCount: Math.max(0,visible.length-600), recentContext: rows.slice(-6) };
+    const timeout = AbortSignal.timeout(config.externalSummary?.budget.totalTimeoutMs ?? 180000);
+    const response = await fetch(url, { method: "POST", headers: { authorization: "Bearer " + key, "content-type": "application/json" }, body: JSON.stringify(input), signal: signal ? AbortSignal.any([signal, timeout]) : timeout });
+    if (!response.ok) {
+        const body = await response.json().catch(() => null);
+        const receipt = String(body?.error || "").match(/run=[0-9a-f-]{36} stage=planning\b/)?.[0] || "";
+        throw new Error("Planner HTTP " + response.status + " " + receipt);
+    }
+    const p = await response.json() as PlanDecision;
+    if (!["now","wait","uncertain","legacy"].includes(p.decision) || !Array.isArray(p.ranges) || p.ranges.length>32) throw new Error("Invalid planner response");
+    if(p.decision === "legacy") return p;
+    if ((p.decision === "now") !== (p.ranges.length > 0)) throw new Error("Invalid planner action");
+    const selected: Array<[number,number]> = [];
+    for (const r of p.ranges) {
+        const a=positions.get(r.startId), b=positions.get(r.endId);
+        if(a===undefined||b===undefined||a>b||!eligible.some(e=>a>=positions.get(e.startId)!&&b<=positions.get(e.endId)!)||selected.some(([x,y])=>a<=y&&b>=x)) throw new Error("Planner selected an invalid or overlapping range");
+        selected.push([a,b]);
+    }
+    return p;
+}
