@@ -0,0 +1,80 @@
+import { compressionDraftSessions, markDirty, type Session } from "./session.js";
+import { ccrEnabled, contentStoreOf } from "./store.js";
+import { isDeepStrictEqual } from "node:util";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+
+export function collaborativeEnabled(config: unknown): boolean {
+    const ext = (config as ResolvedKernelConfig | undefined)?.externalSummary;
+    return ext?.enabled === true && Array.isArray(ext.targets) && ext.targets.some((target) => target?.model === "dsh-collaborative-v1");
+}
+
+/** Only compression-owned fields are copied; runtime objects and lazy map identity stay live. */
+export function compressionDraft(session: Session): { draft: Session; commit(): void } {
+    const state = session.state, epoch = session.revisionEpoch;
+    const stateSnapshot = structuredClone(state);
+    const history = JSON.stringify(session.lastMessages);
+    const baseStats = structuredClone(session.stats), baseMetadata = structuredClone({ ...session.metadata });
+    const baseBlocks = new Map([...session.blockContents].map(([id, value]) => [id, structuredClone(value)]));
+    const baseLastCompress = structuredClone(session.lastCompress);
+    const liveStore = ccrEnabled(session) ? contentStoreOf(session) : session.contentStore;
