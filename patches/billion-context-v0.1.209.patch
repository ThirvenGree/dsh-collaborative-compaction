+/** Original-message recall is current-session only. Foreign-session delegation retains summary-only semantics. */
+export function searchEvidence(session: Session, query: string, limit: number, view: CoreMessage[], persisted: SearchTranscriptRow[], store?: MessageContentStore): string {
+    const read = /^open:(ev-[a-f0-9]{24})(?::(\d{1,12}))?$/.exec(query.trim());
