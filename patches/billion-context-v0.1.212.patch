+    return `role=${m.role} ${who} time=${when}` + (m.toolName ? " tool="+clean(m.toolName).slice(0,100) : "");
+}
+
+/** Original-message recall is current-session only. Foreign-session delegation retains summary-only semantics. */
+export function searchEvidence(session: Session, query: string, limit: number, view: CoreMessage[], persisted: SearchTranscriptRow[], store?: MessageContentStore, observe?: (id: string, text: string) => void, options: { cache?: boolean } = {}): string {
+    const prepare = (key: string, source: string, attachment = "") => prepareText(session, key, source, attachment, options.cache !== false);
+    const read = /^open:(ev-[a-f0-9]{24})(?::(\d{1,12}))?$/.exec(query.trim());
+    const scoped = /^block:(b\d+)\s+(.+)$/is.exec(query);
+    const searchText=(scoped?.[2]??query).trim().toLowerCase();
+    const terms = [...new Set(searchText.split(/\s+/))];
+    const target = scoped ? session.state.blocks.find(b=>b.blockId===scoped[1]) : undefined;
+    if(scoped&&!target)return "[Unknown original-evidence block in this session.]";
+    const selectedIds=target ? new Set(target.effectiveMessageIds) : undefined;
+    const messages = new Map<string, SearchTranscriptRow>();
+    const add = (m: SearchTranscriptRow) => {
+        if (!m.id || m.contentType === "reasoning" || !["user","assistant","tool"].includes(m.role) || m.id.startsWith("acp_summary_")) return;
+        const prior=messages.get(m.id);
+        if (!prior) messages.set(m.id,m);
+        else if(m.text && !m.text.includes("📦")) messages.set(m.id,{
