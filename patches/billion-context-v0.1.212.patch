+    });
+}
+
+interface Probe { duration: number; audio: boolean; video: boolean }
+async function probe(file: string, config: SemanticConfig, signal?: AbortSignal): Promise<Probe> {
+    try {
+        const output = await run(config.ffprobePath || process.env.BILI_FFPROBE_PATH || "ffprobe", ["-v", "error", "-show_entries", "format=duration:stream=codec_type,duration", "-of", "json", file], signal);
