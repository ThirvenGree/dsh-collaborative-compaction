+import { DatabaseSync } from "node:sqlite";
+import { extractMedia, resolveMediaBytes } from "../src/semantic/media-source.js";
+
+test("typed five-modality wire slots preserve payload identities and reject text pretend attachments", () => {
+    const data = Buffer.from("synthetic-media").toString("base64");
+    const cases = [
+        { rawAnthropicBlock: { type: "image", source: { type: "base64", media_type: "image/png", data } } },
+        { rawOpenaiContent: { type: "input_audio", input_audio: { data, format: "wav" } } },
+        { rawGoogleParts: [{ inlineData: { mimeType: "video/mp4", data } }] },
+        { rawResponsesItem: { type: "input_file", file_data: "data:application/pdf;base64," + data } },
+        { rawOpenaiContent: [{ type: "image_url", image_url: { url: "data:image/jpeg;base64," + data } }] },
+    ];
+    for (const input of cases) {
+        const media = extractMedia({ role: "user", ...input });assert.equal(media.length, 1);
+        assert.deepEqual(Buffer.from(resolveMediaBytes(media[0]!, { maxBytes: 1000 })!), Buffer.from("synthetic-media"));
+    }
+    assert.deepEqual(extractMedia({ role: "user", text: JSON.stringify(cases[0]), toolArgs: cases[0] }), []);
+    assert.deepEqual(extractMedia({ role: "system", ...cases[0] }), []);
+    assert.deepEqual(extractMedia({ rawGoogleParts: [{ thought: true, inlineData: { mimeType: "image/png", data } }] }), []);
+    assert.deepEqual(extractMedia({ imageBase64: "not base64$$", imageMediaType: "image/png" }), []);
+});
+test("persisted CAS and immediate inline media share identity; remote references are never fetched", () => {
+    const data = Buffer.from("sample").toString("base64"), hash = createHash("sha256").update(data).digest("hex");
+    const db = new DatabaseSync(":memory:");db.exec("CREATE TABLE content(hash TEXT, bytes BLOB)");db.prepare("INSERT INTO content VALUES(?,?)").run(hash, data);
+    try {
+        const live = extractMedia({ imageBase64: data, imageMediaType: "image/png" });
+        const stored = extractMedia({ imageBase64: { $media: hash }, imageMediaType: "image/png" });
+        assert.equal(live[0]!.hash, stored[0]!.hash);
+        assert.deepEqual(resolveMediaBytes(stored[0]!, { db, maxBytes: 100 }), resolveMediaBytes(live[0]!, { maxBytes: 100 }));
+        const google = extractMedia({ rawGoogleParts: [{ inlineData: { mimeType: "audio/wav", data: { $media: hash } } }] });
+        assert.equal(Buffer.from(resolveMediaBytes(google[0]!, { db, maxBytes: 100 })!).toString(), "sample");
+        const url = extractMedia({ rawResponsesItem: { type: "input_image", image_url: "https://example.invalid/personal.png" } });
+        assert.equal(url[0]!.remoteUrl, "https://example.invalid/personal.png");assert.equal(resolveMediaBytes(url[0]!, { db, maxBytes: 100 }), null);
+        const inlineCas = extractMedia({ rawOpenaiContent: { type: "image_url", image_url: { url: `data:image/png;base64,{$media:${hash}}` } } });
+        assert.equal(inlineCas[0]!.hash, hash);
+    } finally { db.close(); }
+});
