diff --git a/tests/search-index-progress.test.ts b/tests/search-index-progress.test.ts
new file mode 100644
index 00000000..d2cb2113
--- /dev/null
+++ b/tests/search-index-progress.test.ts
@@ -0,0 +1,116 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { Worker } from "node:worker_threads";
+import { SearchIndexClient } from "../src/storage/search-index-client.js";
+
+const timeoutMs = 500;
+const intervalMs = 80;
+const workerSource = `
+const { parentPort, workerData } = require('node:worker_threads');
+const queue = [];
+let active = false;
+function next() {
+    if (active || !queue.length) return;
+    active = true;
+    const request = queue.shift();
+    let committed = 0;
+    const timer = setInterval(() => {
+        if (workerData.behavior === 'progress') {
+            parentPort.postMessage({ id: request.id, progress: { committed: ++committed } });
+        } else if (workerData.behavior === 'repeat') {
+            parentPort.postMessage({ id: request.id, progress: { committed: 1 } });
+        } else if (workerData.behavior === 'wrong-request') {
+            parentPort.postMessage({ id: request.id + 1, progress: { committed: ++committed } });
+            for (const invalid of [0, -1, NaN, Infinity, '100', 1.5]) {
+                parentPort.postMessage({ id: request.id, progress: { committed: invalid } });
+            }
+        }
+    }, workerData.intervalMs);
+    setTimeout(() => {
+        clearInterval(timer);
+        parentPort.postMessage({ id: request.id, result: {
+            rows: [], matchIds: [], neighbors: {}, corrections: {},
+            revision: 1, complete: true, mode: 'fts',
+            stats: { indexed: committed, loaded: 0, matched: 0, elapsedMs: workerData.durationMs }
+        } });
+        active = false;
+        next();
+    }, workerData.durationMs);
+}
+parentPort.on('message', request => { queue.push(request); next(); });
+parentPort.postMessage({ ready: true });
+`;
+
+async function readyWorker(behavior: string, durationMs = 1_500): Promise<Worker> {
+    const worker = new Worker(workerSource, { eval: true, execArgv: [], workerData: { behavior, durationMs, intervalMs } });
+    await once(worker, "message");
+    return worker;
+}
+
+test("committed progress allows indexing longer than the original total deadline", { timeout: 10_000 }, async t => {
+    const worker = await readyWorker("progress");
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => worker });
+    t.after(() => client.close());
+    const started = performance.now();
+    const result = await client.query("large-first-build", "青枔", 5);
+    assert.equal(result?.complete, true);
+    assert.ok(performance.now() - started > timeoutMs * 2, "query outlives its initial timeout while commits advance");
+    assert.ok((result?.stats.indexed ?? 0) >= 5);
+});
+
+test("queued sessions do not kill a preceding indexing query that is making progress", { timeout: 10_000 }, async t => {
+    const worker = await readyWorker("progress", 900);
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => worker });
+    t.after(() => client.close());
+    const results = await Promise.all([client.query("first", "青枔", 5), client.query("second", "岑舒", 5)]);
+    assert.deepEqual(results.map(result => result?.complete), [true, true]);
+});
+
+test("a stuck commit counter does not keep a worker alive", { timeout: 10_000 }, async t => {
+    const worker = await readyWorker("repeat");
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => worker });
+    t.after(() => client.close());
+    const exited = once(worker, "exit");
+    assert.equal(await client.query("stuck", "青枔", 5), null);
+    await exited;
+    assert.equal(worker.threadId, -1, "an unresponsive worker is terminated, not merely detached");
+});
+
+test("queued request progress and invalid counters cannot extend the active request", { timeout: 10_000 }, async t => {
+    const worker = await readyWorker("wrong-request");
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => worker });
+    t.after(() => client.close());
+    const results = await Promise.all([client.query("first", "青枔", 5), client.query("second", "岑舒", 5)]);
+    assert.deepEqual(results, [null, null]);
+});
+
+test("progress from a replaced worker cannot extend a new request", { timeout: 10_000 }, async t => {
+    const oldWorker = await readyWorker("silent");
+    const nextWorker = await readyWorker("silent");
+    const workers = [oldWorker, nextWorker];
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => {
+        const worker = workers.shift();
+        assert.ok(worker);
+        return worker;
+    } });
+    t.after(async () => { await client.close(); await Promise.all(workers.map(worker => worker.terminate())); });
+    assert.equal(await client.query("old", "青枔", 5), null);
+    let committed = 0;
+    const stale = setInterval(() => oldWorker.emit("message", { id: 2, progress: { committed: ++committed } }), intervalMs);
+    t.after(() => clearInterval(stale));
+    assert.equal(await client.query("new", "岑舒", 5), null);
+});
+
+test("close cancels a progressing request and all queued requests without awaiting completion", { timeout: 10_000 }, async t => {
+    const worker = await readyWorker("progress", 5_000);
+    const client = new SearchIndexClient(null, { inactivityTimeoutMs: timeoutMs, createWorker: () => worker });
+    t.after(() => client.close());
+    const progress = once(worker, "message");
+    const requests = [client.query("first", "青枔", 5), client.query("second", "岑舒", 5), client.query("first", "参数", 5)];
+    await progress;
+    await client.close();
+    assert.deepEqual(await Promise.all(requests), [null, null, null]);
+    assert.equal(worker.threadId, -1);
+    assert.equal(await client.query("closed", "青枔", 5), null);
+});
diff --git a/tests/search-index-resume.test.ts b/tests/search-index-resume.test.ts
new file mode 100644
index 00000000..c4e04975
--- /dev/null
+++ b/tests/search-index-resume.test.ts
@@ -0,0 +1,216 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { Worker } from "node:worker_threads";
+import { createRequire } from "node:module";
+import { pathToFileURL } from "node:url";
+import { UnifiedStore } from "../src/storage/store.js";
+import { SearchIndexJournal } from "../src/storage/search-index-journal.js";
+import { SearchIndexEngine } from "../src/storage/search-index-engine.js";
+import type { SqliteDatabase } from "../src/storage/driver.js";
+import type { SearchIndexResult } from "../src/storage/search-index-types.js";
+
+function fixture(t: { after: (fn: () => Promise<void>) => void }) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-search-resume-")), file = path.join(dir, "source.sqlite");
+    const owner = UnifiedStore.open(file), db = (owner as unknown as { db: SqliteDatabase }).db;
+    new SearchIndexJournal(db).ensure();
+    t.after(async () => { await owner.closeSearchIndex(); owner.close(); fs.rmSync(dir, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 }); });
+    const put = (seq: number, text: string, sharedHash?: string) => {
+        const hash = sharedHash ?? "source-" + seq, raw = Buffer.from(JSON.stringify({ text }));
+        db.prepare("INSERT OR IGNORE INTO content(hash,byte_len,bytes) VALUES(?,?,?)").run(hash, raw.length, raw);
+        db.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES('history',?,?, 'user','text',?)").run(seq, "m" + seq, hash);
+    };
+    return { file, db, put };
+}
+function indexedState(file: string) {
+    const db = new DatabaseSync(file + ".search.sqlite");
+    try {
+        return {
+            count: Number((db.prepare("SELECT count(*) AS n FROM docs WHERE session_id='history'").get() as { n: number }).n),
+            state: db.prepare("SELECT * FROM sessions WHERE session_id='history'").get() as { cursor: number; ready: number; revision: number; dirty_revision: number; dirty_seq: number },
+            texts: db.prepare("SELECT seq,body FROM docs WHERE session_id='history' ORDER BY seq").all() as { seq: number; body: string }[],
+        };
+    } finally { db.close(); }
+}
+function start(file: string, pauseAt: number | null, query = "岑舒") {
+    const loader = pathToFileURL(createRequire(import.meta.url).resolve("tsx/esm/api")).href;
+    const entry = new URL("../src/storage/search-index-engine.ts", import.meta.url).href;
+    const worker = new Worker(`const {workerData,parentPort}=require('node:worker_threads');
+(async()=>{ const {register}=await import(workerData.loader);register();
+const {SearchIndexEngine}=await import(workerData.entry);const engine=new SearchIndexEngine(workerData.file);
+try {const result=engine.query('history',workerData.query,12,{},progress=>{
+parentPort.postMessage({progress});
+if(workerData.pauseAt!==null && progress.committed>=workerData.pauseAt) Atomics.wait(new Int32Array(workerData.gate),0,0);
+});parentPort.postMessage({result});}finally{engine.close();}})().catch(error=>{parentPort.postMessage({error:String(error)});});`,
+        { eval: true, execArgv: [], workerData: { loader, entry, file, pauseAt, query, gate: new SharedArrayBuffer(4) } });
+    return worker;
+}
+function waitFor<T>(worker: Worker, select: (message: { progress?: { committed: number }; result?: SearchIndexResult; error?: string }) => T | undefined): Promise<T> {
+    return new Promise((resolve, reject) => {
+        const timeout = setTimeout(() => { cleanup(); reject(Error("index worker did not reach checkpoint")); }, 30_000);
+        const cleanup = () => { clearTimeout(timeout); worker.off("message", receive); worker.off("error", failed); worker.off("exit", exited); };
+        const failed = (error: Error) => { cleanup(); reject(error); };
+        const exited = (code: number) => failed(Error("index worker exited before result: " + code));
+        const receive = (message: Parameters<typeof select>[0]) => {
+            if (message.error) { failed(Error(message.error)); return; }
+            const selected = select(message); if (selected !== undefined) { cleanup(); resolve(selected); }
+        };
+        worker.on("message", receive); worker.on("error", failed); worker.on("exit", exited);
+    });
+}
+
+test("terminated first-build worker retains committed batches and resumes after prefix changes, deletes and new messages", async t => {
+    const f = fixture(t), total = 5_000;
+    f.db.transaction(() => { for (let seq = 0; seq < total; seq++) f.put(seq, `ordinary history ${seq} ` + "资料".repeat(8)); });
+    const first = start(f.file, 2_000);
+    try {
+        assert.equal(await waitFor(first, message => message.progress?.committed === 2_000 ? 2_000 : undefined), 2_000);
+        const checkpoint = indexedState(f.file);
+        assert.equal(checkpoint.count, 2_000, "all eight batches are committed before worker termination");
+        assert.equal(checkpoint.state.cursor, 1_999); assert.equal(checkpoint.state.ready, 0);
+    } finally { await first.terminate(); }
+    const stopped = indexedState(f.file); assert.equal(stopped.count, 2_000); assert.equal(stopped.state.cursor, 1_999);
+    f.db.prepare("UPDATE content SET bytes=? WHERE hash='source-1'").run(Buffer.from(JSON.stringify({ text: "岑舒更正 preserveRecentTokens=12000 early-amended" })));
+    f.db.prepare("DELETE FROM messages WHERE session_id='history' AND seq=2").run();
+    f.put(total, "青枔刚发送 --max-output=8192 latest-after-restart");
+    const resumed = start(f.file, null, "early-amended");
+    try {
+        const result = await waitFor(resumed, message => message.result);
+        assert.equal(result.complete, true); assert.deepEqual(result.matchIds, ["m1"]);
+        assert.equal(result.stats.indexed, 3_004, "resume scans only remaining rows plus the three journal edits");
+    } finally { await resumed.terminate(); }
+    const done = indexedState(f.file);
+    assert.equal(done.count, total); assert.equal(done.state.ready, 1);
+    assert.equal(done.texts.find(row => row.seq === 2), undefined);
+    assert.match(done.texts.find(row => row.seq === total)?.body ?? "", /青枔.*8192/);
+    const engine = new SearchIndexEngine(f.file);
+    try {
+        assert.deepEqual(engine.query("history", "岑舒", 3).matchIds, ["m1"]);
+        assert.deepEqual(engine.query("history", "preserveRecentTokens=12000", 3).matchIds, ["m1"]);
+        assert.deepEqual(engine.query("history", "青枔", 3).matchIds, ["m5000"]);
+        assert.deepEqual(engine.query("history", "4999", 3).matchIds, ["m4999"]);
+    } finally { engine.close(); }
+});
+
+test("dirty replay checkpoints tied revisions by sequence and preserves interrupted deletion/edit progress", async t => {
+    const f = fixture(t);
+    f.db.transaction(() => { for (let seq = 0; seq < 900; seq++) f.put(seq, "original shared-content", "shared"); });
+    const initial = new SearchIndexEngine(f.file);
+    try { initial.query("history", "original", 3); } finally { initial.close(); }
+    f.db.prepare("UPDATE content SET bytes=? WHERE hash='shared'").run(Buffer.from(JSON.stringify({ text: "岑舒 shared-amended parameter=12000" })));
+    const first = start(f.file, 250, "shared-amended");
+    try {
+        await waitFor(first, message => message.progress?.committed === 250 ? 250 : undefined);
+        const checkpoint = indexedState(f.file);
+        assert.equal(checkpoint.state.dirty_seq, 249);
+        assert.equal(checkpoint.texts.filter(row => row.body.includes("shared-amended")).length, 250);
+        assert.ok(checkpoint.state.dirty_revision > checkpoint.state.revision);
+    } finally { await first.terminate(); }
+    f.db.prepare("DELETE FROM messages WHERE session_id='history' AND seq=5").run();
+    f.put(900, "青枔 latest-during-delta");
+    const resumed = start(f.file, null, "shared-amended");
+    try {
+        const result = await waitFor(resumed, message => message.result);
+        assert.equal(result.complete, true); assert.equal(result.stats.indexed, 652);
+    } finally { await resumed.terminate(); }
+    const done = indexedState(f.file);
+    assert.equal(done.count, 900); assert.equal(done.texts.find(row => row.seq === 5), undefined);
+    assert.equal(done.texts.filter(row => row.body.includes("shared-amended")).length, 899);
+    assert.match(done.texts.at(-1)!.body, /青枔 latest-during-delta/);
+});
+
+test("another owner can advance the sidecar between batches without older snapshots overwriting its edits", async t => {
+    const f = fixture(t);
+    f.db.transaction(() => { for (let seq = 0; seq < 750; seq++) f.put(seq, "old words " + seq); });
+    const first = new SearchIndexEngine(f.file), second = new SearchIndexEngine(f.file);
+    try {
+        let intervened = false;
+        const result = first.query("history", "青枔", 3, {}, () => {
+            if (intervened) return; intervened = true;
+            f.db.prepare("UPDATE content SET bytes=? WHERE hash='source-1'").run(Buffer.from(JSON.stringify({ text: "青枔 intervening-owner" })));
+            f.db.prepare("DELETE FROM messages WHERE session_id='history' AND seq=2").run();
+            assert.deepEqual(second.query("history", "intervening-owner", 3).matchIds, ["m1"]);
+        });
+        assert.equal(result.complete, true); assert.deepEqual(result.matchIds, ["m1"]);
+        assert.equal(indexedState(f.file).count, 749);
