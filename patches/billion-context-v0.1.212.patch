+    corrections: Record<string, string[]>;
+    tailId?: string;
+    archiveMatches?: string[];
+    missingArchiveBlocks?: string[];
+    revision: number;
+    complete: boolean;
+    mode: "fts" | "scan";
+    stats: { indexed: number; loaded: number; matched: number; elapsedMs: number };
+    semantic?: {
+        mode: import("../semantic/types.js").SearchMode;
+        coverage: import("../semantic/types.js").SemanticCoverage;
+        exactIds: string[];
+        semanticIds: string[];
+        sources: { id: string; handle?: string; refs: import("../semantic/types.js").SourceRef[]; modality: string }[];
+        openedMedia?: NonNullable<import("../semantic/types.js").SemanticResult["openedMedia"]>;
+        relevance?: { attempted: boolean; calls: number; sufficient: boolean | null; probes: string[]; warnings: string[] };
+        annotations?: Record<string, { relevance: "relevant" | "uncertain" | "irrelevant"; quotes: string[] }>;
