+import type { DatabaseSync } from "node:sqlite";
+
+interface PairRow { id: string; seq: number; kind: string; call_id: string | null }
+export interface PairedContext {
+    /** Includes the supplied IDs and only unambiguous, live counterparts in this session. */
+    ids: string[];
+    missing: string[];
+    ambiguous: string[];
+}
+const fields = `m.msg_id AS id,m.seq,m.kind,
+ CASE WHEN json_valid(CAST(c.bytes AS TEXT)) THEN COALESCE(
+ json_extract(CAST(c.bytes AS TEXT),'$.toolCallId'),
+ json_extract(CAST(c.bytes AS TEXT),'$.rawAnthropicBlock.tool_use_id'),
+ CASE WHEN m.kind='tool-call' THEN json_extract(CAST(c.bytes AS TEXT),'$.rawAnthropicBlock.id') END,
+ json_extract(CAST(c.bytes AS TEXT),'$.rawResponsesItem.call_id'),
+ json_extract(CAST(c.bytes AS TEXT),'$.rawOpenaiMessage.tool_call_id')) END AS call_id`;
+const latest = `m.retired_at IS NULL AND NOT EXISTS(SELECT 1 FROM messages newer
+ WHERE newer.session_id=m.session_id AND newer.msg_id=m.msg_id AND newer.seq>m.seq AND newer.retired_at IS NULL)`;
+
+/** Bounded metadata-only lookup; derived search never mutates/reloads the original session.
+ * A missing pair is explicit rather than substituting a tool with the same name.
+ * The radius bounds work on corrupt/incomplete histories, not the compression range. */
+export function pairedMessageIds(db: DatabaseSync, sessionId: string, messageIds: string[], options: { radius?: number; maxPairs?: number } = {}): PairedContext {
+    const result: PairedContext = { ids: [...new Set(messageIds)], missing: [], ambiguous: [] };
+    const radius = Math.max(1, Math.min(4_096, Math.floor(options.radius ?? 256)));
+    const maxPairs = Math.max(1, Math.min(128, Math.floor(options.maxPairs ?? 32)));
+    const lookup = db.prepare(`SELECT ${fields} FROM messages m JOIN content c ON c.hash=m.content_hash
+ WHERE m.session_id=? AND m.msg_id=? AND ${latest} ORDER BY m.seq DESC LIMIT 1`);
+    const adjacent = db.prepare(`SELECT ${fields} FROM messages m JOIN content c ON c.hash=m.content_hash
+ WHERE m.session_id=? AND m.seq>=? AND m.seq<=? AND m.kind=? AND ${latest} ORDER BY m.seq`);
+    const selected = new Set(result.ids);
+    let processed = 0;
+    for (const id of result.ids.slice()) {
+        const source = lookup.get(sessionId, id) as PairRow | undefined;
+        if (!source || !["tool-call", "tool-result"].includes(source.kind)) continue;
+        if (processed++ >= maxPairs || typeof source.call_id !== "string" || !source.call_id) {
+            result.missing.push(id); continue;
+        }
+        const isCall = source.kind === "tool-call";
+        const rows = adjacent.all(sessionId, isCall ? source.seq + 1 : source.seq - radius,
+            isCall ? source.seq + radius : source.seq - 1, isCall ? "tool-result" : "tool-call") as unknown as PairRow[];
+        const matches = rows.filter(candidate => candidate.call_id === source.call_id);
+        if (!matches.length) result.missing.push(id);
+        else if (matches.length > 1) result.ambiguous.push(id);
+        else if (!selected.has(matches[0]!.id)) { result.ids.push(matches[0]!.id); selected.add(matches[0]!.id); }
+    }
+    return result;
+}
