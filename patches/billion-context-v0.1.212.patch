+    if (!bytes.length || bytes.length > limit) throw new SemanticProviderError("invalid_input", "Media is empty or exceeds the configured byte limit");
+}
+
+interface ProcessResult { stdout: string; stderr: string; code: number | null }
+function run(binary: string, args: string[], signal?: AbortSignal): Promise<ProcessResult> {
+    checkAbort(signal);
+    return new Promise((resolve, reject) => {
+        const child = spawn(binary, args, { windowsHide: true, stdio: ["ignore", "pipe", "pipe"], shell: false });
+        const output: Buffer[] = [], errors: Buffer[] = []; let bytes = 0, finished = false;
+        const cleanup = () => { clearTimeout(timer); signal?.removeEventListener("abort", cancel); };
