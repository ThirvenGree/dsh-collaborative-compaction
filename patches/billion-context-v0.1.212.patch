+import { setTimeout as sleep } from "node:timers/promises";
+import { execFile } from "node:child_process";
+import type { EmbeddingBatchResult, EmbeddingInput, EmbeddingPart, SemanticConfig } from "./types.js";
+
+export type SemanticErrorKind = "configuration" | "invalid_input" | "transient" | "provider" | "invalid_response" | "aborted";
+/** Deliberately excludes provider response bodies, source text and credentials. */
+export class SemanticProviderError extends Error {
+    constructor(public readonly kind: SemanticErrorKind, message: string, public readonly status?: number, public readonly retryable = false) {
+        super(message); this.name = "SemanticProviderError";
+    }
+}
+
+export function resolveSemanticKey(config: Pick<SemanticConfig, "keyEnv">): string {
+    const name = config.keyEnv || "GEMINI_API_KEY";
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) throw new SemanticProviderError("configuration", "Invalid API key environment variable name");
+    // DSH inherits the environment once. No synchronous registry or shell access on its event loop.
+    const value = process.env[name]?.trim();
+    if (!value) throw new SemanticProviderError("configuration", `Missing environment variable ${name}`);
+    return value;
+}
