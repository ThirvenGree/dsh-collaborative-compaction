@@ -0,0 +1,157 @@
+import { existsSync } from "node:fs";
+import { createRequire } from "node:module";
+import { pathToFileURL } from "node:url";
+import { Worker } from "node:worker_threads";
+import { configPath, loadConfig } from "../semantic-settings.js";
+import type { SearchIndexOptions, SearchIndexResult } from "../storage/search-index-types.js";
+import type { SemanticConfig, SemanticResult } from "./types.js";
+import { refineEvidence, type EvidenceCandidate } from "./relevance.js";
+import type { SearchTranscriptRow } from "../storage/store.js";
+
+type Reply = { id: number; result?: SemanticResult; verified?: string[]; error?: string; closed?: boolean; accepted?: boolean };
+function fallback(config: SemanticConfig, state: "disabled" | "unavailable", reason?: string): SemanticResult {
+    return { candidates: [], coverage: { state, reason, indexed: 0, pending: 0, failed: 0, rejected: 0, sourceRevision: 0,
+        model: config.model, dimensions: config.dimensions, elapsedMs: 0 } };
+}
+/** Independent worker: a slow provider never blocks the lexical SQLite worker or DSH event loop. */
+export class SemanticClient {
+    private worker: Worker | null = null;
+    private sequence = 0;
+    private closed = false;
+    private pending = new Map<number, { resolve: (value: Reply) => void; timer: ReturnType<typeof setTimeout> }>();
+    private transfers = new Map<string, Map<string, SearchTranscriptRow>>();
+    constructor(readonly sourcePath: string | null, readonly settingsPath = configPath()) {}
+    private start() {
+        if (this.closed) throw Error("Semantic client closed");
+        if (this.worker) return this.worker;
+        const source = new URL("./worker.ts", import.meta.url);
+        let worker: Worker;
+        if (existsSync(source)) {
+            const loader = pathToFileURL(createRequire(import.meta.url).resolve("tsx/esm/api")).href;
+            worker = new Worker(`const {workerData}=require('node:worker_threads'); import(workerData.loader).then(({register})=>{register();return import(workerData.entry)});`,
+                { eval: true, workerData: { path: this.sourcePath, config: this.settingsPath, entry: source.href, loader }, execArgv: [] });
+        } else {
+            const entry = ["./semantic/worker.js", "./worker.js", "../semantic/worker.js", "../../semantic/worker.js"].map(name => new URL(name, import.meta.url)).find(url => existsSync(url));
+            if (!entry) throw Error("Packaged semantic worker is missing");
+            worker = new Worker(entry, { workerData: { path: this.sourcePath, config: this.settingsPath }, execArgv: [] });
+        }
+        this.worker = worker;
+        this.transfers.clear();
+        worker.on("message", (reply: Reply) => {
+            if (this.worker !== worker) return;
+            const request = this.pending.get(reply.id); if (!request) return;
+            clearTimeout(request.timer); this.pending.delete(reply.id); request.resolve(reply);
+            if (!this.pending.size) worker.unref();
+        });
+        const failed = () => {
+            if (this.worker !== worker) return;
+            this.worker = null;
+            for (const [id, request] of this.pending) { clearTimeout(request.timer); request.resolve({ id, error: "Semantic worker stopped" }); }
+            this.pending.clear();
+        };
+        worker.on("error", failed); worker.on("exit", failed); worker.unref(); return worker;
+    }
+    private request(message: Record<string, unknown>, timeout: number): Promise<Reply> {
+        let worker: Worker; try { worker = this.start(); } catch { return Promise.resolve({ id: 0, error: "Semantic worker unavailable" }); }
+        return new Promise(resolve => {
+            const id = ++this.sequence;
+            const timer = setTimeout(() => {
+                this.pending.delete(id); try { worker.postMessage({ id, operation: "cancel" }); } catch { /* Failed worker already stopped. */ }
+                resolve({ id, error: "Semantic query deadline reached; background indexing continues" });
+                if (!this.pending.size) worker.unref();
+            }, timeout);
+            this.pending.set(id, { resolve, timer }); worker.ref();
+            try { worker.postMessage({ ...message, id }); }
+            catch { clearTimeout(timer); this.pending.delete(id); resolve({ id, error: "Semantic worker unavailable" }); }
+        });
+    }
