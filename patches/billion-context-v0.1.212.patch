+import test, { type TestContext } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createHash } from "node:crypto";
+import type { ServerResponse } from "node:http";
+import { createCore, defaultConfig, type CoreMessage } from "acp-kernel";
+import { executeSearchContextTargetAsync } from "../src/decompress-shared.js";
+import { SessionStore, _setStoreForTest } from "../src/persist.js";
+import { _resetSessionsForTest, ensureCanonicalId, getSession, peekSession } from "../src/session.js";
+import { openSqliteDatabase, type SqliteDatabase } from "../src/storage/driver.js";
+import { UnifiedStore } from "../src/storage/store.js";
+import type { EvidenceIndexQuery } from "../src/search-evidence.js";
+import { _resetPluginStateForTest, handlePluginTool, type PluginToolDeps } from "../src/plugin.js";
+
+type PublicMessage = CoreMessage & { timestamp?: number; attachment?: { description: string }; source?: { kind: string } };
+const msg = (id: string, text: string, extra: Partial<PublicMessage> = {}): PublicMessage => ({ id, role: "user", contentType: "text", text, ...extra });
+const sourceDigest = (db: SqliteDatabase) => createHash("sha256").update(JSON.stringify({
+    sessions: db.prepare("SELECT * FROM sessions ORDER BY session_id").all(),
+    messages: db.prepare("SELECT * FROM messages ORDER BY session_id,seq").all(),
+    content: db.prepare("SELECT hash,byte_len,hex(bytes) AS bytes FROM content ORDER BY hash").all(),
+})).digest("hex");
+
+async function fixture(t: TestContext) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-cross-indexed-"));
+    const priorMode = process.env.BILI_STORAGE_UNIFIED, priorConfig = process.env.BILI_CONFIG_FILE;
+    process.env.BILI_STORAGE_UNIFIED = "full";
+    process.env.BILI_CONFIG_FILE = path.join(dir, "no-config.json");
+    _resetSessionsForTest();
+    const store = new SessionStore({ dir, enabled: true, debounceMs: 60_000 });
+    _setStoreForTest(store);
+    const old = getSession("cross-indexed-old");
+    old.lastMessages = [];
+    const alias = ensureCanonicalId(old);
+    old.metadata.canonicalId = alias;
+    await store.writeNow(old);
+    const db = openSqliteDatabase(path.join(dir, "index.db")).db;
+    t.after(async () => {
+        _resetSessionsForTest(); _setStoreForTest(new SessionStore({ enabled: false }));
+        db.close(); await store.closeQuietlyAsync();
+        if (priorMode === undefined) delete process.env.BILI_STORAGE_UNIFIED; else process.env.BILI_STORAGE_UNIFIED = priorMode;
+        if (priorConfig === undefined) delete process.env.BILI_CONFIG_FILE; else process.env.BILI_CONFIG_FILE = priorConfig;
+        const target = path.resolve(dir), root = path.resolve(os.tmpdir()) + path.sep;
+        assert.ok(target.startsWith(root) && path.basename(target).startsWith("bili-cross-indexed-"));
+        fs.rmSync(target, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });
+    });
+    const current = getSession("cross-indexed-current");
+    const core = createCore(), config = defaultConfig(200_000);
+    const run = async (query: string, target = old.id, queryIndex?: EvidenceIndexQuery) => executeSearchContextTargetAsync(
+        { query, conversation_id: target, limit: 5 }, core, current.id, current.state,
+        { session: current, config, messages: current.lastMessages ?? [], log() {}, ...(queryIndex ? { searchIndex: queryIndex } : {}) },
+    );
+    return { dir, store, db, old, current, alias, run };
+}
+
+function readHandle(text: string): string {
+    const handle = text.match(/open:ev-[a-f0-9]{24}:\d+/)?.[0];
+    assert.ok(handle, "search must expose a version-bound paginated original-read handle");
+    return handle;
+}
+
+test("cold foreign full history uses SQLite FTS, including two-character names and parameters, without loading or modifying the session", async t => {
+    const f = await fixture(t);
+    f.old.lastMessages = Array.from({ length: 1200 }, (_, i) => msg("row-" + i, "旧记录 " + i + "：普通阅读资料。".repeat(20), { timestamp: 1793788800000 + i * 1000 }));
+    const original = "岑舒与青枔确认 preserveRecentTokens=32000，路径 E:/workspace/config.json；" + "旧资料段落。".repeat(700) + "原文末尾线索";
+    f.old.lastMessages![900] = msg("row-900", original, { timestamp: 1793789700000 });
+    await f.store.writeNow(f.old);
+    f.store.cancelAll();
+    _resetSessionsForTest();
+    assert.equal(peekSession(f.old.id), undefined);
+    const before = sourceDigest(f.db), currentBefore = JSON.stringify(f.current.state);
+    const noLoad = t.mock.method(f.store, "loadSync", () => { throw Error("search may not hydrate a foreign runtime Session"); });
+    const noSave = t.mock.method(f.store, "scheduleSave", () => { throw Error("read-only search may not schedule a save"); });
+    const noMessages = t.mock.method(UnifiedStore.prototype, "getMessages", () => { throw Error("cold identity lookup must not hydrate message bodies"); });
+    const noBlocks = t.mock.method(UnifiedStore.prototype, "getBlocks", () => { throw Error("cold identity lookup must not hydrate block CAS"); });
+    const noCcr = t.mock.method(UnifiedStore.prototype, "getCcr", () => { throw Error("cold identity lookup must not hydrate CCR"); });
+    for (const query of ["岑舒", "青枔", "RecentTokens", "32000", "E:/workspace/config.json"]) {
+        const out = await f.run(query);
+        assert.match(out.text, /row-900/); assert.match(out.text, /cross-indexed-old/);
+    }
+    const first = (await f.run("岑舒")).text, handle = readHandle(first);
+    assert.match(first, /conversation_id/);
+    assert.match(first, /cross-indexed-old/);
+    const opened = await f.run(handle);
+    assert.match(opened.text, /岑舒与青枔确认 preserveRecentTokens=32000/);
+    assert.match(opened.text, /next/);
+    assert.ok(opened.text.length < 2300, "read output must remain paginated");
+    const next = readHandle(opened.text);
+    assert.notEqual(next, handle);
+    const page2 = await f.run(next);
+    assert.match(page2.text, /旧资料段落/);
+    assert.doesNotMatch(page2.text, /岑舒与青枔确认 preserveRecentTokens/);
+    assert.match((await f.run("青枔", f.alias)).text, /row-900/);
+    assert.equal(noLoad.mock.callCount(), 0); assert.equal(noSave.mock.callCount(), 0);
+    assert.equal(noMessages.mock.callCount(), 0); assert.equal(noBlocks.mock.callCount(), 0); assert.equal(noCcr.mock.callCount(), 0);
+    assert.equal(peekSession(f.old.id), undefined);
+    assert.equal(f.store.hasPending(f.old.id), false);
+    assert.equal(sourceDigest(f.db), before, "derived index writes must not mutate original rows");
+    assert.equal(JSON.stringify(f.current.state), currentBefore);
+});
+
+test("resident foreign just-sent messages and edits override disk while caller and identical IDs stay isolated", async t => {
+    const f = await fixture(t);
+    f.old.lastMessages = [msg("shared-id", "岑舒原先设置 oldValue=100")];
+    await f.store.writeNow(f.old);
+    f.old.lastMessages = [msg("shared-id", "岑舒刚改成 newValue=200"), msg("unsaved", "青枔刚发送 liveForeign=321", { timestamp: 1793799999000 })];
+    f.current.lastMessages = [msg("shared-id", "caller-only-private"), msg("unsaved", "caller-liveForeign=999")];
+    const before = { state: JSON.stringify(f.old.state), metadata: JSON.stringify(f.old.metadata), epoch: f.old.revisionEpoch, seen: f.old.lastSeen, requests: f.old.stats.requests };
+    const out = await f.run("liveForeign");
+    assert.match(out.text, /青枔刚发送 liveForeign=321/);
+    assert.doesNotMatch(out.text, /caller-only-private|caller-liveForeign=999/);
+    assert.match((await f.run("newValue")).text, /newValue=200/);
+    assert.doesNotMatch((await f.run("oldValue")).text, /oldValue=100/);
+    const handle = readHandle(out.text);
+    assert.match((await f.run(handle)).text, /liveForeign=321/);
+    assert.doesNotMatch((await f.run(handle, f.current.id)).text, /liveForeign=321/);
+    f.old.lastMessages[1]!.text = "青枔改了主意 liveForeign=654";
+    assert.match((await f.run(handle)).text, /unavailable or changed/);
+    const replacement = await f.run("liveForeign");
+    const updatedHandle = readHandle(replacement.text);
+    f.old.lastMessages.pop();
+    assert.match((await f.run(updatedHandle)).text, /unavailable or changed/);
+    assert.equal(JSON.stringify(f.old.state), before.state); assert.equal(JSON.stringify(f.old.metadata), before.metadata);
+    assert.equal(f.old.revisionEpoch, before.epoch); assert.equal(f.old.lastSeen, before.seen); assert.equal(f.old.stats.requests, before.requests);
+});
+
+test("cold foreign evidence handles detect changed or deleted source and fresh persisted arrivals", async t => {
+    const f = await fixture(t);
+    f.old.lastMessages = [msg("row-1", "青枔旧值 parameter=111")];
+    await f.store.writeNow(f.old); _resetSessionsForTest();
+    const first = await f.run("parameter"), handle = readHandle(first.text);
+    const row = f.db.prepare("SELECT content_hash FROM messages WHERE session_id=? AND msg_id=? AND retired_at IS NULL").get(f.old.id, "row-1") as { content_hash: string };
+    const bytes = Buffer.from(JSON.stringify(msg("row-1", "青枔新值 parameter=222")));
+    f.db.prepare("UPDATE content SET bytes=?,byte_len=? WHERE hash=?").run(bytes, bytes.length, row.content_hash);
+    assert.match((await f.run(handle)).text, /unavailable or changed/);
