+++ b/src/storage/search-index-worker.ts
@@ -0,0 +1,11 @@
+import { parentPort, workerData } from "node:worker_threads";
+import { SearchIndexEngine } from "./search-index-engine.js";
+import type { SearchIndexOptions } from "./search-index-types.js";
+
+const engine = new SearchIndexEngine(workerData.path ?? null);
+parentPort!.on("message", (request: { id: number; sessionId: string; query: string; limit: number; options?: SearchIndexOptions }) => {
+    try { parentPort!.postMessage({ id: request.id, result: engine.query(request.sessionId, request.query, request.limit, request.options,
+        progress => parentPort!.postMessage({ id: request.id, progress })) }); }
+    catch { parentPort!.postMessage({ id: request.id, error: "History search index unavailable; retry or rebuild the derived index" }); }
+});
+parentPort!.on("close", () => engine.close());
