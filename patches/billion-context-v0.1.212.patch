+
+const msg=(id:string,text:string,role:CoreMessage["role"]="user"):CoreMessage=>({id,text,role,contentType:"text"});
+function fixture(){
+ const state=createInitialState();
+ const session={id:"search-fixture-local",state,metadata:{},stats:{},blockContents:new Map(),lastMessages:[
+  {...msg("old","draft setting "+"x ".repeat(1300)+"needle_one 4011"),source:{kind:"user"},timestamp:"2026-11-03T10:00:00Z"},
+  {...msg("attach","[image]","tool"),attachment:{description:"bluepaper attachment description"}},
+  {...msg("revised","Actually disabled."),corrects:"old"},
+  {...msg("internal","【内部提醒】task-complete"),source:{kind:"plugin:agency"}},
+  {...msg("thinking","PRIVATE_INFERENCE","assistant"),contentType:"reasoning"},
+  msg("preface","PRIVATE_SYSTEM","system"),msg("secrets","sensitive token=abcdef__123456789"),
+ ]} as unknown as Session;
+ state.messageRefs.byRaw["old"]="m00001";
+ const ctx={session,config:defaultConfig(200000),messages:session.lastMessages!,log:()=>{}};
+ return {session,run:(query:string)=>executeSearchContextTarget({query,limit:2},createCore(),session.id,state,ctx).text};
+}
