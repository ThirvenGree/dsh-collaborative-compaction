+import test from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { pairedMessageIds } from "../src/semantic/pair-context.js";
+
+function fixture() {
+    const db = new DatabaseSync(":memory:");
+    db.exec(`CREATE TABLE messages(session_id TEXT,seq INTEGER,msg_id TEXT,kind TEXT,content_hash TEXT,retired_at INTEGER);
+        CREATE TABLE content(hash TEXT PRIMARY KEY,bytes BLOB);`);
+    const put = (session: string, seq: number, id: string, kind: string, callId: string, retired: number | null = null) => {
+        const hash = session + "/" + seq;
+        db.prepare("INSERT INTO content VALUES(?,?)").run(hash, Buffer.from(JSON.stringify({ text: "private large content omitted", toolCallId: callId, toolName: "browser" })));
+        db.prepare("INSERT INTO messages VALUES(?,?,?,?,?,?)").run(session, seq, id, kind, hash, retired);
+    };
+    return { db, put };
+}
+
+test("semantic event chunk boundary does not sever a tool call and its result", () => {
+    const { db, put } = fixture();
+    try {
+        put("a", 7, "call", "tool-call", "call-1"); put("a", 8, "result", "tool-result", "call-1");
+        db.exec("PRAGMA query_only=ON");
+        assert.deepEqual(pairedMessageIds(db, "a", ["result"]), { ids: ["result", "call"], missing: [], ambiguous: [] });
+        assert.deepEqual(pairedMessageIds(db, "a", ["call"]), { ids: ["call", "result"], missing: [], ambiguous: [] });
+    } finally { db.close(); }
+});
+
+test("parallel result order is paired by ID, never same tool name or another session", () => {
+    const { db, put } = fixture();
+    try {
+        put("a", 7, "call-a", "tool-call", "A"); put("a", 8, "call-b", "tool-call", "B");
+        put("a", 9, "result-b", "tool-result", "B"); put("a", 10, "result-a", "tool-result", "A");
+        put("other-private", 11, "foreign", "tool-result", "A");
+        assert.deepEqual(pairedMessageIds(db, "a", ["call-a"]).ids, ["call-a", "result-a"]);
+    } finally { db.close(); }
+});
+
+test("deleted, replaced, ambiguous or out-of-budget counterparts are reported without guessed evidence", () => {
+    const { db, put } = fixture();
+    try {
+        put("a", 7, "call", "tool-call", "A"); put("a", 8, "retired", "tool-result", "A", 1);
+        put("b", 7, "call", "tool-call", "B"); put("b", 300, "distant", "tool-result", "B");
+        put("c", 7, "call", "tool-call", "C"); put("c", 8, "first", "tool-result", "C"); put("c", 9, "second", "tool-result", "C");
+        assert.deepEqual(pairedMessageIds(db, "a", ["call"]).missing, ["call"]);
+        assert.deepEqual(pairedMessageIds(db, "b", ["call"]).missing, ["call"]);
+        assert.deepEqual(pairedMessageIds(db, "c", ["call"]).ambiguous, ["call"]);
+        assert.deepEqual(pairedMessageIds(db, "c", ["call"]).ids, ["call"]);
+    } finally { db.close(); }
+});
