+        const original = entry && entry.rawId === m.id ? store?.byHash[entry.hash] : undefined;
+        // A CCR carrier is not an edit. Recover its original if resident; if
+        // unavailable let the persisted source supply it. Real current text,
+        // including empty text and role changes, always wins over stale CCR.
+        const placeholder = typeof row.text === "string" ? parseStoredPlaceholder(row.text) : null;
