+                if (doc) possible.push(JSON.parse(doc.data));
+                possible.sort((a, b) => direction === "previous" ? b.seq - a.seq : a.seq - b.seq);
+                const near = possible[0]; if (near) { add(near); relation[direction] = near.id; }
+            }
+            neighbors[id] = relation;
+            const ref = this.source?.prepare("SELECT ref FROM messages WHERE session_id=? AND msg_id=? AND retired_at IS NULL ORDER BY seq DESC LIMIT 1").get(sessionId, id) as { ref?: string } | undefined;
+            const corrected = this.index.prepare(`SELECT d.data FROM docs d INDEXED BY docs_correction WHERE d.session_id=? AND (d.corrects=? OR d.corrects=?)
+ AND NOT EXISTS(SELECT 1 FROM query_excluded e WHERE e.id=d.msg_id)
+ AND NOT EXISTS(SELECT 1 FROM docs newer INDEXED BY docs_id_seq WHERE newer.session_id=d.session_id AND newer.msg_id=d.msg_id AND newer.seq>d.seq)
+ ORDER BY d.seq DESC LIMIT 3`).all(sessionId, id, ref?.ref ?? id) as { data: string }[];
+            const related = [...corrected.map(d => JSON.parse(d.data) as SearchIndexRow).filter(r => !excluded.has(r.id)), ...[...overlays.values()].filter(r => r.corrects === id || (!!ref?.ref && r.corrects === ref.ref))].sort((a, b) => b.seq - a.seq).slice(0, 3);
+            for (const correction of related) add(correction);
+            corrections[id] = related.map(r => r.id);
