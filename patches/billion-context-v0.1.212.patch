+        // the following missing-block pass supplies their authoritative bodies.
+        const allowedArchives = options.archiveCoverage === undefined ? null : new Set(options.archiveCoverage.map(block => block.block));
+        const archiveRows = (options.archives ?? [...(prior?.archives.values() ?? [])]).filter(row => !allowedArchives || ("block" in row && allowedArchives.has(row.block)));
+        const archive = transferDelta(archiveRows, prior?.archives ?? new Map());
