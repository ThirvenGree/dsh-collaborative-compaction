+import { parentPort, workerData } from "node:worker_threads";
+import { SemanticEngine } from "./engine.js";
+import type { SearchIndexOptions } from "../storage/search-index-types.js";
+import type { SemanticStatus, SourceRef } from "./types.js";
+
+const data = workerData as { path: string | null; config: string };
+const engine = new SemanticEngine(data.path, data.config);
+const requests = new Map<number, AbortController>();
+let ticking = false, stopped = false;
+const interval = setInterval(() => {
+    if (ticking || stopped) return;
+    ticking = true;
+    void engine.tick().catch(() => { /* A failed source read is retried without changing the source. */ }).finally(() => { ticking = false; });
+}, 500);
+parentPort?.on("message", (message: { id: number; operation?: string; sessionId: string; query: string; limit: number; options?: SearchIndexOptions; ids?: { id: string; evidence: string }[]; refs?: SourceRef[]; tokens?: number; summary?: NonNullable<SemanticStatus["lastQuery"]> }) => {
+    if (message.operation === "cancel") { requests.get(message.id)?.abort(); return; }
+    if (message.operation === "close") {
+        stopped = true; clearInterval(interval); for (const controller of requests.values()) controller.abort(); engine.close(); parentPort?.postMessage({ id: message.id, closed: true }); parentPort?.close(); return;
+    }
+    const controller = new AbortController(); requests.set(message.id, controller);
+    void (async () => {
+        try {
+            if (message.operation === "summary" && message.summary) { engine.recordQuery(message.summary); parentPort?.postMessage({ id: message.id, accepted: true }); }
+            else if (message.operation === "reserve") { engine.reserveExternal(); parentPort?.postMessage({ id: message.id, accepted: true }); }
+            else if (message.operation === "usage") { engine.recordExternalUsage(message.tokens ?? 0); parentPort?.postMessage({ id: message.id, accepted: true }); }
+            else if (message.operation === "verify") parentPort?.postMessage({ id: message.id, verified: engine.verifyRows(message.sessionId, message.ids ?? [], message.options, message.refs) });
+            else parentPort?.postMessage({ id: message.id, result: await engine.query(message.sessionId, message.query, message.limit, message.options, controller.signal) });
+        } catch { parentPort?.postMessage({ id: message.id, error: "Semantic worker unavailable; exact search remains available" }); }
+        finally { requests.delete(message.id); }
+    })();
+});
