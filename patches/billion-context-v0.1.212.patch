+import { searchEvidence } from "../src/search-evidence.js";
+import type { SearchIndexOptions, SearchIndexResult } from "../src/storage/search-index-types.js";
+import { makeLongFixture, probes, timingSummary, withHeartbeat } from "./search-long-fixture.js";
+
+const rowsArg = process.argv.indexOf("--rows"), outArg = process.argv.indexOf("--out");
+const count = rowsArg >= 0 ? Number(process.argv[rowsArg + 1]) : 20_000;
+if (!Number.isSafeInteger(count) || count < 500 || count > 200_000) throw new Error("--rows must be 500–200000");
+const outPath = outArg >= 0 ? process.argv[outArg + 1] : undefined;
+const fixtureStart = performance.now(), f = makeLongFixture(count), fixtureMs = performance.now() - fixtureStart;
+const originalCharacters = f.sourceCharacters, originalBytes = f.sourceBytes;
+const queryCases = [...probes, { query: "资料", id: `history-${count}`, quote: "资料" }, { query: "整理 页码", id: `history-${count}`, quote: "页码" }];
+let lastIndex: SearchIndexResult | null = null;
+const latestStats = () => lastIndex?.stats;
+const latestMode = () => lastIndex?.mode;
+type TransportDiagnostics = { overlayRows: number; overlayChars: number; summaryRows: number; archiveRows: number; residentEstimatedBytes: number; transferBudgetBytes: number };
+// Read the real store-owned transport counters without creating a second worker.
+const transport = () => (Reflect.get(f.store, "searchIndexClient") as { diagnostics(): TransportDiagnostics } | undefined)?.diagnostics();
+const queryIndex = async (sid: string, query: string, limit: number, options?: SearchIndexOptions) => {
+    lastIndex = await f.store.indexedSearch(sid, query, limit, options);
+    return lastIndex;
+};
+const ctx = { session: f.session, config: defaultConfig(200_000), messages: [] as CoreMessage[], log: () => {}, searchIndex: queryIndex };
+const core = createCore();
+const indexed = async (query: string) => {
+    const result = await executeSearchContextTargetAsync({ query, limit: 5 }, core, f.session.id, f.session.state, ctx);
+    assert.equal(latestMode(), "fts", `indexed benchmark unexpectedly fell back for ${query}`);
+    return result.text;
+};
+const baseline = (query: string) => searchEvidence(f.session, query, 5, ctx.messages, f.store.searchableTranscript(f.session.id));
+const elapsed = async (fn: () => Promise<string> | string) => { const at = performance.now(); const text = await fn(); return { text, ms: performance.now() - at }; };
+const sizes = () => Object.fromEntries([
+    ["source", ""], ["sourceWal", "-wal"], ["index", ".search.sqlite"], ["indexWal", ".search.sqlite-wal"],
+].map(([name, suffix]) => { try { return [name!, statSync(f.file + suffix).size]; } catch { return [name!, 0]; } }));
+try {
+    const oldCold = await withHeartbeat(() => baseline(probes[0].query));
+    assert.ok(oldCold.result.includes(probes[0].quote));
+    const newCold = await withHeartbeat(() => indexed(probes[0].query));
+    assert.ok(newCold.result.includes(probes[0].quote));
+    assert.equal(latestMode(), "fts", "benchmark must exercise the FTS index rather than fallback scanning");
+    const coldStats = latestStats();
+    const baselineTimes: number[] = [], indexedTimes: number[] = [], cases: object[] = [];
+    for (let round = 0; round < 3; round++) for (const probe of queryCases) {
+        const a = await elapsed(() => baseline(probe.query));
+        const b = await elapsed(() => indexed(probe.query));
+        assert.ok(a.text.includes(probe.quote), `baseline lost ${probe.query}`);
+        assert.ok(b.text.includes(probe.quote), `indexed lost ${probe.query}`);
+        assert.ok(a.text.includes(probe.id) && b.text.includes(probe.id), `message identity mismatch for ${probe.query}`);
+        baselineTimes.push(a.ms); indexedTimes.push(b.ms);
+        if (!round) cases.push({ query: probe.query, sourceId: probe.id, baselineFound: true, indexedFound: true, indexStats: latestStats() });
+    }
+    const hotHeartbeat = await withHeartbeat(async () => { for (const probe of queryCases) await indexed(probe.query); return queryCases.length; });
+    const fullResident: CoreMessage[] = f.store.searchableTranscript(f.session.id).map(row => ({
+        id: row.id, role: row.role as CoreMessage["role"], contentType: row.contentType as CoreMessage["contentType"], text: row.text ?? "",
+    }));
+    f.session.lastMessages = fullResident;
+    const transportBefore = transport()!;
+    const activeFirst = await withHeartbeat(() => indexed(probes[0].query));
+    const transportAfterFirst = transport()!;
+    assert.ok(activeFirst.result.includes(probes[0].quote));
+    const activeBaselineTimes: number[] = [], activeIndexedTimes: number[] = [];
+    for (let round = 0; round < 2; round++) for (const probe of queryCases) {
+        const a = await elapsed(() => baseline(probe.query)), b = await elapsed(() => indexed(probe.query));
+        assert.ok(a.text.includes(probe.quote) && b.text.includes(probe.quote), `active resident recall lost ${probe.query}`);
+        activeBaselineTimes.push(a.ms); activeIndexedTimes.push(b.ms);
+    }
+    const activeHeartbeat = await withHeartbeat(async () => { for (const probe of queryCases) await indexed(probe.query); return queryCases.length; });
+    const transportAfterWarm = transport()!;
+    assert.equal(transportAfterWarm.overlayRows, transportAfterFirst.overlayRows, "unchanged complete resident history must not resend bodies");
+    assert.equal(transportAfterWarm.overlayChars, transportAfterFirst.overlayChars);
+    const mutable = fullResident.find(row => row.id === "history-120")!, beforeEdit = mutable.text;
+    mutable.text = "岑舒刚刚改变主意：保留银色文件夹。";
+    assert.match(await indexed("银色文件夹"), /history-120/);
+    assert.doesNotMatch(await indexed("蓝色文件夹"), /岑舒把窗台画放进蓝色文件夹/);
+    mutable.text = beforeEdit;
+    fullResident.push({ id: "active-just-sent", role: "user", contentType: "text", text: "活跃全量会话新来信：newLiveFlag=7391。" });
+    assert.match(await indexed("newLiveFlag"), /active-just-sent[\s\S]*newLiveFlag=7391/);
+    f.update(460, "外部正式版本已经修改：延迟回忆现在改为晚间考虑。");
+    assert.match(await indexed("延迟回忆"), /history-460[\s\S]*晚间考虑/);
+    assert.doesNotMatch(await indexed("延迟回忆"), /延迟回忆需要保留触发线索/);
+    f.erase(390);
+    assert.doesNotMatch(await indexed("2026-11-04"), /history-390/);
+    f.session.lastMessages = [];
+    const incremental: object[] = [];
+    for (let i = 0; i < 5; i++) {
+        const marker = `增量线索${i}青枔`, seq = count + i + 1;
+        f.insert(seq, `${marker}刚刚写入，原有历史不需要重新构建。`, f.writer);
+        const next = await elapsed(() => indexed(marker));
+        assert.ok(next.text.includes(marker));
+        incremental.push({ mutation: "append", sourceId: `history-${seq}`, elapsedMs: Number(next.ms.toFixed(2)), stats: latestStats() });
+    }
+    const oldNameText = f.readText(120), newNameText = oldNameText.replace("蓝色文件夹", "红色文件夹");
+    assert.equal(oldNameText.length, newNameText.length);
+    f.update(120, newNameText);
+    let found = await indexed("岑舒");
+    assert.ok(found.includes("红色文件夹")); assert.ok(!found.includes("蓝色文件夹"));
+    incremental.push({ mutation: "same-length external edit", correct: true, stats: latestStats() });
+    f.erase(155);
+    found = await indexed("青枔想周末再看展览");
+    assert.ok(!found.includes("history-155"));
+    incremental.push({ mutation: "external delete", correct: true, stats: latestStats() });
+    f.retire(280);
+    found = await indexed("autoFoldTargetTokens");
+    assert.ok(!found.includes("history-280"));
+    incremental.push({ mutation: "retirement", correct: true, stats: latestStats() });
+
+    ctx.messages = [{ id: "just-sent", role: "user", contentType: "text", text: "青枔刚发送：本轮新参数 pixelBudget=4096；尚未写入 SQLite。" }];
+    f.session.lastMessages = ctx.messages;
+    found = await indexed("pixelBudget");
+    assert.ok(found.includes("just-sent") && found.includes("pixelBudget=4096"));
+    const recent = { unpersistedMessageFound: true, query: "pixelBudget", stats: latestStats() };
+    ctx.messages = [{ id: "history-120", role: "user", contentType: "text", text: "岑舒已改口：现在用绿色文件夹。" }];
+    f.session.lastMessages = ctx.messages;
+    found = await indexed("岑舒");
+    assert.ok(found.includes("绿色文件夹")); assert.ok(!found.includes("红色文件夹"));
+    const overlay = { newerSameIdOverridesStored: true };
+    ctx.messages = []; f.session.lastMessages = [];
+    found = await indexed("RecentTokens");
+    const handle = found.match(/read: (open:ev-[a-f0-9]+:\d+)/)?.[1];
+    assert.ok(handle, "original evidence read handle must remain available");
+    assert.ok((await indexed(handle)).includes("preserveRecentTokens=32000"));
+    const open = { originalReadHandleWorks: true, stats: latestStats() };
+    f.db.exec("PRAGMA wal_checkpoint(TRUNCATE)");
+    const storage = sizes();
+    const cleanMetrics = <T>(data: { result: T; elapsedMs: number; heartbeatTicks: number; maxHeartbeatGapMs: number }) => ({ elapsedMs: data.elapsedMs, heartbeatTicks: data.heartbeatTicks, maxHeartbeatGapMs: data.maxHeartbeatGapMs });
+    const report = {
+        schema: "history-fts-benchmark-v1", generatedAt: new Date().toISOString(), syntheticOnly: true,
+        environment: { node: process.version, platform: platform(), osRelease: release(), cpu: cpus()[0]?.model, sqlite: f.db.prepare("SELECT sqlite_version() AS version").get() },
+        corpus: { rows: count, sourceCharacters: originalCharacters, sourceBytes: originalBytes, sourceDatabaseBytes: f.sourceDatabaseBytes, generationMs: Number(fixtureMs.toFixed(2)) },
+        oldCold: cleanMetrics(oldCold), newCold: { ...cleanMetrics(newCold), stats: coldStats },
+        hot: { baseline: timingSummary(baselineTimes), indexed: timingSummary(indexedTimes), workerHeartbeat: cleanMetrics(hotHeartbeat) },
+        activeFullHistory: { rows: fullResident.length - 1, firstOverlay: cleanMetrics(activeFirst), baseline: timingSummary(activeBaselineTimes), indexed: timingSummary(activeIndexedTimes), workerHeartbeat: cleanMetrics(activeHeartbeat), transportBefore, transportAfterFirst, transportAfterWarm, sameObjectEditFound: true, unpersistedAppendFound: true, canonicalEditOverridesUnchangedResident: true, canonicalDeleteOverridesUnchangedResident: true },
+        cases, incremental, recent, overlay, open, storage,
+        indexGrowthBytes: Number(storage.index) + Number(storage.indexWal),
+        limitations: ["Synthetic, single-machine wall-clock measurements; not a guaranteed speedup on every workload.", "Cold indexed search includes initial index construction; no remote model calls or formal memories were used.", "Legacy cache may not retain a corpus larger than its per-item capacity; the comparison exercises its actual current behavior."],
+    };
+    if (outPath) writeFileSync(outPath, JSON.stringify(report, null, 2) + "\n");
+    process.stdout.write(JSON.stringify(report, null, 2) + "\n");
+} finally { await f.close(); }
diff --git a/tests/search-long-fixture.ts b/tests/search-long-fixture.ts
new file mode 100644
index 00000000..ffe512aa
--- /dev/null
+++ b/tests/search-long-fixture.ts
@@ -0,0 +1,122 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, rmSync, statSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve, sep } from "node:path";
+import { createInitialState, type CoreMessage } from "acp-kernel";
+import type { Session } from "../src/session.js";
+import { UnifiedStore } from "../src/storage/store.js";
+import { openSqliteDatabase, type SqliteDatabase } from "../src/storage/driver.js";
+
+export const longHistorySession = "fts-synthetic-long-history";
+export const probes = [
+    { query: "岑舒", id: "history-120", quote: "岑舒把窗台画放进蓝色文件夹" },
+    { query: "青枔", id: "history-155", quote: "青枔想周末再看展览" },
+    { query: "autoFoldTargetTokens", id: "history-280", quote: "autoFoldTargetTokens=80000" },
+    { query: "RecentTokens", id: "history-290", quote: "preserveRecentTokens=32000" },
+    { query: "90%", id: "history-310", quote: "硬性安全阈值90%" },
+    { query: "E:/workspace/config.json", id: "history-350", quote: "E:/workspace/config.json" },
+    { query: "2026-11-04", id: "history-390", quote: "检验日期2026-11-04" },
+    { query: "延迟回忆", id: "history-460", quote: "延迟回忆需要保留触发线索" },
+] as const;
+
+type SyntheticMessage = CoreMessage & {
+    timestamp?: number;
+    source?: { kind: string };
+    corrects?: string;
+    attachment?: { description: string };
+};
+
+export function makeLongFixture(count = 20_000) {
+    const dir = mkdtempSync(join(tmpdir(), "bili-fts-long-"));
+    const file = join(dir, "index.db");
+    const store = UnifiedStore.open(file);
+    const db = (store as unknown as { db: SqliteDatabase }).db;
+    const writer = openSqliteDatabase(file).db;
+    const insertContent = db.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES (?,?,?)");
+    const insertMessage = db.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES (?,?,?,?,?,?)");
+    const state = createInitialState();
+    const session = { id: longHistorySession, state, metadata: {}, stats: {}, blockContents: new Map(), lastMessages: [] } as unknown as Session;
+    let sourceCharacters = 0, sourceBytes = 0;
+    const hashes = new Map<number, string>();
+    const insert = (seq: number, text: string, target = db, extra: Partial<SyntheticMessage> = {}) => {
+        const message: SyntheticMessage = {
+            id: `history-${seq}`, role: seq % 5 === 0 ? "tool" : seq % 2 === 0 ? "assistant" : "user",
+            contentType: "text", text, timestamp: 1_790_000_000_000 + seq * 60_000, source: { kind: "synthetic-benchmark" }, ...extra,
+        };
+        const raw = JSON.stringify(message), bytes = Buffer.from(raw), hash = createHash("sha256").update(raw).digest("hex");
+        if (target === db) {
+            insertContent.run(hash, bytes.length, bytes);
+            insertMessage.run(longHistorySession, seq, message.id, message.role, message.contentType, hash);
+        } else {
+            target.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES (?,?,?)").run(hash, bytes.length, bytes);
+            target.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES (?,?,?,?,?,?)")
+                .run(longHistorySession, seq, message.id, message.role, message.contentType, hash);
+        }
+        hashes.set(seq, hash);
+        state.messageRefs.byRaw[message.id] = `m${String(seq).padStart(5, "0")}`;
+        sourceCharacters += text.length; sourceBytes += Buffer.byteLength(text);
+        return message;
+    };
+    const corpus = [
+        "工具返回的页面包含馆藏目录、照片说明、书籍索引和后续整理建议。每一条资料都保存出处，眼前展示的内容只作搜索测试。",
+        "整理扫描件时核对页码、纸张纹理与批注，记录尚未辨认的地名。完成这一步后再查看下一页，不把看起来相似的编号混为一谈。",
+        "The synthetic tool output lists document sections, image descriptions, versioned settings and reversible steps. This is generated benchmark data.",
+        "阅读日志保留动作已经完成还是仍待确认。发现新版本时先比较实际记录，旧摘要中的结论只用于定位，不代替原文。",
+    ];
+    for (let first = 1; first <= count; first += 250) db.transaction(() => {
+        for (let seq = first; seq < Math.min(first + 250, count + 1); seq++) {
+            const marker = probes.find(p => p.id === `history-${seq}`)?.quote ?? `普通合成条目 ${seq}，段落版本 ${(seq * 37) % 997}`;
+            const filler = Array.from({ length: 10 }, (_, part) => `${corpus[(seq + part) % corpus.length]} 区段${(seq * 17 + part * 19) % 10007}。`).join("\n");
+            insert(seq, `${marker}\n${filler}`);
+        }
+    });
+    db.exec("PRAGMA wal_checkpoint(TRUNCATE)");
+    const sourceDatabaseBytes = statSync(file).size;
+    const update = (seq: number, text: string) => {
+        const hash = hashes.get(seq);
+        if (!hash) throw new Error(`No fixture row ${seq}`);
+        const raw = writer.prepare("SELECT bytes FROM content WHERE hash=?").get(hash) as { bytes: Uint8Array };
+        const old = JSON.parse(Buffer.from(raw.bytes).toString("utf8")) as SyntheticMessage;
+        const bytes = Buffer.from(JSON.stringify({ ...old, text }));
+        writer.prepare("UPDATE content SET bytes=?,byte_len=? WHERE hash=?").run(bytes, bytes.length, hash);
+    };
+    return {
+        dir, file, db, store, writer, session, sourceDatabaseBytes, count,
+        get sourceCharacters() { return sourceCharacters; }, get sourceBytes() { return sourceBytes; },
+        insert, update,
+        readText(seq: number) {
+            const raw = writer.prepare("SELECT bytes FROM content WHERE hash=?").get(hashes.get(seq)) as { bytes: Uint8Array };
+            return (JSON.parse(Buffer.from(raw.bytes).toString("utf8")) as SyntheticMessage).text ?? "";
+        },
+        erase(seq: number) { writer.prepare("DELETE FROM messages WHERE session_id=? AND seq=?").run(longHistorySession, seq); },
+        retire(seq: number) { writer.prepare("UPDATE messages SET retired_at=42 WHERE session_id=? AND seq=?").run(longHistorySession, seq); },
+        async close(remove = true) {
+            writer.close(); await store.closeSearchIndex(); store.close();
+            if (!remove) return;
+            const absolute = resolve(dir), base = resolve(tmpdir()) + sep;
+            if (!absolute.startsWith(base) || !absolute.includes("bili-fts-long-")) throw new Error("Unexpected benchmark cleanup target");
+            for (let attempt = 0; attempt < 10; attempt++) {
+                try { rmSync(absolute, { recursive: true, force: true }); return; }
+                catch (error) { if (attempt === 9) throw error; await new Promise(r => setTimeout(r, 100)); }
+            }
+        },
+    };
+}
+
+export function timingSummary(values: number[]) {
+    const sorted = [...values].sort((a, b) => a - b);
+    const p = (q: number) => Number((sorted[Math.max(0, Math.ceil(q * sorted.length) - 1)] ?? 0).toFixed(2));
+    return { samples: values.length, p50Ms: p(0.5), p95Ms: p(0.95), maxMs: p(1) };
+}
+
+export async function withHeartbeat<T>(operation: () => Promise<T> | T) {
+    let ticks = 0, maxGap = 0, last = performance.now();
+    const start = last;
+    const timer = setInterval(() => { const now = performance.now(); ticks++; maxGap = Math.max(maxGap, now - last); last = now; }, 10);
+    try {
+        const result = await operation();
+        const elapsedMs = performance.now() - start;
+        await new Promise(r => setTimeout(r, 15));
+        return { result, elapsedMs: Number(elapsedMs.toFixed(2)), heartbeatTicks: ticks, maxHeartbeatGapMs: Number(maxGap.toFixed(2)) };
+    } finally { clearInterval(timer); }
+}
