index 0000000000000000000000000000000000000000..76e3a0a2057477568f8bfedbfd319ad0f9ae7552
--- /dev/null
+++ b/src/search-text.ts
@@ -0,0 +1,12 @@
+import { createHash } from "node:crypto";
+import { redactSecretsInText } from "./log-mask.js";
+
+/** The index is derived, redacted text; original CAS blobs remain the source of truth. */
+export const cleanSearchText = (s: string): string => redactSecretsInText(s)
+    .replace(/((?:令牌|密钥|口令|密码)[】"'\s:=：]*)([\w.+/=-]{8,})/giu, "$1<masked>")
+    .replace(/(?:data:[\w.+/-]+;base64,)?[A-Za-z0-9+/=_-]{128,}/g, "<encoded bytes omitted>");
+
+export function prepareSearchText(sessionId: string, key: string, source: string, attachment = "") {
+    const text = cleanSearchText([source, attachment ? "[attachment] " + attachment : ""].filter(Boolean).join("\n"));
+    return { text, lower: text.toLowerCase(), evidence: "ev-" + createHash("sha256").update(sessionId + "\0" + key + "\0" + text).digest("hex").slice(0, 24) };
+}
diff --git a/src/semantic-settings.ts b/src/semantic-settings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44e1d4b738f64c009d3ba05a0ee853bb5f36a710
--- /dev/null
+++ b/src/semantic-settings.ts
@@ -0,0 +1,90 @@
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, writeFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { randomUUID } from "node:crypto";
+import type { SemanticConfig, SemanticControl, SemanticStatus } from "./semantic/types.js";
+
+export const defaults: SemanticConfig = {
+    enabled: false, model: "gemini-embedding-2", endpoint: "https://generativelanguage.googleapis.com/v1beta", keyEnv: "GEMINI_API_KEY",
+    dimensions: 1536, requestTimeoutMs: 45000, retries: 2, concurrency: 2, queryTimeoutMs: 3000,
+    maxRequestsPerMinute: 30, maxDailyRequests: 2000, chunkChars: 6000, candidateLimit: 24, rrfK: 60,
+    mediaEnabled: false, mediaMaxBytes: 15 * 1024 * 1024, mediaMaxPages: 6, mediaMaxSeconds: 60, ffmpegPath: "", ffprobePath: "",
+    allowedMediaRoots: [], selectedSessions: [], relevanceEnabled: false, relevanceModel: "gemini-3.8-flash",
+    relevanceTimeoutMs: 10000, secondHopEnabled: true, maxProbes: 2,
+};
+export function configPath(): string {
+    if (process.env.BILI_SEMANTIC_CONFIG_FILE) return path.resolve(process.env.BILI_SEMANTIC_CONFIG_FILE);
+    const parent = process.env.BILI_CONFIG_FILE ? path.dirname(path.resolve(process.env.BILI_CONFIG_FILE))
+        : path.join(process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config"), "billion-context");
+    return path.join(parent, "semantic-search.json");
+}
+export function dataPath(file = configPath()): string { return path.join(path.dirname(file), "semantic-search"); }
+export function validate(value: unknown): SemanticConfig {
+    if (!value || typeof value !== "object" || Array.isArray(value)) throw Error("Semantic settings must be an object");
+    const input = value as Record<string, unknown>, result = { ...defaults };
+    for (const key of ["enabled", "mediaEnabled", "relevanceEnabled", "secondHopEnabled"] as const) {
+        if (input[key] !== undefined && typeof input[key] !== "boolean") throw Error(`Invalid ${key}`);
+        if (typeof input[key] === "boolean") result[key] = input[key];
+    }
+    for (const key of ["model", "endpoint", "keyEnv", "relevanceModel"] as const) {
+        if (input[key] !== undefined) {
+            if (typeof input[key] !== "string" || !input[key].trim() || input[key].length > 400) throw Error(`Invalid ${key}`);
+            result[key] = input[key].trim();
+        }
+    }
+    for (const key of ["ffmpegPath", "ffprobePath"] as const) {
+        if (input[key] !== undefined) {
+            if (typeof input[key] !== "string" || input[key].length > 4096) throw Error(`Invalid ${key}`);
+            result[key] = input[key];
+        }
+    }
+    const endpoint = new URL(result.endpoint);
+    if (endpoint.protocol !== "https:" || endpoint.username || endpoint.password || endpoint.search || endpoint.hash) throw Error("Semantic endpoint requires HTTPS without credentials or query parameters");
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(result.keyEnv)) throw Error("Invalid semantic key environment variable name");
+    const limits: Record<string, readonly [number, number]> = {
+        dimensions: [128, 3072], requestTimeoutMs: [1000, 180000], retries: [0, 5], concurrency: [1, 4], queryTimeoutMs: [50, 30000],
+        maxRequestsPerMinute: [1, 600], maxDailyRequests: [1, 100000], chunkChars: [500, 20000], candidateLimit: [4, 100], rrfK: [1, 200],
+        mediaMaxBytes: [1024, 100 * 1024 * 1024], mediaMaxPages: [1, 100], mediaMaxSeconds: [1, 3600], relevanceTimeoutMs: [1000, 60000], maxProbes: [1, 3],
+    };
+    for (const [key, [min, max]] of Object.entries(limits)) {
+        const n = input[key];
+        if (n === undefined) continue;
+        if (typeof n !== "number" || !Number.isSafeInteger(n) || n < min || n > max) throw Error(`Invalid ${key}: expected ${min}–${max}`);
+        Object.assign(result, { [key]: n });
+    }
+    for (const key of ["allowedMediaRoots", "selectedSessions"] as const) {
+        if (input[key] === undefined) continue;
+        if (!Array.isArray(input[key]) || input[key].length > 1000 || !input[key].every(v => typeof v === "string" && v.length > 0 && v.length <= 4096)) throw Error(`Invalid ${key}`);
+        result[key] = [...new Set(input[key] as string[])];
+    }
+    if (result.allowedMediaRoots.some(root => !path.isAbsolute(root))) throw Error("Media roots must be absolute paths");
+    return result;
+}
+export function loadConfig(file = configPath()): SemanticConfig {
+    return existsSync(file) ? validate(JSON.parse(readFileSync(file, "utf8"))) : { ...defaults, allowedMediaRoots: [], selectedSessions: [] };
+}
+export function writeJson(file: string, value: unknown): void {
+    mkdirSync(path.dirname(file), { recursive: true });
+    const temp = file + "." + randomUUID() + ".tmp";
+    writeFileSync(temp, JSON.stringify(value), { mode: 0o600 }); renameSync(temp, file);
+}
+/** Settings reads never start a worker, traverse conversations, or call a provider. */
+export function loadStatus(file = configPath()) {
+    let config: SemanticConfig;
+    try { config = loadConfig(file); } catch (error) { return { configured: false, error: error instanceof Error ? error.message : "Invalid settings", instances: [] }; }
+    const root = dataPath(file), instances: (SemanticStatus & { stale: boolean })[] = [];
+    if (existsSync(root)) for (const name of readdirSync(root).filter(name => /^[a-f0-9]{24}\.status\.json$/.test(name))) {
+        try {
+            const status = JSON.parse(readFileSync(path.join(root, name), "utf8")) as SemanticStatus;
+            if (status.schema === 1) instances.push({ ...status, stale: Date.now() - status.updatedAt > 30000 });
+        } catch { /* A replaced/corrupt derived status does not affect sources. */ }
+    }
+    return { configured: true, enabled: config.enabled, model: config.model, dimensions: config.dimensions, keyAvailable: !!process.env[config.keyEnv], instances };
+}
+export function control(action: SemanticControl, file = configPath(), instance?: string) {
+    if (!["pause", "resume", "retry", "rebuild", "purge"].includes(action)) throw Error("Unknown semantic control");
+    if (instance !== undefined && !/^[a-f0-9]{24}$/.test(instance)) throw Error("Invalid semantic instance");
+    const id = randomUUID();
+    writeJson(path.join(dataPath(file), (instance ?? "all") + ".control.json"), { id, action, at: Date.now() });
+    return { accepted: true, id, action, status: "queued" };
+}
