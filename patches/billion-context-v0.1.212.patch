--- /dev/null
+++ b/tests/search-evidence-cache.test.ts
@@ -0,0 +1,91 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createInitialState, type CoreMessage } from "acp-kernel";
+import { UnifiedStore } from "../src/storage/store.js";
+import { openSqliteDatabase, type SqliteDatabase } from "../src/storage/driver.js";
+import type { SearchTranscriptCache } from "../src/storage/search-transcript-cache.js";
+import { SearchLru } from "../src/search-cache.js";
+import { searchEvidence, searchEvidenceCacheStats } from "../src/search-evidence.js";
+import type { Session } from "../src/session.js";
+
+test("SQLite original projection reuses unchanged sessions but invalidates edits, retirements, append and recreation",t=>{
+ const dir=fs.mkdtempSync(path.join(os.tmpdir(),"bili-search-cache-")),file=path.join(dir,"index.db");
+ const store=UnifiedStore.open(file),internal=store as unknown as {db:SqliteDatabase;searchTranscriptCache:SearchTranscriptCache};
+ const other=openSqliteDatabase(file).db;
+ t.after(()=>{other.close();store.close();fs.rmSync(dir,{recursive:true,force:true});});
+ const add=(sid:string,seq:number,body:string,db=internal.db)=>{
+  const raw=JSON.stringify({text:body,timestamp:123,source:{kind:"user"}}),hash=sid+"-"+seq+"-"+body;
+  db.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES (?,?,?)").run(hash,raw.length,Buffer.from(raw));
+  db.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES (?,?,?,'user','text',?)").run(sid,seq,"m"+seq,hash);
+  return hash;
+ };
+ const hash=add("one",1,"old word");
+ const initial=store.searchableTranscript("one");assert.equal(initial[0]?.text,"old word");
+ assert.strictEqual(store.searchableTranscript("one"),initial);
+ assert.equal(internal.searchTranscriptCache.stats().loads,1);
+ assert.throws(()=>{initial[0]!.text="poison";},TypeError);
+ // Re-saving identical bytes and unrelated metadata/session data must not invalidate this session.
+ internal.db.prepare("UPDATE messages SET role=role,retired_at=retired_at WHERE session_id='one'").run();
+ add("two",1,"other session",other);
+ assert.strictEqual(store.searchableTranscript("one"),initial);
+ assert.equal(internal.searchTranscriptCache.stats().loads,1);
+ // Same row count and same string length, written from another SQLite connection.
+ const edited=JSON.stringify({text:"new word",timestamp:123,source:{kind:"user"}});
+ other.prepare("UPDATE content SET bytes=? WHERE hash=?").run(Buffer.from(edited),hash);
+ assert.equal(store.searchableTranscript("one")[0]?.text,"new word");
+ assert.equal(internal.searchTranscriptCache.stats().loads,2);
+  const replacement=JSON.stringify({text:"next row"});
+  other.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES ('replacement',?,?)").run(replacement.length,Buffer.from(replacement));
+  other.prepare("UPDATE messages SET content_hash='replacement' WHERE session_id='one' AND seq=1").run();
+  assert.equal(store.searchableTranscript("one")[0]?.text,"next row");
+ add("one",2,"second message",other);assert.equal(store.searchableTranscript("one").length,2);
+ other.prepare("UPDATE messages SET retired_at=42 WHERE session_id='one' AND seq=1").run();
+ assert.deepEqual(store.searchableTranscript("one").map(r=>r.text),["second message"]);
+ other.prepare("DELETE FROM messages WHERE session_id='one'").run();assert.deepEqual(store.searchableTranscript("one"),[]);
+ add("one",1,"recreated row",other);assert.equal(store.searchableTranscript("one")[0]?.text,"recreated row");
+ // A schema repair that drops a trigger invalidates the cache and reinstalls the revision protocol.
+ other.exec("DROP TRIGGER search_transcript_update");
+ other.prepare("UPDATE messages SET role='tool' WHERE session_id='one'").run();
+ assert.equal(store.searchableTranscript("one")[0]?.role,"tool");
+  assert.equal(internal.searchTranscriptCache.stats().loads,8);
+});
+
+test("prepared evidence reuses redaction and normalized text, with same-length in-memory edits and scope changes detected",()=>{
+ const state=createInitialState(),messages:CoreMessage[]=[{id:"x",role:"tool",contentType:"text",text:"needleA "+"资料".repeat(10000)+" token=abcdef__123456789"}];
+ const session={id:"cache-scope-one",state,blockContents:new Map(),lastMessages:messages} as unknown as Session;
+ const query=(text:string)=>searchEvidence(session,text,3,messages,[]);
+ const before=searchEvidenceCacheStats(),hit=query("needleA");
+ const warm=searchEvidenceCacheStats();assert.equal(warm.preparations,before.preparations+1);
+ assert.match(query("资料"),/historical evidence/);assert.equal(searchEvidenceCacheStats().preparations,warm.preparations);
+ const handle=hit.match(/read: (open:ev-[a-f0-9]+:\d+)/)![1]!;
+ query(handle);assert.equal(searchEvidenceCacheStats().preparations,warm.preparations,"open handles do not rehash every full body");
+ assert.doesNotMatch(query("token"),/abcdef__123456789/);
+ messages[0]!.text=messages[0]!.text!.replace("needleA","needleB");
+ assert.match(query(handle),/unavailable or changed/);assert.match(query("needleB"),/needleB/);
+ const next=query("needleB").match(/read: (open:ev-[a-f0-9]+:\d+)/)![1]!;
+ session.id="cache-scope-two";assert.match(query(next),/unavailable or changed/);
+ messages.length=0;assert.match(query(next),/unavailable or changed/);
+});
+
+test("cache budgets evict least recently used values and never retain an oversized entry",()=>{
+ const cache=new SearchLru<string,string>(100,70);
+ cache.set("a","a",50);cache.set("b","b",40);cache.get("a");cache.set("c","c",30);
+ assert.equal(cache.get("b"),undefined);assert.equal(cache.get("a"),"a");assert.deepEqual(cache.stats(),{entries:2,bytes:80});
+ cache.set("a","too large",71);assert.equal(cache.get("a"),undefined);assert.deepEqual(cache.stats(),{entries:1,bytes:30});
+ cache.clear();assert.deepEqual(cache.stats(),{entries:0,bytes:0});
+});
+
+test("one-shot replay searches and evidence expansion do not retain private excerpts in the global cache",()=>{
+ const messages:CoreMessage[]=[{id:"private-once",role:"user",contentType:"text",text:"PRIVATE-REPLAY marker 岑舒 " + "原文".repeat(1200)}];
+ const session={id:"isolated-replay:cache-regression",state:createInitialState(),blockContents:new Map(),lastMessages:messages} as unknown as Session;
+ const before=searchEvidenceCacheStats();
+ const query=(text:string)=>searchEvidence(session,text,3,messages,[],undefined,undefined,{cache:false});
+ const result=query("岑舒"),handle=result.match(/read: (open:ev-[a-f0-9]+:\d+)/)![1]!;
+ assert.match(result,/PRIVATE-REPLAY/);assert.match(query(handle),/PRIVATE-REPLAY/);
+ assert.deepEqual(searchEvidenceCacheStats(),before,"no private source or normalized copy retained");
+ messages.length=0;assert.match(query(handle),/unavailable or changed/);
+ assert.deepEqual(searchEvidenceCacheStats(),before);
+});
diff --git a/tests/search-fts-acceptance.test.ts b/tests/search-fts-acceptance.test.ts
