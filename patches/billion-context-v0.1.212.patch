+/** Bounded caches for immutable search projections. Weights are conservative UTF-16
+ * string bytes plus per-record overhead; the cold query still reads its full source. */
+export class SearchLru<K, V> {
+    private values = new Map<K, { value: V; bytes: number }>();
+    private used = 0;
+    constructor(readonly budget = 32 * 1024 * 1024, readonly itemLimit = 8 * 1024 * 1024) {}
+    get(key: K): V | undefined {
+        const item = this.values.get(key);
+        if (!item) return;
+        this.values.delete(key); this.values.set(key, item);
+        return item.value;
+    }
+    set(key: K, value: V, bytes: number): void {
+        this.delete(key);
+        if (!Number.isSafeInteger(bytes) || bytes < 0 || bytes > this.itemLimit || bytes > this.budget) return;
+        while (this.used + bytes > this.budget && this.values.size) this.delete(this.values.keys().next().value!);
+        this.values.set(key, { value, bytes }); this.used += bytes;
+    }
+    delete(key: K): void {
+        const prior = this.values.get(key);
+        if (prior) { this.used -= prior.bytes; this.values.delete(key); }
+    }
+    clear(): void { this.values.clear(); this.used = 0; }
+    stats(): { entries: number; bytes: number } { return { entries: this.values.size, bytes: this.used }; }
+}
