+import { existsSync } from "node:fs";
+import { createRequire } from "node:module";
+import { Worker } from "node:worker_threads";
+import { pathToFileURL } from "node:url";
+import type { SearchIndexOptions, SearchIndexProgress, SearchIndexResult } from "./search-index-types.js";
+import { log as loggerLog } from "../logger.js";
+
+type TransferRow = NonNullable<SearchIndexOptions["overlays"]>[number] | NonNullable<SearchIndexOptions["summaries"]>[number] | NonNullable<SearchIndexOptions["archives"]>[number];
+type TransferState = { overlays: Map<string, TransferRow>; summaries: Map<string, TransferRow>; archives: Map<string, TransferRow>; estimatedBytes: number };
+const transferBudgetBytes = 64 * 1024 * 1024;
+interface SearchIndexClientRuntime {
+    inactivityTimeoutMs?: number;
+    createWorker?: () => Worker;
+}
+function estimateTransferBytes(row: TransferRow): number {
+    let size = 256;
+    for (const value of Object.values(row)) {
+        if (typeof value === "string") size += value.length * 2;
+        else if (Array.isArray(value)) for (const item of value) if (typeof item === "string") size += 32 + item.length * 2;
+    }
+    return size;
+}
+function equalRow(a: TransferRow, b: TransferRow): boolean {
+    const left = a as unknown as Record<string, unknown>, right = b as unknown as Record<string, unknown>;
+    const keys = new Set([...Object.keys(left), ...Object.keys(right)]);
+    for (const key of keys) {
+        const av = left[key], bv = right[key];
+        if (av === bv) continue;
+        if (Array.isArray(av) && Array.isArray(bv) && av.length === bv.length && av.every((value, index) => value === bv[index])) continue;
+        return false;
+    }
+    return true;
+}
+function transferDelta(rows: readonly TransferRow[], prior: Map<string, TransferRow>) {
+    const current = new Map<string, TransferRow>();
+    const changed: TransferRow[] = [];
+    let estimatedBytes = 0;
+    for (const row of rows) {
+        const old = prior.get(row.id);
+        const unchanged = old && equalRow(old, row);
+        if (!unchanged) changed.push(row);
+        // Copy only the tiny field object. Strings are immutable and keep their
+        // existing allocation; no JSON/hash/full-text normalization on the host.
+        current.set(row.id, unchanged ? old : { ...row, ...("coveredIds" in row && row.coveredIds ? { coveredIds: [...row.coveredIds] } : {}) });
+        estimatedBytes += estimateTransferBytes(row);
+    }
+    return { current, changed, removed: [...prior.keys()].filter(id => !current.has(id)), order: [...current.keys()], estimatedBytes };
