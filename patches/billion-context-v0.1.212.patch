+import type { CoreMessage, MessageContentStore } from "acp-kernel";
+import { parseStoredPlaceholder } from "acp-kernel";
+import type { BiliMessage } from "acp-kernel/wire";
+import type { Session } from "./session.js";
+import type { SearchTranscriptRow } from "./storage/store.js";
+import { cleanSearchText as clean, prepareSearchText } from "./search-text.js";
+import { safePrefix } from "./text-safe.js";
+import { SearchLru } from "./search-cache.js";
+import type { SearchIndexOptions, SearchIndexResult } from "./storage/search-index-types.js";
+
+const pageSize = 1600;
+type PreparedText = { text: string; lower: string; evidence: string };
+type Note = PreparedText & { key: string; label: string; ref?: string; block?: string; retrieve?: boolean; corrects?: string; offset?: number; totalChars?: number; head?: string };
+type Hit = { note: Note; score: number; at: number; order: number };
+const preparedCache = new SearchLru<string, PreparedText & { source: string; attachment: string; sessionId: string }>();
+const sessionKeys = new WeakMap<object, number>();
+let sessionSequence = 0, preparedHits = 0, preparedMisses = 0;
+function prepareText(session: Session, key: string, source: string, attachment = "", cache = true): PreparedText {
+    // One-shot private replay material must not outlive its caller in this
+    // process-wide cache. Keep exactly the same redaction and evidence IDs.
+    if (!cache) return prepareSearchText(session.id, key, source, attachment);
+    let owner = sessionKeys.get(session);
+    if (owner === undefined) { owner = ++sessionSequence; sessionKeys.set(session, owner); }
+    const cacheKey = owner + "/" + key, prior = preparedCache.get(cacheKey);
+    // Exact values, not array identity/length/prepare epoch, catch in-place and same-length edits.
+    if (prior?.source === source && prior.attachment === attachment && prior.sessionId === session.id) {
+        preparedHits++; return prior;
+    }
+    preparedMisses++;
+    const result = { source, attachment, sessionId: session.id, ...prepareSearchText(session.id, key, source, attachment) };
+    preparedCache.set(cacheKey, result, 256 + 2 * (source.length + attachment.length + session.id.length + result.text.length + result.lower.length));
+    return result;
+}
+/** Local diagnostic counters contain no source content or session identifiers. */
+export function searchEvidenceCacheStats() { return { ...preparedCache.stats(), hits: preparedHits, preparations: preparedMisses }; }
+
+function fromWire(m: CoreMessage): SearchTranscriptRow {
+    const raw = m as BiliMessage & { timestamp?: string | number; source?: {kind?: string}; corrects?: string; attachment?: {description?: string} };
+    const part = (raw.rawAnthropicBlock || raw.rawOpenaiContent || raw.rawResponsesItem) as { filename?: string; title?: string; description?: string; alt?: string } | undefined;
+    return { id:m.id, role:m.role, contentType:m.contentType, text:m.text, toolName:m.toolName,
+        sourceKind:raw.source?.kind, timestamp:raw.timestamp ?? m.ts, corrects:raw.corrects,
+        attachment:raw.attachment?.description || part?.description || part?.title || part?.filename || part?.alt || raw.imageMediaType };
+}
+
+export type EvidenceIndexQuery = (sessionId: string, query: string, limit: number, options?: SearchIndexOptions) => Promise<SearchIndexResult | null>;
+
+/** Production recall sends only the resident overlay and small block metadata to
+ * the worker. It never materializes the stored transcript on the host thread. */
+export async function searchEvidenceIndexed(session: Session, query: string, limit: number, view: CoreMessage[], queryIndex: EvidenceIndexQuery, store?: MessageContentStore, observe?: (id: string, text: string) => void): Promise<string> {
+    const scoped = /^block:(b\d+)\s+(.+)$/is.exec(query);
+    const target = scoped ? session.state.blocks.find(b => b.blockId === scoped[1]) : undefined;
+    if (scoped && !target) return "[Unknown original-evidence block in this session.]";
+    const overlays = new Map<string, SearchTranscriptRow>();
+    const excluded = new Set<string>();
+    for (const m of [...(session.lastMessages ?? []), ...view]) {
+        if (!m.id || m.id.startsWith("acp_summary_")) continue;
+        const row = fromWire(m);
+        const ref = session.state.messageRefs.byRaw[m.id], entry = ref && store?.byRef[ref];
+        const original = entry && entry.rawId === m.id ? store?.byHash[entry.hash] : undefined;
+        // A CCR carrier is not an edit. Recover its original if resident; if
+        // unavailable let the persisted source supply it. Real current text,
+        // including empty text and role changes, always wins over stale CCR.
+        const placeholder = typeof row.text === "string" ? parseStoredPlaceholder(row.text) : null;
+        if (placeholder && (!ref || placeholder.ref === ref)) {
+            if (original === undefined) continue;
+            row.text = original;
+        }
+        excluded.add(m.id);
+        overlays.set(m.id, row);
+    }
+    const summaries = session.state.blocks.filter(b => !b.active && (!target || b.blockId === target.blockId))
+        .map(b => ({ id: "summary/" + b.blockId, block: b.blockId, text: [b.topic, b.summary].filter(Boolean).join("\n") }));
+    const options: SearchIndexOptions = {
+        excludeIds: [...excluded], overlays: [...overlays.values()],
+        ...(target ? { allowedIds: target.effectiveMessageIds } : {}), summaries,
+        archiveCoverage: session.state.blocks.filter(b => !target || b.blockId === target.blockId)
+            .map(b => ({ block: b.blockId, ids: b.effectiveMessageIds })),
+    };
+    let result = await queryIndex(session.id, scoped?.[2] ?? query, limit, options);
+    // Most blocks already have typed originals in SQLite. Do not even touch
+    // their lazy full-text backing files, let alone clone them to the worker.
+    if (result?.missingArchiveBlocks?.length && !query.startsWith("open:")) {
+        const missing = new Set(result.missingArchiveBlocks);
+        const archives = session.state.blocks.filter(b => missing.has(b.blockId)).flatMap(b => {
+            const full = session.blockContents.get(b.blockId)?.full;
+            return full?.text ? [{ id: "archive/" + b.blockId, block: b.blockId, text: full.text, coveredIds: b.effectiveMessageIds }] : [];
+        });
+        if (archives.length) result = await queryIndex(session.id, scoped?.[2] ?? query, limit, { ...options, archives });
+    }
+    if (!result) return "[Historical evidence search is temporarily unavailable. No complete search was performed; this is not evidence that a record does not exist. Retry search_context later.]";
+    return renderIndexedEvidence(session, query, limit, result, observe);
+}
+
+/** Render only the worker-selected rows. Neighbor maps describe actual source
+ * adjacency: two hits next to one another in this array are not neighbors. */
+export function renderIndexedEvidence(session: Session, query: string, limit: number, result: SearchIndexResult, observe?: (id: string, text: string) => void): string {
+    const notes = new Map<string, Note>();
+    const coverage = new Map<string, string>();
+    const wanted = new Set(result.rows.map(r => r.id));
+    for (const b of [...session.state.blocks].sort((x, y) => Number(y.active) - Number(x.active) || x.tier - y.tier)) {
+        for (const id of b.effectiveMessageIds) if (wanted.has(id) && !coverage.has(id)) coverage.set(id, b.blockId);
+    }
+    for (const row of result.rows) {
+        const ref = session.state.messageRefs.byRaw[row.id];
+        const summary = row.id.startsWith("summary/");
+        const block = summary ? row.id.slice(8) : coverage.get(row.id);
+        const prepared = row.prepared ? { text: row.prepared.text, lower: row.prepared.text.toLowerCase(), evidence: row.prepared.evidence,
+            offset: row.prepared.offset, totalChars: row.prepared.totalChars, head: row.text ?? "" }
+            : prepareText(session, row.id, row.text ?? "", row.attachment ?? "");
+        notes.set(row.id, { ...prepared, key: row.id,
+            ref: ref?.startsWith("m") ? ref : undefined, block,
+            label: summary ? "historical inactive summary" : metadata(row),
+            corrects: typeof row.corrects === "string" ? row.corrects : undefined });
+    }
+    const cite = (n: Note) => `${clean(n.key).slice(0, 160)}${n.ref ? " " + n.ref : ""}${n.block ? " " + n.block : ""} ${n.label}`;
+    const read = /^open:(ev-[a-f0-9]{24})(?::(\d{1,12}))?$/.exec(query.trim());
+    if (read) {
+        const n = [...notes.values()].find(n => n.evidence === read[1]);
+        if (!n) return "[Original evidence unavailable or changed in this session; repeat the keyword search.]";
+        const offset = Number(read[2] || 0);
+        const total = n.totalChars ?? n.text.length;
+        if (offset >= total) return "[Original evidence page is beyond the end.]";
+        if (n.offset !== undefined && n.offset !== offset) return "[Original evidence page changed during search; repeat the keyword search.]";
+        const body = safePrefix(n.offset === undefined ? n.text.slice(offset) : n.text, pageSize);
+        observe?.(n.key, body);
+        return `[Evidence: ${cite(n)} | ${offset}–${offset + body.length}/${total}]\n${body}` + (offset + body.length < total ? `\n[next query: open:${n.evidence}:${offset + body.length}]` : "");
+    }
+    const text = (/^block:b\d+\s+(.+)$/is.exec(query)?.[1] ?? query).trim().toLowerCase();
+    const terms = [...new Set(text.split(/\s+/))];
+    const lines = result.matchIds.slice(0, limit).flatMap(id => {
+        const n = notes.get(id);
+        if (!n) return [];
+        const indexes = terms.map(t => n.lower.indexOf(t)).filter(i => i >= 0);
+        if (n.offset === undefined && !indexes.length) return [];
+        const start = n.offset ?? Math.max(0, indexes[0]! - 90);
+        const snippet = n.offset === undefined ? n.text.slice(start) : n.text;
+        observe?.(id, safePrefix(snippet, 270));
+        const nearby = Object.entries(result.neighbors[id] ?? {}).flatMap(([direction, neighborId]) => {
+            const neighbor = neighborId ? notes.get(neighborId) : undefined;
+            if (!neighbor) return [];
+            observe?.(neighbor.key, safePrefix(neighbor.head ?? neighbor.text, 125));
+            return [`  ${direction}: ${cite(neighbor)} — ${safePrefix(neighbor.head ?? neighbor.text, 125)}`];
+        });
+        const correctedBy = (result.corrections[id] ?? []).flatMap(key => notes.get(key) ? [notes.get(key)!] : []);
+        return [[cite(n), `  ${start ? "…" : ""}${safePrefix(snippet, 270)}`,
+            `  read: open:${n.evidence}:${start}`,
+            ...(n.corrects ? ["  corrects: " + clean(n.corrects).slice(0, 120)] : []),
+            ...correctedBy.map(c => "  explicitly corrected by " + cite(c)), ...nearby].join("\n")];
+    });
+    for (const block of result.archiveMatches ?? []) lines.push(`${block} [flattened archive locator; original speaker/time unavailable], inspect block via decompress; no attributable quote.`);
+    const warning = result.complete ? "" : "[Stored history coverage is incomplete; available recent messages were searched. A missing record is not evidence it never happened.]\n";
+    return lines.length ? warning + `Own-session historical evidence (indexed keyword search; order and neighboring statements alone do not establish a correction):\n${lines.join("\n\n")}` : warning;
+}
+
+function metadata(m: SearchTranscriptRow): string {
+    const declared = typeof m.sourceKind === "string" ? clean(m.sourceKind).slice(0, 100) : "";
+    const envelope = m.role === "user" && /【(?:本次消息快照|内部|QQ|会话令牌|引导唤醒|唤醒提醒)/u.test(m.text ?? "");
+    const who = declared ? "source="+declared : envelope ? "bridge/internal envelope; attribution requires the enclosed message" : "author unverified";
