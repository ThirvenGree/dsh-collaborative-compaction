+    }
+    private project(input: unknown): SourceRecord | null {
+        const raw = object(input);
+        if (!input) return null;
+        const identity = { id: text(raw.msg_id), role: text(raw.role), contentType: text(raw.kind) };
+        if (!eligible(identity)) return null;
+        let value: Record<string, unknown>;
+        try { value = object(JSON.parse(text(raw.content))); } catch { return null; }
