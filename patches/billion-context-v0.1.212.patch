+import type { SearchTranscriptRow } from "./store.js";
+
+export interface SearchIndexRow extends SearchTranscriptRow {
+    seq: number;
+    prepared?: { text: string; evidence: string; totalChars: number; offset: number; matchAt?: number };
+}
+export interface SearchIndexProgress {
+    /** Per-request monotonic source/checkpoint work, reported after commit. */
+    committed: number;
+}
+export interface SearchIndexOptions {
+    overlays?: SearchTranscriptRow[];
+    excludeIds?: string[];
+    allowedIds?: string[];
+    contextIds?: string[];
+    summaries?: { id: string; block: string; text: string }[];
+    archives?: { id: string; block: string; text: string; coveredIds?: string[] }[];
+    archiveCoverage?: { block: string; ids: string[] }[];
+    overlayReset?: boolean;
+    overlayRemovedIds?: string[];
+    overlayOrderIds?: string[];
+    summaryReset?: boolean;
+    summaryRemovedIds?: string[];
+    summaryOrderIds?: string[];
+    archiveReset?: boolean;
+    archiveRemovedIds?: string[];
+    archiveOrderIds?: string[];
+    discardSessions?: string[];
+}
+export interface SearchIndexResult {
+    rows: SearchIndexRow[];
+    matchIds: string[];
+    neighbors: Record<string, { previous?: string; next?: string }>;
+    corrections: Record<string, string[]>;
+    tailId?: string;
+    archiveMatches?: string[];
+    missingArchiveBlocks?: string[];
+    revision: number;
+    complete: boolean;
+    mode: "fts" | "scan";
+    stats: { indexed: number; loaded: number; matched: number; elapsedMs: number };
+}
