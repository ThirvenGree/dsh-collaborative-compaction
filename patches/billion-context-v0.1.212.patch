@@ -0,0 +1,69 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createCore, defaultConfig, type CoreMessage } from "acp-kernel";
+import { executeSearchContextTargetAsync } from "../src/decompress-shared.js";
+import type { SearchIndexOptions } from "../src/storage/search-index-types.js";
+import { makeLongFixture, probes } from "./search-long-fixture.js";
+
+test("production indexed search retains Chinese names, literal parameters, fresh overlays and source-page identity", async t => {
+    const f = makeLongFixture(500);
+    t.after(() => f.close());
+    const core = createCore();
+    const ctx = {
+        session: f.session, config: defaultConfig(200_000), messages: [] as CoreMessage[], log: () => {},
+        searchIndex: (sid: string, query: string, limit: number, options?: SearchIndexOptions) => f.store.indexedSearch(sid, query, limit, options),
+    };
+    const run = async (query: string) => (await executeSearchContextTargetAsync({ query, limit: 5 }, core, f.session.id, f.session.state, ctx)).text;
+    for (const probe of probes) {
+        const result = await run(probe.query);
+        assert.ok(result.includes(probe.id), `missing source for ${probe.query}`);
+        assert.ok(result.includes(probe.quote), `missing exact text for ${probe.query}`);
+    }
+    const hit = await run("RecentTokens");
+    const handle = hit.match(/read: (open:ev-[a-f0-9]+:\d+)/)?.[1];
+    assert.ok(handle);
+    assert.match(await run(handle), /preserveRecentTokens=32000/);
+    f.update(290, "preserveRecentTokens=48000，修改后的当前版本。");
+    assert.match(await run(handle), /unavailable or changed/);
+    assert.match(await run("RecentTokens"), /preserveRecentTokens=48000/);
+
+    const fresh: CoreMessage = { id: "live-latest", role: "user", contentType: "text", text: "青枔刚发来这条：rendererBudget=5137，尚未持久化。" };
+    ctx.messages = [fresh]; f.session.lastMessages = [fresh];
+    assert.match(await run("rendererBudget"), /live-latest[\s\S]*rendererBudget=5137/);
+    assert.match(await run("青枔"), /青枔刚发来这条/);
+
+    ctx.messages = [{ id: "history-120", role: "user", contentType: "text", text: "岑舒现在改用绿色文件夹。" }];
+    f.session.lastMessages = ctx.messages;
+    assert.match(await run("岑舒"), /绿色文件夹/);
+    assert.doesNotMatch(await run("蓝色文件夹"), /岑舒把窗台画放进蓝色文件夹/);
+    ctx.messages = []; f.session.lastMessages = [];
+    const oldNameText = f.readText(120), newNameText = oldNameText.replace("蓝色文件夹", "红色文件夹");
+    assert.equal(oldNameText.length, newNameText.length);
+    f.update(120, newNameText);
+    assert.match(await run("岑舒"), /红色文件夹/);
+    assert.doesNotMatch(await run("岑舒"), /蓝色文件夹/);
+    f.erase(155);
+    assert.doesNotMatch(await run("青枔想周末再看展览"), /history-155/);
+    f.retire(280);
+    assert.doesNotMatch(await run("autoFoldTargetTokens"), /history-280/);
+    f.insert(501, "新增琴弦资料已经写入，初次建库后也必须能找到。", f.writer);
+    assert.match(await run("琴弦"), /history-501/);
+});
+
+test("indexed tool search excludes reasoning, system content and secrets while retaining public attachment descriptions", async t => {
+    const f = makeLongFixture(500); t.after(() => f.close());
+    f.insert(501, "never-visible-reasoning", f.writer, { role: "assistant", contentType: "reasoning" });
+    f.insert(502, "never-visible-system", f.writer, { role: "system" });
+    f.insert(503, "public-auth-record token=synthetic___123456789", f.writer);
+    f.insert(504, "[image]", f.writer, { role: "tool", attachment: { description: "紫色窗格图像说明" } });
+    const core = createCore(), ctx = {
+        session: f.session, config: defaultConfig(200_000), messages: [] as CoreMessage[], log: () => {},
+        searchIndex: (sid: string, query: string, limit: number, options?: SearchIndexOptions) => f.store.indexedSearch(sid, query, limit, options),
+    };
+    const run = async (query: string) => (await executeSearchContextTargetAsync({ query, limit: 5 }, core, f.session.id, f.session.state, ctx)).text;
+    assert.doesNotMatch(await run("never-visible"), /history-501|history-502/);
+    assert.doesNotMatch(await run("synthetic___123456789"), /history-503/);
+    const publicHit = await run("public-auth-record");
+    assert.match(publicHit, /history-503/); assert.doesNotMatch(publicHit, /synthetic___123456789/);
+    assert.match(await run("紫色窗格"), /history-504[\s\S]*紫色窗格图像说明/);
+});
diff --git a/tests/search-index-dist.test.ts b/tests/search-index-dist.test.ts
new file mode 100644
index 00000000..6c1bcef7
--- /dev/null
+++ b/tests/search-index-dist.test.ts
@@ -0,0 +1,91 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import os from "node:os";
+import http from "node:http";
+import net from "node:net";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+
+const dist = path.resolve(import.meta.dirname, "../dist/index.js");
+const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+
+test("built CLI searches Chinese names, parameters and fresh messages through its packaged worker", { skip: !fs.existsSync(dist), timeout: 60000 }, async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-search-dist-"));
+    const upstream = http.createServer((req, res) => {
+        req.resume(); req.on("end", () => { res.setHeader("content-type", "application/json"); res.end(JSON.stringify({
+            id: "isolated-reply", object: "chat.completion", choices: [{ index: 0, message: { role: "assistant", content: "ready" }, finish_reason: "stop" }],
+            usage: { prompt_tokens: 200, completion_tokens: 1, total_tokens: 201 },
+        })); });
+    });
+    upstream.listen(0, "127.0.0.1"); await once(upstream, "listening");
+    const upstreamPort = (upstream.address() as net.AddressInfo).port;
+    // CLI requires a nonzero port. Reserve an OS-assigned port briefly and read
+    // the actual listening port from the child; startup collisions fail visibly.
+    const reservation = net.createServer(); reservation.listen(0, "127.0.0.1"); await once(reservation, "listening");
+    const port = (reservation.address() as net.AddressInfo).port;
+    await new Promise<void>(resolve => reservation.close(() => resolve()));
+    const config = path.join(dir, "config.json");
+    fs.writeFileSync(config, JSON.stringify({ port, host: "127.0.0.1", upstream: `http://127.0.0.1:${upstreamPort}`,
+        modelContextLimit: 400000, providers: { [`http://127.0.0.1:${upstreamPort}`]: { models: { "fts-dist-test": { context: 400000 } } } },
+        autoUpdate: false, advisoryCheck: false, releaseNotesCheck: false, autoRestartOnUpdate: false,
+        persist: { enabled: true, debounceMs: 0 }, storage: { unified: "full" },
+        compress: { injectTool: true, injectNudge: false, autoFold: false }, mitm: { enabled: false, domains: [] },
+    }));
+    const env: NodeJS.ProcessEnv = { ...process.env, NODE_ENV: "test", BILI_CONFIG_FILE: config, BILI_SESSIONS_DIR: path.join(dir, "sessions"),
+        BILI_PERSIST: "1", BILI_PERSIST_DEBOUNCE_MS: "0", BILI_STORAGE_UNIFIED: "full", BILI_ADVISORY_CHECK: "0",
+        XDG_CONFIG_HOME: path.join(dir, "config"), XDG_DATA_HOME: path.join(dir, "data"), XDG_CACHE_HOME: path.join(dir, "cache"), XDG_STATE_HOME: path.join(dir, "state"),
+        NO_PROXY: "127.0.0.1,localhost", no_proxy: "127.0.0.1,localhost" };
+    delete env.ACP_PORT; delete env.ACP_UPSTREAM; delete env.BILI_UPSTREAM_PROXY;
+    const child = spawn(process.execPath, [dist, "start", "--config", config], { cwd: dir, env, stdio: ["ignore", "pipe", "pipe"], windowsHide: true });
+    let output = "";
+    child.stdout.on("data", chunk => { output += String(chunk); });
+    child.stderr.on("data", chunk => { output += String(chunk); });
+    try {
+        let origin: string | undefined;
+        // v0.1.212 mutes non-TTY stderr once its file logger is ready (#5012).
+        // Read that isolated file too, then verify the responding process.
+        const logFile = path.join(dir, "state", "billion-context", "bili.log");
+        for (let i = 0; i < 300 && child.exitCode === null; i++) {
+            const fileOutput = fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8") : "";
+            const ready = (output + fileOutput).match(/listening on (http:\/\/127\.0\.0\.1:\d+)/);
+            if (ready) {
+                try {
+                    const response = await fetch(ready[1] + "/__bili/health", { signal: AbortSignal.timeout(500) });
+                    const health = await response.json() as { pid?: number };
+                    if (response.ok && health.pid === child.pid) { origin = ready[1]; break; }
+                } catch { /* bound sockets need not be announced yet */ }
+            }
+            await delay(50);
+        }
+        assert.ok(origin, `built CLI did not start: ${(output + (fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8") : "")).slice(-2000)}`);
+        const conversationId = "isolated-built-search";
+        const response = await fetch(`${origin}/bili/http://127.0.0.1:${upstreamPort}/v1/chat/completions`, {
+            method: "POST", headers: { "content-type": "application/json", "x-bili-plugin": "test-agent", "x-bili-plugin-conversation": conversationId, "x-acp-session": conversationId },
+            body: JSON.stringify({ model: "fts-dist-test", max_tokens: 64000, messages: [
+                { role: "user", content: "岑舒喜欢温热的茶。参数 preserveRecentTokens=12000，文件 E:/isolated/settings.json。" },
+                { role: "assistant", content: "记住了。" }, { role: "user", content: "青枔刚发送了这条消息：新消息标记即刻可查。" },
+            ] }), signal: AbortSignal.timeout(20000),
+        });
+        assert.equal(response.status, 200, await response.text());
+        for (const query of ["岑舒", "青枔", "preserveRecentTokens=12000", "新消息标记即刻可查"]) {
+            const res = await fetch(`${origin}/__bili/plugin/tool`, { method: "POST", headers: { "content-type": "application/json" },
+                body: JSON.stringify({ conversationId, tool: "search_context", args: { query } }), signal: AbortSignal.timeout(20000) });
+            const body = await res.json() as { ok?: boolean; result?: string; error?: string };
+            assert.equal(res.status, 200, JSON.stringify(body));
+            assert.equal(body.ok, true, JSON.stringify(body));
+            assert.ok(body.result?.includes(query), `${query}: ${body.result ?? body.error}`);
+            assert.match(body.result!, /indexed keyword search/);
+            assert.doesNotMatch(body.result!, /temporarily unavailable/);
+        }
+        assert.doesNotMatch(output + fs.readFileSync(logFile, "utf8"), /Packaged history search worker is missing|worker stopped before completing|worker-error/);
+    } finally {
+        if (child.exitCode === null) {
+            child.kill(); await Promise.race([once(child, "exit"), delay(5000)]);
+            if (child.exitCode === null && child.signalCode === null) { child.kill("SIGKILL"); await once(child, "exit"); }
+        }
+        upstream.closeAllConnections(); await new Promise<void>(resolve => upstream.close(() => resolve()));
+        fs.rmSync(dir, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });
+    }
+});
diff --git a/tests/search-index-integration.test.ts b/tests/search-index-integration.test.ts
new file mode 100644
