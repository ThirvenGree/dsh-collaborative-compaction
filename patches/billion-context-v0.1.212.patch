+        return worker;
+    }
+    query(sessionId: string, query: string, limit: number, options: SearchIndexOptions = {}): Promise<SearchIndexResult | null> {
+        // A following delta cannot assume an in-flight base was accepted. Other
+        // sessions remain independent; per-session requests await their receipt.
+        const before = this.queues.get(sessionId);
