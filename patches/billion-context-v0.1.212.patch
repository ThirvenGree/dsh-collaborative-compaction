@@ -0,0 +1,292 @@
+import test, { type TestContext } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { setTimeout as sleep } from "node:timers/promises";
+import { createHash } from "node:crypto";
+import { PDFDocument } from "pdf-lib";
+import { defaults } from "../src/semantic-settings.js";
+import { SemanticEngine } from "../src/semantic/engine.js";
+import { SearchIndexEngine } from "../src/storage/search-index-engine.js";
+import { fuseResults } from "../src/semantic/client.js";
+import { extractMedia } from "../src/semantic/media-source.js";
+import { SemanticProviderError } from "../src/semantic/provider.js";
+import { refineEvidence, type EvidenceCandidate } from "../src/semantic/relevance.js";
+import type { EmbeddingBatchResult, EmbeddingInput, SemanticConfig } from "../src/semantic/types.js";
+
+type Provider = ConstructorParameters<typeof SemanticEngine>[2];
+const vector = (axis: number) => Array.from({ length: 128 }, (_, i) => i === axis ? 1 : 0);
+const fakeProvider: Provider = async (inputs, config) => ({ items: inputs.map(input => {
+    const text = input.parts.map(part => "text" in part ? part.text : "image").join(" ");
+    return { id: input.id, vector: vector(/tea|茶|画像|image/i.test(text) ? 0 : 1) };
+}), model: config.model, dimensions: config.dimensions, usage: { promptTokenCount: 1, totalTokenCount: 1 } });
+
+function fixture(t: TestContext, provider: Provider = fakeProvider, extra: Partial<SemanticConfig> = {}) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-semantic-integration-"));
+    const file = path.join(dir, "source.sqlite"), settings = path.join(dir, "semantic-search.json");
+    const db = new DatabaseSync(file);
+    db.exec(`PRAGMA journal_mode=WAL;
+ CREATE TABLE sessions(session_id TEXT PRIMARY KEY);
+ CREATE TABLE content(hash TEXT PRIMARY KEY,bytes BLOB);
+ CREATE TABLE messages(session_id TEXT,seq INTEGER,msg_id TEXT,role TEXT,kind TEXT,content_hash TEXT,ts INTEGER,retired_at INTEGER,ref TEXT);
+ CREATE TABLE search_index_meta(id INTEGER PRIMARY KEY,generation TEXT); INSERT INTO search_index_meta VALUES(1,'fixture-v1');
+ CREATE TABLE search_index_versions(session_id TEXT PRIMARY KEY,revision INTEGER);
+ CREATE TABLE search_index_dirty(session_id TEXT,seq INTEGER,revision INTEGER,PRIMARY KEY(session_id,seq));
+ CREATE INDEX semantic_fixture_scope ON messages(session_id,seq);
+ CREATE INDEX semantic_fixture_id ON messages(session_id,msg_id,seq);`);
+    const config = { ...defaults, enabled: true, dimensions: 128, candidateLimit: 8, relevanceEnabled: true, ...extra };
+    fs.writeFileSync(settings, JSON.stringify(config));
+    const change = (session: string, seq: number) => {
+        db.prepare("INSERT INTO search_index_versions VALUES(?,1) ON CONFLICT(session_id) DO UPDATE SET revision=revision+1").run(session);
+        db.prepare("INSERT INTO search_index_dirty SELECT ?,?,revision FROM search_index_versions WHERE session_id=? ON CONFLICT(session_id,seq) DO UPDATE SET revision=excluded.revision").run(session, seq, session);
+    };
+    const put = (session: string, seq: number, id: string, value: Record<string, unknown>, kind = "text", role = "user") => {
+        const raw = JSON.stringify(value), hash = createHash("sha256").update(raw).digest("hex");
+        db.prepare("INSERT OR IGNORE INTO sessions VALUES(?)").run(session);
+        db.prepare("INSERT OR IGNORE INTO content VALUES(?,?)").run(hash, Buffer.from(raw));
+        db.prepare("INSERT INTO messages VALUES(?,?,?,?,?,?,?,NULL,?)").run(session, seq, id, role, kind, hash, 1_793_000_000_000 + seq * 1_000, "m" + seq);
+        change(session, seq);
+    };
+    const engine = new SemanticEngine(file, settings, provider), lexical = new SearchIndexEngine(file);
+    const resumedEngines: SemanticEngine[] = [];
+    const digest = () => createHash("sha256").update(JSON.stringify({ messages: db.prepare("SELECT * FROM messages ORDER BY session_id,seq").all(), content: db.prepare("SELECT hash,hex(bytes) FROM content ORDER BY hash").all() })).digest("hex");
+    t.after(() => {
+        for (const resumed of resumedEngines) resumed.close();
+        engine.close(); lexical.close(); db.close();
+        const resolved = path.resolve(dir);
+        assert.ok(resolved.startsWith(path.resolve(os.tmpdir()) + path.sep) && path.basename(resolved).startsWith("bili-semantic-integration-"));
+        fs.rmSync(resolved, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });
+    });
+    return { engine, lexical, db, put, digest, change, settings, config, dir, resumedEngines };
+}
+async function drain(engine: SemanticEngine) {
+    for (let count = 0; count < 100; count++) {
+        await engine.tick(); await sleep(2);
+        const status = engine.status();
+        if (count > 3 && status.pending === 0 && status.phase === "idle") return;
+    }
+    throw Error("semantic fixture did not finish indexing");
+}
+const evidence = (rows: ReturnType<SearchIndexEngine["query"]>): EvidenceCandidate[] => rows.matchIds.flatMap(id => {
+    const row = rows.rows.find(row => row.id === id);
+    return row?.prepared ? [{ id, sessionId: "chat", version: row.prepared.evidence, text: row.prepared.text, exact: rows.semantic?.exactIds.includes(id), corrects: row.corrects }] : [];
+});
+
+test("new persisted controls publish their acknowledgement immediately without repeated heartbeat writes", async t => {
+    const f = fixture(t), now = Date.now();
+    t.mock.method(Date, "now", () => now);
+    const status = t.mock.method(f.engine, "status", f.engine.status.bind(f.engine));
+    const control = path.join(f.dir, "semantic-search", "all.control.json");
+    const statusFile = path.join(f.dir, "semantic-search", f.engine.instance + ".status.json");
+    const readStatus = () => JSON.parse(fs.readFileSync(statusFile, "utf8")) as { paused: boolean; phase: string };
+    fs.writeFileSync(control, JSON.stringify({ id: "pause-now", action: "pause" }));
+    await f.engine.tick();
+    assert.equal(readStatus().paused, true); assert.equal(readStatus().phase, "paused");
+    assert.equal(status.mock.callCount(), 1, "operator command publishes without waiting 5 seconds");
+    await f.engine.tick();
+    assert.equal(status.mock.callCount(), 1, "the same command is acknowledged only once");
+    fs.writeFileSync(control, JSON.stringify({ id: "resume-now", action: "resume" }));
+    await f.engine.tick();
+    assert.equal(readStatus().paused, false); assert.equal(readStatus().phase, "idle");
+    assert.equal(status.mock.callCount(), 2);
+});
+
+test("A lexical/B vector/C hybrid/D localized hybrid retain Chinese originals and later negation without shared query words", async t => {
+    const f = fixture(t);
+    f.put("chat", 0, "old", { text: "青枔喜欢冷茶。" });
+    f.put("chat", 16, "corrected", { text: "更正：我不喜欢冷茶，我喜欢温热的茶。", corrects: "old" });
+    f.put("elsewhere", 0, "foreign", { text: "青枔的私人账号资料。" });
+    const before = f.digest(); f.engine.watch("chat"); f.engine.watch("elsewhere"); await drain(f.engine);
+    const a = f.lexical.query("chat", "tea preference", 5);
+    assert.deepEqual(a.matchIds, []);
+    const b = await f.engine.query("chat", "tea preference", 5);
+    assert.ok(b.candidates.some(candidate => candidate.rows.some(row => row.id === "corrected")));
+    assert.ok(b.candidates.every(candidate => candidate.refs.every(ref => ref.sessionId === "chat")));
+    const exact = f.lexical.query("chat", "青枔", 5), c = fuseResults(exact, b, { searchMode: "hybrid" }, 5);
+    assert.ok(c.matchIds.includes("old")); assert.ok(c.matchIds.includes("corrected"));
+    const d = await refineEvidence({ query: "tea preference", candidates: evidence(c), config: f.config, mode: "reasoned", generate: async request => {
+        const candidates = JSON.parse(request.prompt).untrustedEvidence as EvidenceCandidate[];
+        const row = candidates.find(candidate => candidate.id === "corrected")!;
+        return JSON.stringify({ ranked: [{ id: row.id, sessionId: row.sessionId, version: row.version, relevance: "relevant", quotes: [row.text] }], sufficient: true, probes: [] });
+    } });
+    assert.equal(d.candidates[0].id, "corrected");
+    assert.match(d.annotations.corrected.quotes[0], /不喜欢冷茶/);
+    assert.ok(d.candidates.some(candidate => candidate.id === "old"), "exact source is not removed by model ranking");
+    assert.equal(f.digest(), before, "search and refinement must not write formal memories/history");
+});
+
+test("just-received resident text is immediately lexical-searchable and becomes semantic without requiring disk persistence", async t => {
+    const f = fixture(t); f.put("chat", 0, "old", { text: "旧记录" }); f.engine.watch("chat");
+    const overlays = [{ id: "fresh", role: "user", contentType: "text", text: "青枔刚发送：新茶温度 55°C --fresh-flag=8192" }];
+    assert.ok(f.lexical.query("chat", "青枔", 5, { overlays }).matchIds.includes("fresh"));
+    f.engine.updateOverlays("chat", overlays); await drain(f.engine);
+    const result = await f.engine.query("chat", "tea", 5, { overlays });
+    assert.ok(result.candidates.some(candidate => candidate.rows.some(row => row.id === "fresh")));
+    assert.equal(f.db.prepare("SELECT 1 FROM messages WHERE msg_id='fresh'").get(), undefined);
+});
+
+test("a source deleted during an embedding request cannot be resurrected by its late response", async t => {
+    let release: (() => void) | undefined, began = false;
+    const provider: Provider = async (inputs, config) => {
+        if (inputs[0].kind === "document") { began = true; await new Promise<void>(resolve => { release = resolve; }); }
+        return fakeProvider!(inputs, config);
+    };
+    const f = fixture(t, provider); f.put("chat", 0, "to-delete", { text: "青枔喜欢温茶。" }); f.engine.watch("chat");
+    await f.engine.tick();
+    for (let i = 0; i < 20 && !began; i++) await sleep(2);
+    assert.equal(began, true);
+    f.db.prepare("DELETE FROM messages WHERE session_id='chat' AND msg_id='to-delete'").run(); f.change("chat", 0);
+    release!(); await sleep(10);
+    const result = await f.engine.query("chat", "tea", 5);
+    assert.deepEqual(result.candidates, []);
+    assert.equal((f.engine.db.prepare("SELECT count(*) AS n FROM vectors").get() as { n: number }).n, 0);
+    assert.ok(f.engine.status().rejectedStale > 0);
+});
+
+test("PDF page vectors preserve independent source page references through engine query", async t => {
+    const f = fixture(t, fakeProvider, { mediaEnabled: true });
+    const document = await PDFDocument.create(); document.addPage().drawText("first page"); document.addPage().drawText("second page");
+    const bytes = await document.save();
+    f.put("chat", 0, "pdf-original", { text: "收藏书页", imageBase64: Buffer.from(bytes).toString("base64"), imageMediaType: "application/pdf" });
+    f.engine.watch("chat"); await drain(f.engine);
+    const result = await f.engine.query("chat", "image", 8);
+    const pages = result.candidates.filter(candidate => candidate.modality === "pdf").flatMap(candidate => candidate.refs.map(ref => ref.page));
+    assert.deepEqual([...new Set(pages)].sort(), [1, 2]);
+    assert.ok(result.candidates.filter(candidate => candidate.modality === "pdf").every(candidate => candidate.refs.every(ref => ref.sourceHash && ref.mediaHash)));
+    const second = result.candidates.find(candidate => candidate.modality === "pdf" && candidate.refs.some(ref => ref.page === 2))!;
+    const opened = await f.engine.query("chat", "media:" + second.id, 1);
+    assert.equal(opened.openedMedia?.refs[0].page, 2);
+    assert.deepEqual(fs.readFileSync(opened.openedMedia!.path), Buffer.from(bytes), "page locator opens its verified original PDF");
+    assert.equal((await f.engine.query("another-session", "media:" + second.id, 1)).openedMedia, undefined);
+    assert.equal((await f.engine.query("chat", "media:" + second.id, 1, { allowedIds: ["other-block-message"] })).openedMedia, undefined);
+});
+
+test("fresh media overlay can be opened, but replacing a local original invalidates its old handle", async t => {
+    const f = fixture(t, fakeProvider, { mediaEnabled: true });
+    f.put("chat", 0, "initial", { text: "会话开始" });
+    fs.writeFileSync(f.settings, JSON.stringify({ ...f.config, allowedMediaRoots: [f.dir] }));
