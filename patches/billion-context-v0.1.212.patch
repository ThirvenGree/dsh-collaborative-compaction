+const environmentCache = new Map<string, { until: number; promise: Promise<string | undefined> }>();
+export function clearSemanticKeyCache(): void { environmentCache.clear(); }
+/** Environment variables persisted after DSH started are read asynchronously and cached, never logged. */
+export async function resolveSemanticKeyAsync(config: Pick<SemanticConfig, "keyEnv">, signal?: AbortSignal): Promise<string> {
+    aborted(signal);
+    const name = config.keyEnv || "GEMINI_API_KEY";
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) throw new SemanticProviderError("configuration", "Invalid API key environment variable name");
+    const inherited = process.env[name]?.trim();
+    if (inherited) return inherited;
+    if (process.platform !== "win32") return resolveSemanticKey(config);
+    let entry = environmentCache.get(name);
+    if (!entry || entry.until <= Date.now()) {
+        const promise = new Promise<string | undefined>(resolve => {
+            const command = `$v=[Environment]::GetEnvironmentVariable('${name}','User');if(-not $v){$v=[Environment]::GetEnvironmentVariable('${name}','Machine')};[Console]::Out.Write($v)`;
+            execFile("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", command], { windowsHide: true, timeout: 10000, maxBuffer: 16 * 1024, encoding: "utf8" }, (error, stdout) => resolve(error ? undefined : stdout.trim() || undefined));
+        });
+        const created = { until: Date.now() + 300000, promise }; entry = created; environmentCache.set(name, created);
+        // Missing configuration is retryable after a short interval, rather than cached forever.
+        void promise.then(value => { if (!value && environmentCache.get(name) === created) created.until = Date.now() + 30000; });
+    }
+    let cancel: (() => void) | undefined;
+    const cancelled = signal ? new Promise<never>((_, reject) => { cancel = () => reject(new SemanticProviderError("aborted", "API key lookup was cancelled")); signal.addEventListener("abort", cancel, { once: true }); }) : undefined;
+    let value: string | undefined;
+    try { value = await (cancelled ? Promise.race([entry.promise, cancelled]) : entry.promise); }
+    finally { if (cancel) signal?.removeEventListener("abort", cancel); }
+    aborted(signal);
+    if (!value) throw new SemanticProviderError("configuration", `Missing environment variable ${name}`);
+    return value;
+}
+
+export interface EmbeddingRequestHooks {
+    /** Called immediately before EVERY HTTP attempt, including countTokens and retries. May refuse it. */
+    beforeRequest?: (info: { method: "countTokens" | "embedContent"; attempt: number }) => void | Promise<void>;
+    onUsage?: (usage: { promptTokenCount: number; totalTokenCount: number }) => void;
+}
+
+function record(value: unknown): value is Record<string, unknown> { return !!value && typeof value === "object" && !Array.isArray(value); }
+function positiveCount(value: unknown): number { return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : 0; }
+function aborted(signal?: AbortSignal): void {
+    if (signal?.aborted) throw new SemanticProviderError("aborted", "Embedding request was cancelled");
+}
+function endpoint(config: SemanticConfig, method: string): string {
+    const base = new URL(config.endpoint);
+    if (base.protocol !== "https:" || base.username || base.password || base.search || base.hash) throw new SemanticProviderError("configuration", "Embedding endpoint requires HTTPS without credentials or query parameters");
+    const model = config.model.replace(/^models\//, "");
+    if (model !== "gemini-embedding-2") throw new SemanticProviderError("configuration", "This provider requires gemini-embedding-2; embedding spaces cannot be mixed");
+    return `${base.href.replace(/\/$/, "")}/models/${model}:${method}`;
+}
+
+function preparedParts(input: EmbeddingInput, config: SemanticConfig): EmbeddingPart[] {
+    if (!input.id || !Array.isArray(input.parts) || !input.parts.length || !["query", "document"].includes(input.kind)) throw new SemanticProviderError("invalid_input", "Embedding input is empty or invalid");
+    let images = 0, audio = 0, video = 0, pdf = 0, totalBytes = 0;
+    for (const part of input.parts) {
+        if ("text" in part) {
+            if (typeof part.text !== "string") throw new SemanticProviderError("invalid_input", "Invalid text part");
+            totalBytes += Buffer.byteLength(part.text, "utf8");
+            continue;
+        }
+        const media = part.inlineData;
+        const encoded = media?.data;
+        // Linear scans avoid a repeated-group regexp overflowing on multi-megabyte audio/video.
+        const padding = typeof encoded === "string" ? encoded.indexOf("=") : -1;
+        if (typeof encoded !== "string" || !encoded.length || encoded.length % 4 !== 0 || /[^A-Za-z0-9+/=]/.test(encoded) || padding >= 0 && (padding < encoded.length - 2 || !/^={1,2}$/.test(encoded.slice(padding)))) throw new SemanticProviderError("invalid_input", "Invalid inline media encoding");
+        totalBytes += Buffer.byteLength(media.data, "base64");
+        if (["image/png", "image/jpeg"].includes(media.mimeType)) images++;
+        else if (["audio/mpeg", "audio/mp3", "audio/wav", "audio/x-wav"].includes(media.mimeType)) audio++;
+        else if (["video/mp4", "video/quicktime"].includes(media.mimeType)) video++;
+        else if (media.mimeType === "application/pdf") pdf++;
+        else throw new SemanticProviderError("invalid_input", "Unsupported embedding media MIME type");
+    }
+    if (images > 6 || audio > 1 || video > 1 || pdf > 1) throw new SemanticProviderError("invalid_input", "Embedding input exceeds modality item limits");
+    if (totalBytes > Math.min(50 * 1024 * 1024, Math.max(config.mediaMaxBytes, 64 * 1024))) throw new SemanticProviderError("invalid_input", "Embedding input exceeds configured byte limit");
+    // Gemini Embedding 2 does not accept taskType. Prefix only text-only retrieval inputs.
+    if (!images && !audio && !video && !pdf) {
+        const text = input.parts.map(part => "text" in part ? part.text : "").join("\n");
+        if (!text.trim()) throw new SemanticProviderError("invalid_input", "Embedding text is empty");
+        return [{ text: input.kind === "query" ? `task: search result | query: ${text}` : `title: none | text: ${text}` }];
+    }
+    return input.parts;
+}
+
+interface RequestCounter { requests: number; counts: number }
+async function request(config: SemanticConfig, method: "countTokens" | "embedContent", payload: unknown, key: string, counter: RequestCounter, signal?: AbortSignal, hooks?: EmbeddingRequestHooks): Promise<Record<string, unknown>> {
+    const url = endpoint(config, method);
+    for (let attempt = 0; ; attempt++) {
+        aborted(signal);
+        await hooks?.beforeRequest?.({ method, attempt });
+        aborted(signal);
+        const timeout = AbortSignal.timeout(config.requestTimeoutMs);
+        const combined = signal ? AbortSignal.any([signal, timeout]) : timeout;
+        let retryAfter = 0;
+        try {
+            counter.requests++; if (method === "countTokens") counter.counts++;
+            const response = await fetch(url, { method: "POST", headers: { "content-type": "application/json", "x-goog-api-key": key }, body: JSON.stringify(payload), signal: combined, redirect: "error" });
+            if (!response.ok) {
+                const retryable = response.status === 408 || response.status === 429 || response.status >= 500;
+                const rawDelay = response.headers.get("retry-after");
+                if (rawDelay) retryAfter = /^\d+(\.\d+)?$/.test(rawDelay) ? Number(rawDelay) * 1000 : Math.max(0, Date.parse(rawDelay) - Date.now());
+                await response.body?.cancel();
+                throw new SemanticProviderError(retryable ? "transient" : "provider", `Gemini ${method} HTTP ${response.status}`, response.status, retryable);
+            }
+            // Output vectors and token counts are small. Refuse an unexpectedly unbounded response.
+            const chunks: Uint8Array[] = []; let length = 0;
+            if (!response.body) throw new SemanticProviderError("invalid_response", "Gemini response has no body");
+            for await (const chunk of response.body) {
+                length += chunk.byteLength;
+                if (length > 1024 * 1024) throw new SemanticProviderError("invalid_response", "Gemini response exceeds expected size");
+                chunks.push(chunk);
+            }
+            let value: unknown;
+            try { value = JSON.parse(Buffer.concat(chunks).toString("utf8")); }
+            catch { throw new SemanticProviderError("invalid_response", "Gemini response is not valid JSON"); }
+            if (!record(value)) throw new SemanticProviderError("invalid_response", "Gemini response has an invalid shape");
+            return value;
+        } catch (error) {
+            aborted(signal);
+            const safe = error instanceof SemanticProviderError ? error : new SemanticProviderError("transient", timeout.aborted ? "Gemini request timed out" : "Gemini transport failed", undefined, true);
+            if (!safe.retryable || attempt >= config.retries) throw safe;
+            // Small bounded jitter avoids synchronized retries. Abort remains responsive during backoff.
+            const delay = Math.min(30000, Math.max(retryAfter || 0, 500 * 2 ** attempt + Math.random() * 200));
+            try { await sleep(delay, undefined, { signal }); } catch { aborted(signal); throw safe; }
+        }
+    }
+}
+
+/** One vector per distinct input, never aggregate unrelated Content objects into a shared vector. */
+export async function embed(inputs: EmbeddingInput[], config: SemanticConfig, signal?: AbortSignal, hooks?: EmbeddingRequestHooks): Promise<EmbeddingBatchResult> {
+    if (!Number.isInteger(config.dimensions) || config.dimensions < 128 || config.dimensions > 3072) throw new SemanticProviderError("configuration", "Embedding dimensions must be between 128 and 3072");
+    if (!Number.isInteger(config.retries) || config.retries < 0 || config.retries > 5 || !Number.isFinite(config.requestTimeoutMs) || config.requestTimeoutMs < 1) throw new SemanticProviderError("configuration", "Invalid embedding retry or timeout configuration");
+    const key = await resolveSemanticKeyAsync(config, signal), counter = { requests: 0, counts: 0 };
+    const items: EmbeddingBatchResult["items"] = []; let promptTokenCount = 0, totalTokenCount = 0;
+    const seen = new Set<string>();
+    for (const input of inputs) {
+        aborted(signal);
+        if (seen.has(input.id)) throw new SemanticProviderError("invalid_input", "Duplicate embedding input ID");
+        seen.add(input.id);
+        const parts = preparedParts(input, config);
+        const count = await request(config, "countTokens", { contents: [{ parts }] }, key, counter, signal, hooks);
+        if (typeof count.totalTokens !== "number" || !Number.isSafeInteger(count.totalTokens) || count.totalTokens < 1) throw new SemanticProviderError("invalid_response", "Gemini did not confirm the complete input token count");
+        if (count.totalTokens > 8192) throw new SemanticProviderError("invalid_input", `Embedding input requires ${count.totalTokens} tokens; split it before embedding (limit 8192)`);
+        const result = await request(config, "embedContent", { model: "models/gemini-embedding-2", content: { parts }, outputDimensionality: config.dimensions }, key, counter, signal, hooks);
+        const values = record(result.embedding) ? result.embedding.values : undefined;
+        if (!Array.isArray(values) || values.length !== config.dimensions || !values.every(v => typeof v === "number" && Number.isFinite(v))) throw new SemanticProviderError("invalid_response", "Gemini returned invalid vector dimensions or values");
+        const vector = values as number[], norm = Math.sqrt(vector.reduce((sum, v) => sum + v * v, 0));
+        if (!Number.isFinite(norm) || norm < 1e-12) throw new SemanticProviderError("invalid_response", "Gemini returned a zero or invalid vector");
+        // API normalizes reduced dimensions; normalize again to account for serialized float precision.
+        items.push({ id: input.id, vector: vector.map(v => v / norm) });
+        const usage = record(result.usageMetadata) ? result.usageMetadata : {};
+        const used = { promptTokenCount: positiveCount(usage.promptTokenCount) || count.totalTokens, totalTokenCount: positiveCount(usage.totalTokenCount) || count.totalTokens };
+        promptTokenCount += used.promptTokenCount; totalTokenCount += used.totalTokenCount;
+        hooks?.onUsage?.(used);
+    }
+    return { items, model: "gemini-embedding-2", dimensions: config.dimensions, usage: { promptTokenCount, totalTokenCount, requestCount: counter.requests, countRequests: counter.counts } };
+}
