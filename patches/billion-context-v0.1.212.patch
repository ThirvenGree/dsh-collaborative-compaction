+test("a failed base transfer makes an already queued search resend fresh overlays", async () => {
+    const client = new SearchIndexClient(null);
+    try {
+        await client.query("isolated-failed-transfer", "old", 3, { overlays: [message("one", "old")] });
+        const worker = (client as unknown as { worker: Worker }).worker;
+        const post = worker.postMessage.bind(worker);
+        let failOnce = true;
+        worker.postMessage = (payload: { id: number }) => {
+            if (failOnce) {
+                failOnce = false;
+                // Simulate a source-lock failure before the engine sees the
+                // changed overlay; no body is ever delivered to this worker.
+                queueMicrotask(() => worker.emit("message", { id: payload.id, error: "source temporarily busy" }));
+            } else post(payload);
+        };
