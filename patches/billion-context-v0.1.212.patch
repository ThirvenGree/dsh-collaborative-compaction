+import type { EmbeddingPart, SemanticConfig, SourceRef } from "./types.js";
+
+export interface AuthorizedMediaInput {
+    id: string;
+    bytes: Uint8Array;
+    mimeType: string;
+    /** The caller has resolved bytes from this selected session's inline/CAS/authorized manifest. */
+    authorized: true;
