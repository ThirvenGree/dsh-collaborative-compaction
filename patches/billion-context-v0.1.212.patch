+++ b/src/storage/search-index-journal.ts
@@ -0,0 +1,55 @@
+import { randomUUID } from "node:crypto";
+import type { SqliteDatabase } from "./driver.js";
+
+const names = ["search_index_mi", "search_index_md", "search_index_mu", "search_index_ci", "search_index_cu", "search_index_cd"];
+const change = (owner: string, seq: string) => `
+ INSERT INTO search_index_versions VALUES (${owner},1) ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+ INSERT INTO search_index_dirty SELECT ${owner},${seq},revision FROM search_index_versions WHERE session_id=${owner}
+ ON CONFLICT(session_id,seq) DO UPDATE SET revision=excluded.revision;`;
+
+/** Only the owning connection installs these small transactional change markers.
+ * The worker never writes the source DB (including WAL checkpoints). */
+export class SearchIndexJournal {
+    private schema = -1;
+    constructor(private db: SqliteDatabase) {}
+    ensure(): void {
+        const schema = Number((this.db.prepare("PRAGMA schema_version").get() as { schema_version: number }).schema_version);
+        if (schema === this.schema && this.db.prepare("SELECT 1 FROM search_index_meta WHERE id=1").get()) return;
+        this.db.transaction(() => {
+            this.db.exec(`CREATE TABLE IF NOT EXISTS search_index_meta (id INTEGER PRIMARY KEY CHECK(id=1), generation TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS search_index_versions (session_id TEXT PRIMARY KEY, revision INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS search_index_dirty (session_id TEXT NOT NULL,seq INTEGER NOT NULL,revision INTEGER NOT NULL,PRIMARY KEY(session_id,seq));
+CREATE INDEX IF NOT EXISTS search_index_dirty_revision ON search_index_dirty(session_id,revision);`);
+            const oldUpdate = this.db.prepare("SELECT sql FROM sqlite_master WHERE type='trigger' AND name='search_index_mu'").get() as { sql: string } | undefined;
+            if (oldUpdate && !oldUpdate.sql.includes("OLD.ts IS NOT NEW.ts")) this.db.exec("DROP TRIGGER search_index_mu");
+            const present = new Set((this.db.prepare("SELECT name FROM sqlite_master WHERE type='trigger' AND name LIKE 'search_index_%'").all() as { name: string }[]).map(r => r.name));
+            const repaired = names.some(n => !present.has(n)) || !this.db.prepare("SELECT generation FROM search_index_meta WHERE id=1").get();
+            if (repaired) {
+                // A missing journal trigger can hide a mutation; invalidate the derived DB.
+                this.db.prepare("INSERT INTO search_index_meta VALUES(1,?) ON CONFLICT(id) DO UPDATE SET generation=excluded.generation").run(randomUUID());
+            }
+            this.db.exec(`
+CREATE TRIGGER IF NOT EXISTS search_index_mi AFTER INSERT ON messages BEGIN ${change("NEW.session_id", "NEW.seq")} END;
+CREATE TRIGGER IF NOT EXISTS search_index_md AFTER DELETE ON messages BEGIN ${change("OLD.session_id", "OLD.seq")} END;
+CREATE TRIGGER IF NOT EXISTS search_index_mu AFTER UPDATE OF session_id,seq,msg_id,role,kind,content_hash,retired_at,ts ON messages
+ WHEN OLD.session_id IS NOT NEW.session_id OR OLD.seq IS NOT NEW.seq OR OLD.msg_id IS NOT NEW.msg_id OR OLD.role IS NOT NEW.role OR OLD.kind IS NOT NEW.kind OR OLD.content_hash IS NOT NEW.content_hash OR OLD.retired_at IS NOT NEW.retired_at OR OLD.ts IS NOT NEW.ts BEGIN
+ ${change("OLD.session_id", "OLD.seq")} ${change("NEW.session_id", "NEW.seq")} END;
+CREATE TRIGGER IF NOT EXISTS search_index_cu AFTER UPDATE OF bytes ON content WHEN OLD.bytes IS NOT NEW.bytes BEGIN
+ INSERT INTO search_index_versions SELECT DISTINCT session_id,1 FROM messages WHERE content_hash=NEW.hash ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+ INSERT INTO search_index_dirty SELECT m.session_id,m.seq,v.revision FROM messages m JOIN search_index_versions v ON v.session_id=m.session_id WHERE m.content_hash=NEW.hash
+ ON CONFLICT(session_id,seq) DO UPDATE SET revision=excluded.revision;
+END;
+CREATE TRIGGER IF NOT EXISTS search_index_ci AFTER INSERT ON content BEGIN
+ INSERT INTO search_index_versions SELECT DISTINCT session_id,1 FROM messages WHERE content_hash=NEW.hash ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+ INSERT INTO search_index_dirty SELECT m.session_id,m.seq,v.revision FROM messages m JOIN search_index_versions v ON v.session_id=m.session_id WHERE m.content_hash=NEW.hash
+ ON CONFLICT(session_id,seq) DO UPDATE SET revision=excluded.revision;
+END;
+CREATE TRIGGER IF NOT EXISTS search_index_cd BEFORE DELETE ON content BEGIN
+ INSERT INTO search_index_versions SELECT DISTINCT session_id,1 FROM messages WHERE content_hash=OLD.hash ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+ INSERT INTO search_index_dirty SELECT m.session_id,m.seq,v.revision FROM messages m JOIN search_index_versions v ON v.session_id=m.session_id WHERE m.content_hash=OLD.hash
+ ON CONFLICT(session_id,seq) DO UPDATE SET revision=excluded.revision;
+END;`);
+        });
+        this.schema = Number((this.db.prepare("PRAGMA schema_version").get() as { schema_version: number }).schema_version);
+    }
+}
