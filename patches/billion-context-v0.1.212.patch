+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import os from "node:os";
+import { defaults } from "../src/semantic-settings.js";
+import { SemanticClient } from "../src/semantic/client.js";
+import { SearchIndexClient } from "../src/storage/search-index-client.js";
+import { renderIndexedEvidence, searchEvidenceIndexed } from "../src/search-evidence.js";
+import { createInitialState } from "acp-kernel";
+import type { SearchIndexResult } from "../src/storage/search-index-types.js";
+
+function result(id = "exact", text = "青枔设置 preserveRecentTokens=12000"): SearchIndexResult {
+    return { rows: [{ id, seq: 1, role: "user", contentType: "text", text, prepared: { text, evidence: "ev-" + id, offset: 0, totalChars: text.length } }],
+        matchIds: [id], neighbors: {}, corrections: {}, revision: 1, complete: true, mode: "fts", stats: { indexed: 1, loaded: 1, matched: 1, elapsedMs: 1 } };
+}
+function coverage(state: "ready" | "unavailable" = "ready") {
+    return { state, indexed: 1, pending: 0, failed: 0, model: "test", dimensions: 128, sourceRevision: 1, rejected: 0, elapsedMs: 1 };
+}
+
+test("actual search pipeline retains lexical original hits when semantic worker is unavailable", async () => {
+    const client = new SearchIndexClient(null), exact = result();
+    Reflect.set(client, "queryNow", async () => exact);
+    Reflect.set(client, "semantic", {
+        query: async () => ({ candidates: [], coverage: coverage("unavailable") }),
+        refine: async (_session: string, _query: string, value: SearchIndexResult) => value,
+        verify: async (_session: string, value: SearchIndexResult) => ({ ...value, rows: [], matchIds: [] }),
+        recordResult: () => {},
+        close: async () => {},
+    });
+    try {
+        const found = await client.query("chat", "青枔", 5, { searchMode: "hybrid" });
+        assert.ok(found?.matchIds.includes("exact"));
+        assert.match(found?.rows[0].prepared?.text ?? "", /12000/);
+    } finally { await client.close(); }
+});
+
+test("exact and original-read requests bypass the optional worker and all generation endpoints", async t => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-semantic-route-")), settings = path.join(dir, "settings.json");
+    fs.writeFileSync(settings, JSON.stringify({ ...defaults, enabled: true, relevanceEnabled: true }));
+    const client = new SemanticClient(null, settings);
+    let requests = 0;
+    Reflect.set(client, "request", async () => { requests++; throw Error("must never start for an exact read"); });
+    t.after(async () => { await client.close(); fs.rmSync(dir, { recursive: true, force: true }); });
+    assert.equal(await client.query("chat", "青枔", 5, { searchMode: "exact" }), undefined);
+    assert.equal(await client.query("chat", "open:ev-012345678901234567890123:0", 5, { searchMode: "reasoned" }), undefined);
+    assert.equal(requests, 0);
+});
+
+test("actual refine route preserves second-hop media locations, annotations, and generation request accounting", async t => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-semantic-route-")), settings = path.join(dir, "settings.json"), keyEnv = "BILI_TEST_ROUTE_KEY";
+    fs.writeFileSync(settings, JSON.stringify({ ...defaults, enabled: true, relevanceEnabled: true, keyEnv }));
+    const oldKey = process.env[keyEnv], originalFetch = globalThis.fetch;
+    process.env[keyEnv] = "synthetic-local-test-only";
+    const client = new SemanticClient(null, settings);
+    let reserves = 0, charges = 0;
+    Reflect.set(client, "request", async (message: { operation: string; ids?: { id: string }[]; tokens?: number }) => {
+        if (message.operation === "reserve") { reserves++; return { accepted: true }; }
+        if (message.operation === "usage") { charges += message.tokens ?? 0; return { accepted: true }; }
+        return { verified: (message.ids ?? []).map(item => item.id) };
+    });
+    globalThis.fetch = async (_url, init) => {
+        const body = JSON.parse(String(init?.body)), prompt = JSON.parse(body.contents[0].parts[0].text);
+        const row = prompt.untrustedEvidence.find((item: { id: string }) => item.id === (prompt.expanded ? "page" : "uncertain"));
+        const plan = { ranked: [{ id: row.id, version: row.version, sessionId: row.sessionId, relevance: prompt.expanded ? "relevant" : "uncertain", quotes: [row.text] }],
+            sufficient: prompt.expanded, probes: prompt.expanded ? [] : ["老画窗框"] };
+        return new Response(JSON.stringify({ candidates: [{ finishReason: "STOP", content: { parts: [{ text: JSON.stringify(plan) }] } }], usageMetadata: { promptTokenCount: 10, totalTokenCount: 20 } }));
+    };
+    t.after(async () => {
+        globalThis.fetch = originalFetch;
+        if (oldKey === undefined) delete process.env[keyEnv]; else process.env[keyEnv] = oldKey;
+        await client.close(); fs.rmSync(dir, { recursive: true, force: true });
+    });
+    const first = result("uncertain", "以前收藏过一些画。");
+    first.semantic = { mode: "reasoned", coverage: coverage(), exactIds: [], semanticIds: ["uncertain"], sources: [] };
+    const second = result("page", "窗框的细节在第二页。");
+    second.semantic = { mode: "hybrid", coverage: coverage(), exactIds: [], semanticIds: ["page"], sources: [{ id: "page", modality: "pdf",
+        refs: [{ sessionId: "chat", messageId: "page", sourceHash: "source-page-hash", start: 0, end: 12, casHash: "original", mediaHash: "page-media", page: 2 }] }] };
+    const refined = await client.refine("chat", "之前那张画窗框什么样", first, { searchMode: "reasoned" }, async () => second);
+    assert.equal(refined.matchIds[0], "page");
+    assert.ok(refined.semantic?.sources.some(source => source.id === "page" && source.refs.some(ref => ref.page === 2)));
+    assert.equal(reserves, 2); assert.equal(charges, 40);
+    assert.equal(refined.semantic?.relevance?.sufficient, true);
+    assert.equal(refined.semantic?.annotations?.page.relevance, "relevant");
+});
+
+test("render budget cannot erase an exact hit ranked behind expanded semantic candidates", () => {
+    const expanded = result();
+    expanded.rows = [...Array.from({ length: 10 }, (_, i) => result("s" + i, "一条有关茶的语义线索").rows[0]), ...expanded.rows];
+    expanded.matchIds = expanded.rows.map(row => row.id);
+    expanded.semantic = { mode: "reasoned", coverage: coverage(), exactIds: ["exact"], semanticIds: expanded.matchIds.filter(id => id !== "exact"), sources: [],
+        annotations: { s0: { relevance: "uncertain", quotes: ["一条有关茶的语义线索"] } } };
+    const rendered = renderIndexedEvidence({ id: "chat", state: createInitialState() }, "tea", 2, expanded);
+    assert.match(rendered, /preserveRecentTokens=12000/);
+    assert.match(rendered, /uncertain/);
+    assert.ok(rendered.split("  read: ").length - 1 <= 5, "preserving exact evidence still respects the total display budget");
+});
+
+test("production original-search adapter preserves fresh tool call identity in the resident overlay", async () => {
+    let inspected = false;
+    await searchEvidenceIndexed({ id: "chat", state: createInitialState() }, "tea", 1, [
+        { id: "call", role: "assistant", contentType: "tool-call", toolCallId: "same-call", toolName: "browser", text: "search tea" },
+        { id: "output", role: "tool", contentType: "tool-result", toolCallId: "same-call", toolName: "browser", text: "tea results" },
+    ], async (_session, _query, _limit, options) => {
+        inspected = true;
+        assert.deepEqual(options?.overlays?.map(row => Reflect.get(row, "toolCallId")), ["same-call", "same-call"]);
+        return result();
+    });
+    assert.equal(inspected, true);
