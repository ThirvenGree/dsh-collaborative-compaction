+    version(sessionId: string): { generation: string; revision: number; exists: boolean } {
+        if (!this.db) return { generation: "transient", revision: 0, exists: false };
+        const exists = !!this.db.prepare("SELECT 1 FROM sessions WHERE session_id=?").get(sessionId);
+        const generation = this.db.prepare("SELECT generation FROM search_index_meta WHERE id=1").get() as { generation: string } | undefined;
+        const version = this.db.prepare("SELECT revision FROM search_index_versions WHERE session_id=?").get(sessionId) as { revision: number } | undefined;
