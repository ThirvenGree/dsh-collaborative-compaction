diff --git a/src/collaborative-background.ts b/src/collaborative-background.ts
new file mode 100644
index 00000000..84e48619
--- /dev/null
+++ b/src/collaborative-background.ts
@@ -0,0 +1,161 @@
+import { isDeepStrictEqual } from "node:util";
+import type { CoreMessage, CompressionBlock, CompressibleRange } from "acp-kernel";
+import { type ParsedRange } from "./compress-tool.js";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+import { backgroundFoldCancellations, compressionDraft } from "./collaborative-transaction.js";
+import { applyConfiguredCompressionInner } from "./external-summary-compress.js";
+import { planHistory } from "./collaborative-planner.js";
+import { deferredCandidatesCovered } from "./preflight.js";
+import { epochConfirmPending } from "./fold-reconcile.js";
+import { markDirty, type Session } from "./session.js";
+import { applyRanges, type RewriteCtx } from "./stream.js";
+
+type Ticket = {
+    key: string;
+    finished?: boolean;
+    invalidated?: boolean;
+    publish?: (current: RewriteCtx) => void;
+};
+const tickets = new WeakMap<Session, Ticket>();
+const waits = new WeakMap<Session, { key: string; ranges: CompressibleRange[]; until: number }>();
+
+function completeToolBoundary(messages: CoreMessage[]) {
+    const pending = new Set<string>();
+    for (const message of messages) {
+        if (message.contentType === "tool-call") {
+            if (!message.toolCallId) return false;
+            pending.add(message.toolCallId);
+        } else if (message.contentType === "tool-result" && message.toolCallId) {
+            pending.delete(message.toolCallId);
+        }
+    }
+    return !pending.size;
+}
+
+function coverage(block: CompressionBlock) {
+    return [block.startRef, block.endRef, block.topic, block.summary, block.effectiveMessageIds, block.directMessageIds, block.directBlockIds];
+}
+
+// Replay only the exact approved batch. The live kernel recalculates protection,
+// tool pairs, counters, refs and overlaps rather than installing an old state.
+function publisher(before: Session, reviewed: Session, messages: CoreMessage[], ranges: ParsedRange[]) {
+    const anchors = new Set(ranges.map(range => range.compressCallId));
+    const selected = (session: Session) => session.state.blocks.filter(block => block.compressCallId && anchors.has(block.compressCallId));
+    const blocks = selected(reviewed);
+    if (blocks.length !== ranges.length) throw Error("Unreplayable reviewed block batch");
+    const ids = new Set(blocks.flatMap(block => block.effectiveMessageIds));
+    const originals = new Map([...before.lastMessages ?? [], ...messages].filter(m => ids.has(m.id)).map(m => [m.id, m]));
+    const sourceBlocks = before.state.blocks.filter(b => b.effectiveMessageIds.some(id => ids.has(id)));
+    const originalRefs = new Map([...ids].map(id=>[id,before.state.messageRefs.byRaw[id]]));
+    const sourceContents = new Map(sourceBlocks.map(block=>[block.blockId,before.blockContents.get(block.blockId)]));
+    const reviewedContents = new Map(blocks.map(block=>[block.blockId,reviewed.blockContents.get(block.blockId)]));
+    return (ctx: RewriteCtx) => {
+        const current = new Map([...ctx.session.lastMessages ?? [], ...ctx.messages].map(m => [m.id, m]));
+        for (const id of ids) {
+            if (originalRefs.get(id) !== ctx.session.state.messageRefs.byRaw[id] ||
+                !isDeepStrictEqual(originals.get(id), current.get(id))) throw Error("Covered message or reference changed");
+            if (!originals.has(id) && !sourceBlocks.some(b => b.effectiveMessageIds.includes(id) && sourceContents.get(b.blockId)?.full)) throw Error("Missing original");
+        }
+        const liveBlocks = ctx.session.state.blocks.filter(b => b.effectiveMessageIds.some(id => ids.has(id)));
+        if (liveBlocks.length !== sourceBlocks.length) throw Error("Overlapping compression changed");
+        for (const block of sourceBlocks) {
+            const live = liveBlocks.find(b => b.blockId === block.blockId);
+            if (!live || live.active !== block.active || live.restoredInline !== block.restoredInline ||
+                !isDeepStrictEqual(coverage(live), coverage(block)) ||
+                !isDeepStrictEqual(ctx.session.blockContents.get(block.blockId), sourceContents.get(block.blockId))) throw Error("Source block changed");
+        }
+        const txn = compressionDraft(ctx.session);
+        const applied = applyRanges({ ranges, diagnostics: {ok:true,kind:"ok",invalidItems:0} }, {...ctx, session: txn.draft});
+        const added = selected(txn.draft);
+        if (applied.outcome !== "applied" || !isDeepStrictEqual(added.map(coverage), blocks.map(coverage))) throw Error("Current range or protection changed");
+        for (let i = 0; i < blocks.length; i++) {
+            const content = reviewedContents.get(blocks[i].blockId);
+            if (!content?.full || content.full.count !== new Set(blocks[i].effectiveMessageIds).size) throw Error("Missing reviewed originals");
+            txn.draft.blockContents.set(added[i].blockId, content);
+        }
+        txn.commit();
+    };
+}
+
+// Called at the request boundary, inside the existing session lock. A published
+// batch is re-prepared by the caller; no network operation runs inside its commit.
+export function takeBackgroundFold(ctx: RewriteCtx, key: string): boolean {
+    const job = tickets.get(ctx.session);
+    if (!job) return false;
+    if (job.key !== key) {
+        job.invalidated = true;
+        void backgroundFoldCancellations.get(ctx.session)?.();
+        return false;
+    }
+    if (!job.finished || job.invalidated) return false;
+    if (!completeToolBoundary(ctx.messages)) return false;
+    tickets.delete(ctx.session);
+    backgroundFoldCancellations.delete(ctx.session);
+    if (!job.publish || epochConfirmPending(ctx.session)) return false;
