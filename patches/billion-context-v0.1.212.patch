+            }
+            const candidates = this.fts ? `AND d.rowid IN (${candidateQueries.join(" UNION ")})` : "";
+            const score = terms.map(() => "CASE WHEN instr(d.body,?)>0 THEN 1 ELSE 0 END").join("+") + "+CASE WHEN instr(d.body,?)>0 THEN ? ELSE 0 END";
+            const sql = `SELECT d.rowid,(${score}) AS score FROM docs d WHERE ${constraints} ${candidates} AND (${terms.map(() => "instr(d.body,?)>0").join(" OR ")}) ORDER BY score DESC,d.seq DESC LIMIT ?`;
+            const chosen = this.index.prepare(sql).all(...terms, text, terms.length, sessionId, ...params, ...terms, limit) as { rowid: number }[];
+            selected = chosen.map(row => this.index.prepare("SELECT * FROM docs WHERE rowid=?").get(row.rowid) as unknown as Doc);
+        }
+        const candidates = selected.map(doc => ({ row: JSON.parse(doc.data) as SearchIndexRow, body: doc.body, evidence: doc.evidence }));
+        for (const row of [...overlays.values(), ...summaries.values()]) {
+            if (allowed && !allowed.has(row.id) && row.role !== "summary") continue;
+            const prepared = prepareSearchText(sessionId, row.id, row.text ?? "", row.attachment ?? "");
+            if (read ? prepared.evidence === read[1] : terms.some(t => prepared.lower.includes(t))) candidates.push({ row, body: prepared.lower, evidence: prepared.evidence });
+        }
+        const hits = candidates.sort((a, b) => (read ? 0 : scoreOf(b.body) - scoreOf(a.body)) || b.row.seq - a.row.seq).slice(0, limit);
+        matched = candidates.length;
+        const rows = new Map<string, SearchIndexRow>();
+        const add = (row?: SearchIndexRow | null) => { if (row) rows.set(row.id, overlays.get(row.id) ?? row); };
+        for (const hit of hits) add(hit.row);
+        const get = (id: string) => cached!.invalid.has(id) || (excluded.has(id) && !overlays.has(id)) ? null : overlays.get(id) ?? (() => { const doc = this.index.prepare("SELECT data FROM docs WHERE session_id=? AND msg_id=? ORDER BY seq DESC LIMIT 1").get(sessionId, id) as { data: string } | undefined; return doc ? JSON.parse(doc.data) as SearchIndexRow : null; })();
+        const neighbors: SearchIndexResult["neighbors"] = {}, corrections: SearchIndexResult["corrections"] = {};
+        const contextIds = new Set([...hits.filter(h => h.row.role !== "summary").map(h => h.row.id), ...(options.contextIds ?? [])]);
+        for (const id of contextIds) {
+            const row = get(id); if (!row) continue; add(row);
+            const relation: { previous?: string; next?: string } = {};
+            for (const direction of ["previous", "next"] as const) {
+                const operator = direction === "previous" ? "<" : ">", order = direction === "previous" ? "DESC" : "ASC";
+                const doc = this.index.prepare(`SELECT d.data FROM docs d WHERE d.session_id=? AND d.seq${operator}?
+ AND NOT EXISTS(SELECT 1 FROM query_excluded e WHERE e.id=d.msg_id)
+ AND NOT EXISTS(SELECT 1 FROM docs newer INDEXED BY docs_id_seq WHERE newer.session_id=d.session_id AND newer.msg_id=d.msg_id AND newer.seq>d.seq)
