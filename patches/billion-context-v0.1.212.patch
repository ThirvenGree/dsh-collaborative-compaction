+    const root = path.join(directory, "allowed"), outside = path.join(directory, "private");mkdirSync(root);mkdirSync(outside);
+    const file = path.join(root, "page.pdf");writeFileSync(file, "v1");
+    const media = extractMedia({ attachment: { path: file, mimeType: "application/pdf" } })[0]!;
