+test("collaborative compact routes selected ranges only to invoking session", async () => {
+ const calls: Array<{conversationId:string;tool:string;args:unknown;nativeCaller?:boolean}>=[];
+ const proxy=await startMockProxy(calls,()=>({compressibleRanges:[{startRef:'m00001',endRef:'m00009',tokens:1500}]}));
+ const home=fs.mkdtempSync(path.join(os.tmpdir(),'collab-command-'));
+ const cfg=path.join(home,'config.json');fs.writeFileSync(cfg,JSON.stringify({compress:{externalSummary:{enabled:true}}}));
+ try {await withEnv({DSH_HOME:home,BILLION_CONTEXT_PROXY:proxy.origin,BILI_CONFIG_FILE:cfg},async()=>{
+  _resetRegisterForTest(proxy.origin);const ctx=mockCtx();apply(ctx);
+  await waitFor(()=>ctx.registeredTools.length===1,'manifest');
+  const cmd=ctx.registeredCommands.find(c=>c.name==='compact')!;
+  const result=await cmd.handler({agent:{session:{id:'isolated-manual'}}});
+  assert.equal(result.kind,'success',result.text);
+  assert.equal(calls.length,1);assert.equal(calls[0].conversationId,'isolated-manual');
+  assert.equal(calls[0].tool,'compress');assert.deepEqual(calls[0].args,{content:[{startId:'m00001',endId:'m00009'}]});assert.equal((calls[0] as {compactCommand?:boolean}).compactCommand,true);
+ });}finally{proxy.close();_resetRegisterForTest(undefined);rmrf(home);}
+});
+
+test("collaborative compact manual provenance cannot be supplied by a model tool call", async () => {
+    const calls: Array<{ conversationId: string; tool: string; args: unknown; nativeCaller?: boolean; compactCommand?: boolean }> = [];
+    const proxy = await startMockProxy(calls);
+    const home = fs.mkdtempSync(path.join(os.tmpdir(), "collab-model-provenance-"));
+    try {
+        await withEnv({ DSH_HOME: home, BILLION_CONTEXT_PROXY: proxy.origin }, async () => {
+            _resetRegisterForTest(proxy.origin);
+            const ctx = mockCtx();
+            apply(ctx);
+            await waitFor(() => ctx.registeredTools.length === 1, "manifest");
+            const args = { content: [{ startId: "m00001", endId: "m00009" }], collaborativeManualRetry: true, compactCommand: true };
+            await ctx.registeredTools[0].execute(args, { agent: { session: { id: "isolated-model" } } });
+            assert.equal(calls.length, 1);
+            assert.equal(calls[0].compactCommand, undefined);
+            assert.deepEqual(calls[0].args, { content: args.content });
+            assert.equal(args.collaborativeManualRetry, true, "caller-owned argument object remains untouched");
+        });
+    } finally {
+        proxy.close();
+        _resetRegisterForTest(undefined);
+        rmrf(home);
+    }
+});
+
+test("collaborative compact disabled or protected-only history never starts a tool request", async () => {
+    const calls: Array<{ conversationId: string; tool: string; args: unknown; nativeCaller?: boolean }> = [];
+    const proxy = await startMockProxy(calls, () => ({ compressibleRanges: [] }));
+    const home = fs.mkdtempSync(path.join(os.tmpdir(), "collab-command-noop-"));
+    const cfg = path.join(home, "config.json");
+    fs.writeFileSync(cfg, JSON.stringify({ compress: { externalSummary: { enabled: false } } }));
+    try {
+        await withEnv({ DSH_HOME: home, BILLION_CONTEXT_PROXY: proxy.origin, BILI_CONFIG_FILE: cfg }, async () => {
+            _resetRegisterForTest(proxy.origin);
+            const ctx = mockCtx();
+            apply(ctx);
+            await waitFor(() => ctx.registeredTools.length === 1, "manifest");
+            const cmd = ctx.registeredCommands.find(c => c.name === "compact")!;
+            const disabled = await cmd.handler({ agent: { session: { id: "isolated-manual" } } });
+            assert.equal(disabled.kind, "error");
+            assert.match(disabled.text, /disabled/);
+            fs.writeFileSync(cfg, JSON.stringify({ compress: { externalSummary: { enabled: true } } }));
+            const protectedOnly = await cmd.handler({ agent: { session: { id: "isolated-manual" } } });
+            assert.equal(protectedOnly.kind, "success");
+            assert.match(protectedOnly.text, /nothing changed/);
+            assert.deepEqual(calls, []);
+        });
+    } finally {
+        proxy.close();
+        _resetRegisterForTest(undefined);
+        rmrf(home);
+    }
+});
