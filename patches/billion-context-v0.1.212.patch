+test("full resident histories transfer only changed bodies while new messages and in-place edits stay authoritative", async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-resident-search-"));
+    const file = path.join(dir, "source.sqlite"), owner = UnifiedStore.open(file), client = new SearchIndexClient(file);
+    const db = (owner as unknown as { db: SqliteDatabase }).db;
+    new SearchIndexJournal(db).ensure();
+    const s = session("isolated-full-resident");
+    s.lastMessages = Array.from({ length: 600 }, (_, i) => message("r" + i, `记录${i}：` + "普通历史内容。".repeat(50)));
+    s.lastMessages[10]!.text = "岑舒原来的参数 preserveRecentTokens=64000";
+    s.lastMessages[20]!.text = "青枔提过温热的茶";
+    try {
+        const content = db.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES(?,?,?)");
+        const msg = db.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES(?,?,?,?,?,?)");
+        db.exec("BEGIN");
+        for (const [i, row] of s.lastMessages.entries()) {
+            const bytes = Buffer.from(JSON.stringify(row)), hash = "fixture-" + i;
+            content.run(hash, bytes.length, bytes); msg.run(s.id, i, row.id, row.role, row.contentType, hash);
+        }
+        db.exec("COMMIT");
+        const query: EvidenceIndexQuery = (...args) => client.query(...args);
+        const search = (q: string) => executeSearchContextTargetAsync({ query: q }, createCore(), s.id, s.state,
+            { session: s, config: defaultConfig(200000), messages: [], log() {}, searchIndex: query });
+        assert.match((await search("岑舒")).text, /preserveRecentTokens=64000/);
+        const first = client.diagnostics();
+        assert.equal(first.overlayRows, 600);
+        // Wire adapters may recreate each field object even when bodies did not
+        // change; object identity alone cannot make transport incremental.
+        s.lastMessages = s.lastMessages.map(row => ({ ...row }));
+        assert.match((await search("青枔")).text, /温热的茶/);
+        assert.equal(client.diagnostics().overlayRows, first.overlayRows);
+        assert.equal(client.diagnostics().overlayChars, first.overlayChars);
+        s.lastMessages[10]!.text = "岑舒更正参数 preserveRecentTokens=12000";
+        s.lastMessages.push(message("new", "青枔刚发送的 unique-latest-message"));
+        assert.match((await search("unique-latest-message")).text, /青枔刚发送/);
+        assert.equal(client.diagnostics().overlayRows, first.overlayRows + 2);
+        assert.doesNotMatch((await search("preserveRecentTokens=64000")).text, /indexed keyword search/);
+        assert.match((await search("preserveRecentTokens=12000")).text, /岑舒更正参数/);
