+import test from "node:test";
+import assert from "node:assert/strict";
+import { createCore, createInitialState, defaultConfig, type CoreMessage } from "acp-kernel";
+import {executeSearchContextTarget} from "../src/decompress-shared.js";
+import type {Session} from "../src/session.js";
+
+const msg=(id:string,text:string,role:CoreMessage["role"]="user"):CoreMessage=>({id,text,role,contentType:"text"});
+function fixture(){
+ const state=createInitialState();
+ const session={id:"search-fixture-local",state,metadata:{},stats:{},blockContents:new Map(),lastMessages:[
+  {...msg("old","draft setting "+"x ".repeat(1300)+"needle_one 4011"),source:{kind:"user"},timestamp:"2026-11-03T10:00:00Z"},
+  {...msg("attach","[image]","tool"),attachment:{description:"bluepaper attachment description"}},
+  {...msg("revised","Actually disabled."),corrects:"old"},
+  {...msg("internal","【内部提醒】task-complete"),source:{kind:"plugin:agency"}},
+  {...msg("thinking","PRIVATE_INFERENCE","assistant"),contentType:"reasoning"},
+  msg("preface","PRIVATE_SYSTEM","system"),msg("secrets","sensitive token=abcdef__123456789"),
+ ]} as unknown as Session;
+ state.messageRefs.byRaw["old"]="m00001";
+ const ctx={session,config:defaultConfig(200000),messages:session.lastMessages!,log:()=>{}};
+ return {session,run:(query:string)=>executeSearchContextTarget({query,limit:2},createCore(),session.id,state,ctx).text};
+}
+test("current session searches original terms, attachment descriptions, contextual neighbors and attributed corrections",()=>{
+ const {run}=fixture();const hit=run("needle_one");assert.match(hit,/old m00001 role=user source=user time=2026/);assert.match(hit,/explicitly corrected by revised/);assert.match(hit,/next: attach/);
+ const target=hit.match(/read: (open:ev-[a-f0-9]+:\d+)/)![1]!;assert.match(run(target),/needle_one 4011/);assert.doesNotMatch(hit,/acp_retrieve/);
+ assert.match(run("bluepaper"),/\[attachment\] bluepaper/);assert.match(run("task-complete"),/source=plugin:agency/);
+ assert.doesNotMatch(run("PRIVATE_"),/role=(system|assistant)|private_system|private_inference/i);
+ assert.match(run("sensitive"),/<masked/);assert.doesNotMatch(run("sensitive"),/abcdef__123456789/);
+});
+test("read handles cannot cross sessions or silently read a changed original",()=>{
+ const {run,session}=fixture(),target=run("needle_one").match(/read: (open:ev-[a-f0-9]+:\d+)/)![1]!;
+ session.id="other";assert.match(run(target),/unavailable or changed/);session.id="search-fixture-local";
+ session.lastMessages![0]!.text="new version";assert.match(run(target),/unavailable or changed/);
+});
