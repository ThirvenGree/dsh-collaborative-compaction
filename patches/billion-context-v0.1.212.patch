+++ b/tests/search-index-integration.test.ts
@@ -0,0 +1,274 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { buildStoredPlaceholder, createCore, createInitialState, defaultConfig, type CoreMessage, type MessageContentStore } from "acp-kernel";
+import { executeSearchContextTargetAsync } from "../src/decompress-shared.js";
+import { renderIndexedEvidence, searchEvidenceIndexed, type EvidenceIndexQuery } from "../src/search-evidence.js";
+import { prepareSearchText } from "../src/search-text.js";
+import type { SearchIndexOptions, SearchIndexResult } from "../src/storage/search-index-types.js";
+import { getSession, type Session } from "../src/session.js";
+import { SessionStore, _setStoreForTest } from "../src/persist.js";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { SearchIndexClient } from "../src/storage/search-index-client.js";
+import { UnifiedStore } from "../src/storage/store.js";
+import type { SqliteDatabase } from "../src/storage/driver.js";
+import { SearchIndexJournal } from "../src/storage/search-index-journal.js";
+import type { Worker } from "node:worker_threads";
+
+_setStoreForTest(new SessionStore({ enabled: false }));
+
+const message = (id: string, text: string, role: CoreMessage["role"] = "user"): CoreMessage => ({ id, text, role, contentType: "text" });
+function session(id = "isolated-search-integration"): Session {
+    return { id, state: createInitialState(), metadata: {}, stats: {}, blockContents: new Map(), lastMessages: [] } as unknown as Session;
+}
+function result(rows: SearchIndexResult["rows"] = [], matchIds: string[] = rows.map(r => r.id)): SearchIndexResult {
+    return { rows, matchIds, neighbors: {}, corrections: {}, revision: 1, complete: true, mode: "fts", stats: { indexed: rows.length, loaded: rows.length, matched: matchIds.length, elapsedMs: 1 } };
+}
+
+test("production async search sends authoritative fresh overlays and keeps text containing a box emoji", async () => {
+    const s = session();
+    s.lastMessages = [message("changed", "old words"), message("erase", "old body"), message("box", "📦 岑舒刚收到一箱书")];
+    const current = [message("changed", "青枔刚改成 preserveRecentTokens=12000"), message("erase", ""), { ...message("private", "private"), contentType: "reasoning" } as CoreMessage];
+    let input: SearchIndexOptions | undefined;
+    const query: EvidenceIndexQuery = async (_sid, q, _limit, opts) => {
+        input = opts;
+        const rows = (opts?.overlays ?? []).filter(r => r.contentType !== "reasoning" && r.text?.includes(q)).map((r, seq) => ({ ...r, seq }));
+        return result(rows);
+    };
+    const out = await executeSearchContextTargetAsync({ query: "青枔" }, createCore(), s.id, s.state,
+        { session: s, config: defaultConfig(200000), messages: current, log() {}, searchIndex: query });
+    assert.match(out.text, /青枔刚改成 preserveRecentTokens=12000/);
+    assert.equal(input?.overlays?.find(r => r.id === "changed")?.text, current[0]!.text);
+    assert.equal(input?.overlays?.find(r => r.id === "erase")?.text, "", "empty edits remove the old searchable body");
+    assert.ok(input?.excludeIds?.includes("private"), "a new private role cannot resurrect an older searchable copy");
+    assert.ok(input?.overlays?.some(r => r.id === "box"));
+});
+
+test("fresh current text wins over stale CCR; only canonical placeholders expand from CCR", async () => {
+    const s = session();
+    s.state.messageRefs.byRaw["a"] = "m00001";
+    const ccr = { version: 1, byRef: { m00001: { rawId: "a", hash: "h" } }, byHash: { h: "stale CCR original" } } as unknown as MessageContentStore;
+    let input: SearchIndexOptions | undefined;
+    const query: EvidenceIndexQuery = async (_sid, _q, _limit, opts) => { input = opts; return result(); };
+    await searchEvidenceIndexed(s, "fresh", 2, [message("a", "fresh latest edit")], query, ccr);
+    assert.equal(input?.overlays?.[0]?.text, "fresh latest edit");
+    const placeholder = buildStoredPlaceholder({ ref: "m00001", kind: "tool", tokens: 4000, retrieveToolName: "acp_retrieve", head: "preview" });
+    await searchEvidenceIndexed(s, "original", 2, [message("a", placeholder, "tool")], query, ccr);
+    assert.equal(input?.overlays?.[0]?.text, "stale CCR original");
+    await searchEvidenceIndexed(s, "original", 2, [message("a", placeholder, "tool")], query);
+    assert.deepEqual(input?.excludeIds, [], "a carrier without resident original must not hide stored evidence");
+});
+
+test("sparse candidates render true neighbors and corrections, never candidate adjacency", () => {
+    const s = session();
+    const data = result([
+        { ...message("old", "岑舒 target"), seq: 1 }, { ...message("far", "岑舒 another target"), seq: 200 },
+        { ...message("neighbor", "real next message"), seq: 2 },
+        { ...message("correction", "Actually use 12000"), seq: 300, corrects: "old" },
+    ], ["old", "far"]);
+    data.neighbors.old = { next: "neighbor" };
+    data.corrections.old = ["correction"];
+    const text = renderIndexedEvidence(s, "岑舒", 2, data);
+    assert.match(text, /next: neighbor/);
+    assert.doesNotMatch(text, /next: far|previous: old/);
+    assert.match(text, /explicitly corrected by correction/);
+    const key = prepareSearchText(s.id, "old", "岑舒 target").evidence;
+    assert.match(renderIndexedEvidence(s, "open:" + key, 2, data), /岑舒 target/);
+    assert.match(renderIndexedEvidence(session("other"), "open:" + key, 2, data), /unavailable or changed/);
+});
+
+test("worker excerpts preserve full-body handles and page offsets without rehashing the truncated row", () => {
+    const s = session(), full = "历史".repeat(3000) + "岑舒 and autoFoldTargetTokens=80000";
+    const prepared = prepareSearchText(s.id, "large", full);
+    const offset = 5800;
+    const data = result([{ ...message("large", full.slice(0, 200)), seq: 1,
+        prepared: { text: full.slice(offset, offset + 1600), evidence: prepared.evidence, offset, totalChars: full.length, matchAt: 6000 } }]);
+    const hit = renderIndexedEvidence(s, "岑舒", 1, data);
+    assert.match(hit, new RegExp(`read: open:${prepared.evidence}:${offset}`));
+    assert.match(hit, /岑舒 and autoFoldTargetTokens=80000/);
+    assert.match(renderIndexedEvidence(s, `open:${prepared.evidence}:${offset}`, 1, data), /岑舒 and autoFoldTargetTokens=80000/);
+    assert.match(renderIndexedEvidence(s, `open:${prepared.evidence}:1600`, 1, data), /page changed/);
+});
+
+test("complete indexed coverage never hydrates lazy original block archives", async () => {
+    const s = session();
+    s.state.blocks = [{ blockId: "b1", active: true, tier: 1, effectiveMessageIds: ["old"], topic: "topic", summary: "summary" }] as Session["state"]["blocks"];
+    s.blockContents = { get() { throw new Error("legacy archive must stay lazy"); } } as unknown as Session["blockContents"];
+    let calls = 0;
+    const query: EvidenceIndexQuery = async (_sid, _q, _limit, opts) => {
+        calls++;
+        assert.deepEqual(opts?.archiveCoverage, [{ block: "b1", ids: ["old"] }]);
+        assert.equal(opts?.archives, undefined);
+        return { ...result(), missingArchiveBlocks: [] };
+    };
+    await searchEvidenceIndexed(s, "none", 2, [], query);
+    assert.equal(calls, 1);
+});
+
+test("async inherited search preserves upstream folded-away summary coverage", async () => {
+    const parent = getSession("indexed-inherited-parent");
+    parent.state.blocks = [{ blockId: "folded-parent", active: false, tier: 1, effectiveMessageIds: ["old"], topic: "岑舒旧方案", summary: "autoFoldTargetTokens=80000" }] as Session["state"]["blocks"];
+    const child = getSession("indexed-inherited-child");
+    child.metadata.derivedFromSessionId = parent.id;
+    const out = await executeSearchContextTargetAsync({ query: "autoFoldTargetTokens" }, createCore(), child.id, child.state,
+        { session: child, config: defaultConfig(200000), messages: [], log() {}, searchIndex: async () => result() });
+    assert.match(out.text, /folded-parent/);
+    assert.match(out.text, /autoFoldTargetTokens】=80000/);
+    assert.match(out.text, /in session indexed-inherited-parent/);
+    assert.equal(parent.state.blocks[0]!.active, false, "inherited search never reactivates the parent block");
+});
+
+test("resident newly sent messages preserve the upstream native timestamp in the index overlay", async () => {
+    const s = session();
+    const fresh = { ...message("fresh-native-time", "青枔刚发参数 target=80000"), ts: 1793788800000 };
+    const query: EvidenceIndexQuery = async (_sid, _q, _limit, opts) => {
+        assert.equal(opts?.overlays?.find(row => row.id === fresh.id)?.timestamp, fresh.ts);
+        return result();
+    };
+    await searchEvidenceIndexed(s, "青枔", 3, [fresh], query);
+});
+
+test("only legacy blocks explicitly missing typed records are expanded for worker search", async () => {
+    const s = session();
+    s.state.blocks = ["b1", "b2"].map(blockId => ({ blockId, active: true, tier: 1, effectiveMessageIds: [blockId + "-old"] })) as Session["state"]["blocks"];
+    const reads: string[] = [];
