+import { once } from "node:events";
+import { randomUUID } from "node:crypto";
+import { defaults } from "../src/semantic-settings.js";
+
+const dist = path.resolve(import.meta.dirname, "../dist/index.js");
+const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+
+test("built search_context starts packaged semantic worker, applies controls, and retains FTS originals without a paid key", { skip: !fs.existsSync(dist), timeout: 60000 }, async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "bili-semantic-dist-"));
+    const upstream = http.createServer((req, res) => {
+        req.resume(); req.on("end", () => { res.setHeader("content-type", "application/json"); res.end(JSON.stringify({
+            id: "synthetic-semantic-dist", object: "chat.completion", choices: [{ index: 0, message: { role: "assistant", content: "ready" }, finish_reason: "stop" }],
+            usage: { prompt_tokens: 200, completion_tokens: 1, total_tokens: 201 },
+        })); });
+    });
+    upstream.listen(0, "127.0.0.1"); await once(upstream, "listening");
+    const upstreamPort = (upstream.address() as net.AddressInfo).port;
+    const reservation = net.createServer(); reservation.listen(0, "127.0.0.1"); await once(reservation, "listening");
+    const port = (reservation.address() as net.AddressInfo).port;
+    await new Promise<void>(resolve => reservation.close(() => resolve()));
+    const config = path.join(dir, "config.json"), semantic = path.join(dir, "semantic-search.json");
+    // Random environment name cannot resolve a real local API credential. No external endpoint is called.
+    const keyEnv = "BILI_TEST_NO_KEY_" + randomUUID().replaceAll("-", "");
+    fs.writeFileSync(semantic, JSON.stringify({ ...defaults, enabled: true, relevanceEnabled: false, mediaEnabled: false, keyEnv, queryTimeoutMs: 1000 }));
+    fs.writeFileSync(config, JSON.stringify({ port, host: "127.0.0.1", upstream: `http://127.0.0.1:${upstreamPort}`,
+        modelContextLimit: 400000, providers: { [`http://127.0.0.1:${upstreamPort}`]: { models: { "semantic-dist-test": { context: 400000 } } } },
+        autoUpdate: false, advisoryCheck: false, releaseNotesCheck: false, autoRestartOnUpdate: false,
+        persist: { enabled: true, debounceMs: 0 }, storage: { unified: "full" },
+        compress: { injectTool: true, injectNudge: false, autoFold: false }, mitm: { enabled: false, domains: [] },
+    }));
+    const env: NodeJS.ProcessEnv = { ...process.env, NODE_ENV: "test", BILI_CONFIG_FILE: config, BILI_SEMANTIC_CONFIG_FILE: semantic,
+        BILI_SESSIONS_DIR: path.join(dir, "sessions"), BILI_PERSIST: "1", BILI_PERSIST_DEBOUNCE_MS: "0", BILI_STORAGE_UNIFIED: "full", BILI_ADVISORY_CHECK: "0",
+        XDG_CONFIG_HOME: path.join(dir, "config"), XDG_DATA_HOME: path.join(dir, "data"), XDG_CACHE_HOME: path.join(dir, "cache"), XDG_STATE_HOME: path.join(dir, "state"),
+        NO_PROXY: "127.0.0.1,localhost", no_proxy: "127.0.0.1,localhost" };
+    delete env.ACP_PORT; delete env.ACP_UPSTREAM; delete env.BILI_UPSTREAM_PROXY; delete env[keyEnv];
+    const child = spawn(process.execPath, [dist, "start", "--config", config], { cwd: dir, env, stdio: ["ignore", "pipe", "pipe"], windowsHide: true });
+    let output = "";
+    child.stdout.on("data", chunk => { output += String(chunk); }); child.stderr.on("data", chunk => { output += String(chunk); });
+    const logFile = path.join(dir, "state", "billion-context", "bili.log"), semanticDir = path.join(dir, "semantic-search");
+    const statuses = () => fs.existsSync(semanticDir) ? fs.readdirSync(semanticDir).filter(name => name.endsWith(".status.json")).flatMap(name => {
+        try { return [JSON.parse(fs.readFileSync(path.join(semanticDir, name), "utf8")) as { running: boolean; paused: boolean; selectedSessions: number; requestsToday: number; updatedAt: number }]; } catch { return []; }
+    }) : [];
+    try {
+        let origin: string | undefined;
+        for (let i = 0; i < 300 && child.exitCode === null; i++) {
+            const ready = (output + (fs.existsSync(logFile) ? fs.readFileSync(logFile, "utf8") : "")).match(/listening on (http:\/\/127\.0\.0\.1:\d+)/);
+            if (ready) try {
+                const response = await fetch(ready[1] + "/__bili/health", { signal: AbortSignal.timeout(500) });
+                const health = await response.json() as { pid?: number };
+                if (response.ok && health.pid === child.pid) { origin = ready[1]; break; }
+            } catch { /* wait for this exact process */ }
+            await delay(50);
+        }
+        assert.ok(origin, "isolated built CLI did not start: " + output.slice(-1000));
+        const conversationId = "isolated-semantic-built-search";
+        const response = await fetch(`${origin}/bili/http://127.0.0.1:${upstreamPort}/v1/chat/completions`, {
+            method: "POST", headers: { "content-type": "application/json", "x-bili-plugin": "test-agent", "x-bili-plugin-conversation": conversationId, "x-acp-session": conversationId },
+            body: JSON.stringify({ model: "semantic-dist-test", max_tokens: 64000, messages: [
+                { role: "user", content: "岑舒喜欢温热的茶。参数 preserveRecentTokens=12000。" },
+                { role: "assistant", content: "记住了。" }, { role: "user", content: "青枔刚发送：semantic-dist-new-message。" },
+            ] }), signal: AbortSignal.timeout(20000),
+        });
+        assert.equal(response.status, 200, await response.text());
+        const search = async (query: string, mode = "hybrid") => {
+            const res = await fetch(`${origin}/__bili/plugin/tool`, { method: "POST", headers: { "content-type": "application/json" },
+                body: JSON.stringify({ conversationId, tool: "search_context", args: { query, mode } }), signal: AbortSignal.timeout(20000) });
+            const body = await res.json() as { ok?: boolean; result?: string; error?: string };
+            assert.equal(res.status, 200, JSON.stringify(body)); assert.equal(body.ok, true, JSON.stringify(body)); return body.result ?? "";
+        };
+        for (const query of ["岑舒", "青枔", "preserveRecentTokens=12000", "semantic-dist-new-message"]) assert.ok((await search(query)).includes(query));
+        assert.ok(statuses().some(status => status.running && status.selectedSessions > 0), "packaged semantic worker must really start and observe the synthetic session");
+        const controlAt = Date.now();
+        fs.writeFileSync(path.join(semanticDir, "all.control.json"), JSON.stringify({ id: randomUUID(), action: "pause", at: controlAt }));
+        // The idle worker publishes its status every 5 s, independently of its
+        // 500 ms control tick. Allow that publication cadence plus CI scheduling,
+        // without another search that would itself force a status refresh.
+        const controlDeadline = controlAt + 15000;
+        while (Date.now() < controlDeadline && child.exitCode === null
+            && !statuses().some(status => status.paused && status.updatedAt >= controlAt)) await delay(100);
+        const controlStatuses = statuses();
+        assert.ok(controlStatuses.some(status => status.paused && status.updatedAt >= controlAt),
+            "background worker must publish the persisted control: " + JSON.stringify({ controlAt, statuses: controlStatuses, exitCode: child.exitCode, output: output.slice(-1000) }));
+        assert.ok((await search("青枔")).includes("青枔"), "pausing semantic retrieval must retain exact search");
+        const exact = await search("preserveRecentTokens=12000", "exact"); assert.match(exact, /indexed keyword search/);
+        assert.ok(statuses().every(status => status.requestsToday === 0), "missing test key must prevent all paid requests");
+        assert.doesNotMatch(output + fs.readFileSync(logFile, "utf8"), /Packaged (?:semantic|history search) worker is missing|worker stopped before completing|worker-error/);
+    } finally {
+        if (child.exitCode === null) {
+            child.kill(); await Promise.race([once(child, "exit"), delay(5000)]);
+            if (child.exitCode === null && child.signalCode === null) { child.kill("SIGKILL"); await once(child, "exit"); }
+        }
+        upstream.closeAllConnections(); await new Promise<void>(resolve => upstream.close(() => resolve()));
+        const target = path.resolve(dir); assert.ok(target.startsWith(path.resolve(os.tmpdir()) + path.sep) && path.basename(target).startsWith("bili-semantic-dist-"));
+        fs.rmSync(target, { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });
+    }
+});
