+        const offset = Number(read[2] || 0);
+        const total = n.totalChars ?? n.text.length;
+        if (offset >= total) return "[Original evidence page is beyond the end.]";
+        if (n.offset !== undefined && n.offset !== offset) return "[Original evidence page changed during search; repeat the keyword search.]";
+        const body = safePrefix(n.offset === undefined ? n.text.slice(offset) : n.text, pageSize);
+        observe?.(n.key, body);
+        return `[Evidence: ${foreignSessionId ? "session=" + JSON.stringify(foreignSessionId) + " | " : ""}${cite(n)} | ${offset}–${offset + body.length}/${total}]\n${body}` + (offset + body.length < total ? `\n[next query: ${readHint(`open:${n.evidence}:${offset + body.length}`)}]` : "");
+    }
+    const text = (/^block:b\d+\s+(.+)$/is.exec(query)?.[1] ?? query).trim().toLowerCase();
+    const terms = [...new Set(text.split(/\s+/))];
+    const displayLimit = result.semantic ? Math.min(12, limit + 3) : limit;
+    const displayIds = new Set((result.semantic?.exactIds ?? []).filter(id => result.matchIds.includes(id)));
+    for (const id of result.matchIds) if (displayIds.size < displayLimit) displayIds.add(id);
+    const lines = result.matchIds.filter(id => displayIds.has(id)).flatMap(id => {
+        const n = notes.get(id);
+        if (!n) return [];
+        const indexes = terms.map(t => n.lower.indexOf(t)).filter(i => i >= 0);
+        if (n.offset === undefined && !indexes.length) return [];
+        const start = n.offset ?? Math.max(0, indexes[0]! - 90);
+        const snippet = n.offset === undefined ? n.text.slice(start) : n.text;
+        observe?.(id, safePrefix(snippet, 270));
+        const nearby = Object.entries(result.neighbors[id] ?? {}).flatMap(([direction, neighborId]) => {
+            const neighbor = neighborId ? notes.get(neighborId) : undefined;
+            if (!neighbor) return [];
+            observe?.(neighbor.key, safePrefix(neighbor.head ?? neighbor.text, 125));
+            return [`  ${direction}: ${cite(neighbor)} — ${safePrefix(neighbor.head ?? neighbor.text, 125)}`];
+        });
+        const correctedBy = (result.corrections[id] ?? []).flatMap(key => notes.get(key) ? [notes.get(key)!] : []);
+        const semanticRefs = result.semantic?.sources.filter(source => source.id === id) ?? [];
+        const relevance = result.semantic?.annotations?.[id];
+        const manifests = semanticRefs.flatMap(source => source.refs.filter(ref => ref.casHash).map(ref =>
+            `  verified ${source.modality} source: message=${clean(ref.messageId)} part=${ref.part ?? 0} sourceHash=${ref.sourceHash} mediaHash=${ref.mediaHash ?? "not available"}`
+            + (ref.page === undefined ? "" : ` page=${ref.page}`) + (ref.startMs === undefined ? "" : ` time=${ref.startMs}–${ref.endMs ?? "?"}ms`)
+            + `; original: ${readHint(source.handle ?? "")}; media record located and source bytes verified; this text result is not a fresh visual/audio analysis.`));
+        return [[cite(n), `  ${start ? "…" : ""}${safePrefix(snippet, 270)}`,
+            `  read: ${readHint(`open:${n.evidence}:${start}`)}`,
+            ...manifests,
+            ...(relevance ? [`  evidence relevance: ${relevance.relevance}; validated source quotes: ${JSON.stringify(relevance.quotes)}`] : []),
+            ...(n.corrects ? ["  corrects: " + clean(n.corrects).slice(0, 120)] : []),
+            ...correctedBy.map(c => "  explicitly corrected by " + cite(c)), ...nearby].join("\n")];
+    });
+    for (const block of result.archiveMatches ?? []) lines.push(`${block} [flattened archive locator; original speaker/time unavailable], ${foreignSessionId ? "open the source session or export its archive" : "inspect block via decompress"}; no attributable quote.`);
+    const warning = result.complete ? "" : "[Stored history coverage is incomplete; available recent messages were searched. A missing record is not evidence it never happened.]\n";
+    const archiveWarning = result.missingArchiveBlocks?.length
+        ? `[${result.missingArchiveBlocks.length} compressed range(s) lack typed original messages (${result.missingArchiveBlocks.slice(0, 8).join(", ")}); summaries and available archive locators do not prove complete original coverage.]\n` : "";
+    const semantic = result.semantic ? `[Semantic retrieval: ${result.semantic.coverage.state}; ${result.semantic.coverage.indexed} indexed, ${result.semantic.coverage.pending} pending, ${result.semantic.coverage.failed} failed; ${result.semantic.coverage.reason ?? "source-verified candidates; similarity is not factual support"}]\n`
+        + (result.semantic.relevance?.attempted ? `[Evidence review: ${result.semantic.relevance.sufficient === true ? "sufficient" : "uncertain"}; second-hop probes=${result.semantic.relevance.probes.length}; ${result.semantic.relevance.warnings.join("; ")}]\n` : "")
+        + (result.semantic.pairWarnings?.length ? `[Tool evidence: ${result.semantic.pairWarnings.join("; ")}]\n` : "") : "";
+    return lines.length ? warning + archiveWarning + semantic + `${scope} (${result.semantic ? "hybrid ranked search" : "indexed keyword search"}; order and neighboring statements alone do not establish a correction):\n${lines.join("\n\n")}` : warning + archiveWarning + semantic;
+}
+
+function metadata(m: SearchTranscriptRow): string {
+    const declared = typeof m.sourceKind === "string" ? clean(m.sourceKind).slice(0, 100) : "";
+    const envelope = m.role === "user" && /【(?:本次消息快照|内部|QQ|会话令牌|引导唤醒|唤醒提醒)/u.test(m.text ?? "");
+    const who = declared ? "source="+declared : envelope ? "bridge/internal envelope; attribution requires the enclosed message" : "author unverified";
+    const when = typeof m.timestamp === "number" || typeof m.timestamp === "string" ? String(m.timestamp).slice(0,64) : "unknown";
+    return `role=${m.role} ${who} time=${when}` + (m.toolName ? " tool="+clean(m.toolName).slice(0,100) : "");
+}
+
+/** Original-message recall is current-session only. Foreign-session delegation retains summary-only semantics. */
+export function searchEvidence(session: Session, query: string, limit: number, view: CoreMessage[], persisted: SearchTranscriptRow[], store?: MessageContentStore, observe?: (id: string, text: string) => void, options: { cache?: boolean } = {}): string {
+    const prepare = (key: string, source: string, attachment = "") => prepareText(session, key, source, attachment, options.cache !== false);
+    const read = /^open:(ev-[a-f0-9]{24})(?::(\d{1,12}))?$/.exec(query.trim());
+    const scoped = /^block:(b\d+)\s+(.+)$/is.exec(query);
+    const searchText=(scoped?.[2]??query).trim().toLowerCase();
+    const terms = [...new Set(searchText.split(/\s+/))];
+    const target = scoped ? session.state.blocks.find(b=>b.blockId===scoped[1]) : undefined;
+    if(scoped&&!target)return "[Unknown original-evidence block in this session.]";
+    const selectedIds=target ? new Set(target.effectiveMessageIds) : undefined;
+    const messages = new Map<string, SearchTranscriptRow>();
+    const add = (m: SearchTranscriptRow) => {
+        if (!m.id || m.contentType === "reasoning" || !["user","assistant","tool"].includes(m.role) || m.id.startsWith("acp_summary_")) return;
+        const prior=messages.get(m.id);
+        if (!prior) messages.set(m.id,m);
+        else if(m.text && !m.text.includes("📦")) messages.set(m.id,{
+            ...prior,...m,timestamp:m.timestamp??prior.timestamp,sourceKind:m.sourceKind??prior.sourceKind,
+            corrects:m.corrects??prior.corrects,attachment:m.attachment??prior.attachment
+        });
+    };
+    persisted.forEach(add);
+    for(const m of session.lastMessages??[]) add(fromWire(m));
+    for(const m of view) add(fromWire(m));
+
+    const refs=session.state.messageRefs.byRaw;
+    const coverage=new Map<string,string>();
+    for(const b of [...session.state.blocks].sort((x,y)=>Number(y.active)-Number(x.active)||x.tier-y.tier))
+        for(const id of b.effectiveMessageIds) if(!coverage.has(id)) coverage.set(id,b.blockId);
+    const notes:Note[]=[];
+    for(const m of messages.values()){
+        const ref=refs[m.id], stored=ref && store?.byRef[ref];
+        const original=stored && stored.rawId===m.id ? store?.byHash[stored.hash]:undefined;
+        const prepared=prepare(m.id,original??m.text??"",m.attachment??"");
+        if(!prepared.text) continue;
+        notes.push({...prepared,key:m.id,ref:ref?.startsWith("m")?ref:undefined,block:coverage.get(m.id),retrieve:original!==undefined,label:metadata(m),corrects:typeof m.corrects==="string"?m.corrects:undefined});
+    }
+    const messageCount=notes.length;
+    for(const block of session.state.blocks){
+        if(block.active)continue; // active summaries already have their own ranked section
+        const key="summary/"+block.blockId;
+        notes.push({...prepare(key,[block.topic,block.summary].filter(Boolean).join("\n")),key,label:"historical inactive summary; block time="+block.createdAt,block:block.blockId});
+    }
+    const identity=(n: Note)=>n.evidence;
+    const cite=(n:Note)=>`${clean(n.key).slice(0,160)}${n.ref?" "+n.ref:""}${n.block?" "+n.block:""} ${n.label}`;
+    if(read){
+        const n=notes.find(n=>identity(n)===read[1]);
+        if(!n)return "[Original evidence unavailable or changed in this session; repeat the keyword search.]";
+        const offset=Number(read[2]||0);
+        if(offset>=n.text.length)return "[Original evidence page is beyond the end.]";
+        const body=safePrefix(n.text.slice(offset),pageSize);
+        observe?.(n.key,body);
+        return `[Evidence: ${cite(n)} | ${offset}–${offset+body.length}/${n.text.length}]\n${body}`+(offset+body.length<n.text.length?`\n[next query: open:${read[1]}:${offset+body.length}]`:"");
+    }
+
+    const hits:Hit[]=[];
+    function consider(note:Note,order:number) {
+        if(selectedIds&&!selectedIds.has(note.key)&&note.key!=="summary/"+target?.blockId)return;
+        const body=note.lower;let score=0,at=-1;
+        for(const t of terms){const i=body.indexOf(t);if(i>=0){score++;if(at<0)at=i;}}
+        if(score===0)return;
+        if(body.includes(searchText)) score+=terms.length;
+        hits.push({note,score,at,order});
+    }
+    notes.forEach(consider);
+    hits.sort((a,b)=>b.score-a.score||b.order-a.order);
+    const renderHit=({note,order,at}:Hit)=>{
+        const start=Math.max(0,at-90);
+        observe?.(note.key,safePrefix(note.text.slice(start),270));
+        if(order<messageCount)for(const i of [order-1,order+1])if(i>=0&&i<messageCount)observe?.(notes[i]!.key,safePrefix(notes[i]!.text,125));
+        const nearby=order<messageCount?[order-1,order+1].filter(i=>i>=0&&i<messageCount).map(i=>`  ${i<order?"previous":"next"}: ${cite(notes[i]!)} — ${safePrefix(notes[i]!.text,125)}`):[];
+        const correctedBy=notes.filter(n=>n.corrects&&(n.corrects===note.key||n.corrects===note.ref)).slice(-3);
+        return [cite(note),`  ${start?"…":""}${safePrefix(note.text.slice(start),270)}`,
+            `  read: open:${identity(note)}:${start}`+(note.retrieve&&note.ref?` | acp_retrieve(${note.ref})`:""),
+            ...(note.corrects?["  corrects: "+clean(note.corrects).slice(0,120)]:[]),
+            ...correctedBy.map(n=>"  explicitly corrected by "+cite(n)),...nearby].join("\n");
+    };
+    const lines=hits.slice(0,limit).map(renderHit);
+    // Legacy full caches flattened speaker headers into arbitrary message text.
+    // Without typed records we can locate the block, but cannot authenticate
+    // individual message boundaries or safely quote private reasoning from it.
+    let legacy=0;
+    for(const b of session.state.blocks){
+        if(target&&b.blockId!==target.blockId)continue;
+        if(!b.effectiveMessageIds.some(id=>!messages.has(id)))continue;
+        const view=session.blockContents.get(b.blockId)?.full;
+        if(!view?.text)continue;
+        const searchable=prepare("archive/"+b.blockId,view.text).lower;
+        if(!terms.every(t=>searchable.includes(t)))continue;
+        if(legacy++>=Math.min(3,limit))break;
+        const ids=new Set(b.effectiveMessageIds);
+        const exact=hits.find(hit=>ids.has(hit.note.key)&&terms.every(t=>hit.note.lower.includes(t)));
+        if(exact)lines.push(`${b.blockId} [archived original match]\n${renderHit(exact)}`);
+        else lines.push(`${b.blockId} [flattened archive locator; original speaker/time unavailable], inspect block via decompress; no attributable quote.`);
+    }
+    return lines.length ? `Own-session historical evidence (keyword search; order and neighboring statements alone do not establish a correction):\n${lines.join("\n\n")}`:"";
+}
