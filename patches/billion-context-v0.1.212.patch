+++ b/src/storage/search-transcript-cache.ts
@@ -0,0 +1,68 @@
+import type { SqliteDatabase } from "./driver.js";
+import type { SearchTranscriptRow } from "./store.js";
+import { SearchLru } from "../search-cache.js";
+
+// Independent of session.prepare/markDirty: only actual searchable data mutations
+// advance this version, even when another connection performs an update/delete.
+// Tombstone version rows survive session deletion to prevent delete/recreate ABA.
+const ddl = `
+CREATE TABLE IF NOT EXISTS search_transcript_revisions (session_id TEXT PRIMARY KEY, revision INTEGER NOT NULL);
+CREATE TRIGGER IF NOT EXISTS search_transcript_insert AFTER INSERT ON messages BEGIN
+ INSERT INTO search_transcript_revisions VALUES (NEW.session_id,1) ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;
+CREATE TRIGGER IF NOT EXISTS search_transcript_delete AFTER DELETE ON messages BEGIN
+ INSERT INTO search_transcript_revisions VALUES (OLD.session_id,1) ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;
+CREATE TRIGGER IF NOT EXISTS search_transcript_update AFTER UPDATE OF session_id,seq,msg_id,role,kind,content_hash,retired_at,ts ON messages
+ WHEN OLD.session_id IS NOT NEW.session_id OR OLD.seq IS NOT NEW.seq OR OLD.msg_id IS NOT NEW.msg_id OR OLD.role IS NOT NEW.role OR OLD.kind IS NOT NEW.kind OR OLD.content_hash IS NOT NEW.content_hash OR OLD.retired_at IS NOT NEW.retired_at OR OLD.ts IS NOT NEW.ts BEGIN
+ INSERT INTO search_transcript_revisions VALUES (OLD.session_id,1) ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+ INSERT INTO search_transcript_revisions SELECT NEW.session_id,1 WHERE NEW.session_id IS NOT OLD.session_id
+ ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;
+CREATE TRIGGER IF NOT EXISTS search_transcript_content_update AFTER UPDATE OF bytes ON content WHEN OLD.bytes IS NOT NEW.bytes BEGIN
+ INSERT INTO search_transcript_revisions SELECT DISTINCT session_id,1 FROM messages WHERE content_hash=NEW.hash
+ ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;
+CREATE TRIGGER IF NOT EXISTS search_transcript_content_delete BEFORE DELETE ON content BEGIN
+ INSERT INTO search_transcript_revisions SELECT DISTINCT session_id,1 FROM messages WHERE content_hash=OLD.hash
+ ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;`;
+
+export class SearchTranscriptCache {
+    private cache = new SearchLru<string, { revision: number; rows: SearchTranscriptRow[] }>();
+    private schemaVersion: number | undefined;
+    private hits = 0;
+    private loads = 0;
+    constructor(private db: SqliteDatabase) {}
+    private revision(sessionId: string): number | null {
+        try {
+            const schema = Number((this.db.prepare("PRAGMA schema_version").get() as { schema_version: number }).schema_version);
+            if (schema !== this.schemaVersion) {
+                this.cache.clear();
+                const oldUpdate = this.db.prepare("SELECT sql FROM sqlite_master WHERE type='trigger' AND name='search_transcript_update'").get() as { sql: string } | undefined;
+                if (oldUpdate && !oldUpdate.sql.includes("OLD.ts IS NOT NEW.ts")) this.db.exec("DROP TRIGGER search_transcript_update");
+                this.db.exec(ddl);
+                this.schemaVersion = Number((this.db.prepare("PRAGMA schema_version").get() as { schema_version: number }).schema_version);
+            }
+            const row = this.db.prepare("SELECT revision FROM search_transcript_revisions WHERE session_id=?").get(sessionId) as { revision: number } | undefined;
+            return row?.revision ?? 0;
+        } catch { this.cache.clear(); this.schemaVersion = undefined; return null; }
+    }
+    read(sessionId: string, load: () => SearchTranscriptRow[]): SearchTranscriptRow[] {
+        const version = this.revision(sessionId);
+        const cached = version === null ? undefined : this.cache.get(sessionId);
+        if (cached?.revision === version) { this.hits++; return cached.rows; }
+        this.loads++;
+        const rows = load();
+        // A writer can commit between the two reads; never associate new rows with an old version.
+        if (version !== null && this.revision(sessionId) === version) {
+            const bytes = rows.reduce((n, r) => n + 256 + Object.values(r).reduce<number>((s, v) => s + (typeof v === "string" ? v.length * 2 : 16), 0), 0);
+            // Expose immutable projections, so a caller cannot poison another search using a cached array.
+            rows.forEach(Object.freeze); Object.freeze(rows);
+            this.cache.set(sessionId, { revision: version, rows }, bytes);
+        } else this.cache.delete(sessionId);
+        return rows;
+    }
+    clear(): void { this.cache.clear(); }
+    stats() { return { ...this.cache.stats(), hits: this.hits, loads: this.loads }; }
+}
