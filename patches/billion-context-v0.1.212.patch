@@ -0,0 +1,122 @@
+import { createHash } from "node:crypto";
+import { mkdtempSync, rmSync, statSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve, sep } from "node:path";
+import { createInitialState, type CoreMessage } from "acp-kernel";
+import type { Session } from "../src/session.js";
+import { UnifiedStore } from "../src/storage/store.js";
+import { openSqliteDatabase, type SqliteDatabase } from "../src/storage/driver.js";
+
+export const longHistorySession = "fts-synthetic-long-history";
+export const probes = [
+    { query: "岑舒", id: "history-120", quote: "岑舒把窗台画放进蓝色文件夹" },
+    { query: "青枔", id: "history-155", quote: "青枔想周末再看展览" },
+    { query: "autoFoldTargetTokens", id: "history-280", quote: "autoFoldTargetTokens=80000" },
+    { query: "RecentTokens", id: "history-290", quote: "preserveRecentTokens=32000" },
+    { query: "90%", id: "history-310", quote: "硬性安全阈值90%" },
+    { query: "E:/workspace/config.json", id: "history-350", quote: "E:/workspace/config.json" },
+    { query: "2026-11-04", id: "history-390", quote: "检验日期2026-11-04" },
+    { query: "延迟回忆", id: "history-460", quote: "延迟回忆需要保留触发线索" },
+] as const;
+
+type SyntheticMessage = CoreMessage & {
+    timestamp?: number;
+    source?: { kind: string };
+    corrects?: string;
+    attachment?: { description: string };
+};
+
+export function makeLongFixture(count = 20_000) {
+    const dir = mkdtempSync(join(tmpdir(), "bili-fts-long-"));
+    const file = join(dir, "index.db");
+    const store = UnifiedStore.open(file);
+    const db = (store as unknown as { db: SqliteDatabase }).db;
+    const writer = openSqliteDatabase(file).db;
+    const insertContent = db.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES (?,?,?)");
+    const insertMessage = db.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES (?,?,?,?,?,?)");
+    const state = createInitialState();
+    const session = { id: longHistorySession, state, metadata: {}, stats: {}, blockContents: new Map(), lastMessages: [] } as unknown as Session;
+    let sourceCharacters = 0, sourceBytes = 0;
+    const hashes = new Map<number, string>();
+    const insert = (seq: number, text: string, target = db, extra: Partial<SyntheticMessage> = {}) => {
+        const message: SyntheticMessage = {
+            id: `history-${seq}`, role: seq % 5 === 0 ? "tool" : seq % 2 === 0 ? "assistant" : "user",
+            contentType: "text", text, timestamp: 1_790_000_000_000 + seq * 60_000, source: { kind: "synthetic-benchmark" }, ...extra,
+        };
+        const raw = JSON.stringify(message), bytes = Buffer.from(raw), hash = createHash("sha256").update(raw).digest("hex");
+        if (target === db) {
+            insertContent.run(hash, bytes.length, bytes);
+            insertMessage.run(longHistorySession, seq, message.id, message.role, message.contentType, hash);
+        } else {
+            target.prepare("INSERT INTO content(hash,byte_len,bytes) VALUES (?,?,?)").run(hash, bytes.length, bytes);
+            target.prepare("INSERT INTO messages(session_id,seq,msg_id,role,kind,content_hash) VALUES (?,?,?,?,?,?)")
+                .run(longHistorySession, seq, message.id, message.role, message.contentType, hash);
+        }
+        hashes.set(seq, hash);
+        state.messageRefs.byRaw[message.id] = `m${String(seq).padStart(5, "0")}`;
+        sourceCharacters += text.length; sourceBytes += Buffer.byteLength(text);
+        return message;
+    };
+    const corpus = [
+        "工具返回的页面包含馆藏目录、照片说明、书籍索引和后续整理建议。每一条资料都保存出处，眼前展示的内容只作搜索测试。",
+        "整理扫描件时核对页码、纸张纹理与批注，记录尚未辨认的地名。完成这一步后再查看下一页，不把看起来相似的编号混为一谈。",
+        "The synthetic tool output lists document sections, image descriptions, versioned settings and reversible steps. This is generated benchmark data.",
+        "阅读日志保留动作已经完成还是仍待确认。发现新版本时先比较实际记录，旧摘要中的结论只用于定位，不代替原文。",
+    ];
+    for (let first = 1; first <= count; first += 250) db.transaction(() => {
+        for (let seq = first; seq < Math.min(first + 250, count + 1); seq++) {
+            const marker = probes.find(p => p.id === `history-${seq}`)?.quote ?? `普通合成条目 ${seq}，段落版本 ${(seq * 37) % 997}`;
+            const filler = Array.from({ length: 10 }, (_, part) => `${corpus[(seq + part) % corpus.length]} 区段${(seq * 17 + part * 19) % 10007}。`).join("\n");
+            insert(seq, `${marker}\n${filler}`);
+        }
+    });
+    db.exec("PRAGMA wal_checkpoint(TRUNCATE)");
+    const sourceDatabaseBytes = statSync(file).size;
+    const update = (seq: number, text: string) => {
+        const hash = hashes.get(seq);
+        if (!hash) throw new Error(`No fixture row ${seq}`);
+        const raw = writer.prepare("SELECT bytes FROM content WHERE hash=?").get(hash) as { bytes: Uint8Array };
+        const old = JSON.parse(Buffer.from(raw.bytes).toString("utf8")) as SyntheticMessage;
+        const bytes = Buffer.from(JSON.stringify({ ...old, text }));
+        writer.prepare("UPDATE content SET bytes=?,byte_len=? WHERE hash=?").run(bytes, bytes.length, hash);
+    };
+    return {
+        dir, file, db, store, writer, session, sourceDatabaseBytes, count,
+        get sourceCharacters() { return sourceCharacters; }, get sourceBytes() { return sourceBytes; },
+        insert, update,
+        readText(seq: number) {
+            const raw = writer.prepare("SELECT bytes FROM content WHERE hash=?").get(hashes.get(seq)) as { bytes: Uint8Array };
+            return (JSON.parse(Buffer.from(raw.bytes).toString("utf8")) as SyntheticMessage).text ?? "";
+        },
+        erase(seq: number) { writer.prepare("DELETE FROM messages WHERE session_id=? AND seq=?").run(longHistorySession, seq); },
+        retire(seq: number) { writer.prepare("UPDATE messages SET retired_at=42 WHERE session_id=? AND seq=?").run(longHistorySession, seq); },
+        async close(remove = true) {
+            writer.close(); await store.closeSearchIndex(); store.close();
+            if (!remove) return;
+            const absolute = resolve(dir), base = resolve(tmpdir()) + sep;
+            if (!absolute.startsWith(base) || !absolute.includes("bili-fts-long-")) throw new Error("Unexpected benchmark cleanup target");
+            for (let attempt = 0; attempt < 10; attempt++) {
+                try { rmSync(absolute, { recursive: true, force: true }); return; }
+                catch (error) { if (attempt === 9) throw error; await new Promise(r => setTimeout(r, 100)); }
+            }
+        },
+    };
+}
+
+export function timingSummary(values: number[]) {
+    const sorted = [...values].sort((a, b) => a - b);
+    const p = (q: number) => Number((sorted[Math.max(0, Math.ceil(q * sorted.length) - 1)] ?? 0).toFixed(2));
+    return { samples: values.length, p50Ms: p(0.5), p95Ms: p(0.95), maxMs: p(1) };
+}
+
+export async function withHeartbeat<T>(operation: () => Promise<T> | T) {
+    let ticks = 0, maxGap = 0, last = performance.now();
+    const start = last;
+    const timer = setInterval(() => { const now = performance.now(); ticks++; maxGap = Math.max(maxGap, now - last); last = now; }, 10);
+    try {
+        const result = await operation();
+        const elapsedMs = performance.now() - start;
+        await new Promise(r => setTimeout(r, 15));
+        return { result, elapsedMs: Number(elapsedMs.toFixed(2)), heartbeatTicks: ticks, maxHeartbeatGapMs: Number(maxGap.toFixed(2)) };
+    } finally { clearInterval(timer); }
+}
