+    }
+    const identity=(n: Note)=>n.evidence;
+    const cite=(n:Note)=>`${clean(n.key).slice(0,160)}${n.ref?" "+n.ref:""}${n.block?" "+n.block:""} ${n.label}`;
+    if(read){
+        const n=notes.find(n=>identity(n)===read[1]);
+        if(!n)return "[Original evidence unavailable or changed in this session; repeat the keyword search.]";
+        const offset=Number(read[2]||0);
+        if(offset>=n.text.length)return "[Original evidence page is beyond the end.]";
+        const body=safePrefix(n.text.slice(offset),pageSize);
+        observe?.(n.key,body);
+        return `[Evidence: ${cite(n)} | ${offset}–${offset+body.length}/${n.text.length}]\n${body}`+(offset+body.length<n.text.length?`\n[next query: open:${read[1]}:${offset+body.length}]`:"");
+    }
+
+    const hits:Hit[]=[];
+    function consider(note:Note,order:number) {
+        if(selectedIds&&!selectedIds.has(note.key)&&note.key!=="summary/"+target?.blockId)return;
+        const body=note.lower;let score=0,at=-1;
+        for(const t of terms){const i=body.indexOf(t);if(i>=0){score++;if(at<0)at=i;}}
+        if(score===0)return;
+        if(body.includes(searchText)) score+=terms.length;
+        hits.push({note,score,at,order});
+    }
+    notes.forEach(consider);
+    hits.sort((a,b)=>b.score-a.score||b.order-a.order);
+    const renderHit=({note,order,at}:Hit)=>{
+        const start=Math.max(0,at-90);
+        observe?.(note.key,safePrefix(note.text.slice(start),270));
+        if(order<messageCount)for(const i of [order-1,order+1])if(i>=0&&i<messageCount)observe?.(notes[i]!.key,safePrefix(notes[i]!.text,125));
+        const nearby=order<messageCount?[order-1,order+1].filter(i=>i>=0&&i<messageCount).map(i=>`  ${i<order?"previous":"next"}: ${cite(notes[i]!)} — ${safePrefix(notes[i]!.text,125)}`):[];
+        const correctedBy=notes.filter(n=>n.corrects&&(n.corrects===note.key||n.corrects===note.ref)).slice(-3);
+        return [cite(note),`  ${start?"…":""}${safePrefix(note.text.slice(start),270)}`,
+            `  read: open:${identity(note)}:${start}`+(note.retrieve&&note.ref?` | acp_retrieve(${note.ref})`:""),
+            ...(note.corrects?["  corrects: "+clean(note.corrects).slice(0,120)]:[]),
+            ...correctedBy.map(n=>"  explicitly corrected by "+cite(n)),...nearby].join("\n");
+    };
+    const lines=hits.slice(0,limit).map(renderHit);
+    // Legacy full caches flattened speaker headers into arbitrary message text.
+    // Without typed records we can locate the block, but cannot authenticate
+    // individual message boundaries or safely quote private reasoning from it.
+    let legacy=0;
+    for(const b of session.state.blocks){
+        if(target&&b.blockId!==target.blockId)continue;
+        if(!b.effectiveMessageIds.some(id=>!messages.has(id)))continue;
+        const view=session.blockContents.get(b.blockId)?.full;
+        if(!view?.text)continue;
+        const searchable=prepare("archive/"+b.blockId,view.text).lower;
+        if(!terms.every(t=>searchable.includes(t)))continue;
+        if(legacy++>=Math.min(3,limit))break;
+        const ids=new Set(b.effectiveMessageIds);
+        const exact=hits.find(hit=>ids.has(hit.note.key)&&terms.every(t=>hit.note.lower.includes(t)));
+        if(exact)lines.push(`${b.blockId} [archived original match]\n${renderHit(exact)}`);
+        else lines.push(`${b.blockId} [flattened archive locator; original speaker/time unavailable], inspect block via decompress; no attributable quote.`);
+    }
+    return lines.length ? `Own-session historical evidence (keyword search; order and neighboring statements alone do not establish a correction):\n${lines.join("\n\n")}`:"";
+}
