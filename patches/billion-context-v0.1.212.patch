+            sourceKind: text(object(value.source).kind), corrects: text(value.corrects),
+            timestamp: typeof value.timestamp === "number" || typeof value.timestamp === "string" ? value.timestamp : typeof raw.ts === "number" ? raw.ts : null,
+            attachment: [object(value.attachment).description, part.description, part.title, part.filename, part.alt, value.imageMediaType].map(text).find(Boolean) ?? "" });
+        const rawText = text(raw.content);
+        const media = extractMedia(value);
+        return { row, sourceHash: hash(rawText), media };
+    }
+    mediaBytes(media: SourceMedia, maxBytes: number): Uint8Array | null {
+        try { return resolveMediaBytes(media, { db: this.db ?? undefined, allowedRoots: this.allowedRoots(), maxBytes }); } catch { return null; }
+    }
+    verify(ref: SourceRef, overlay?: Map<string, SourceRecord | null>): SourceRecord | null {
