+++ b/tests/semantic-provider-media.test.ts
@@ -0,0 +1,158 @@
+import test, { type TestContext } from "node:test";
+import assert from "node:assert/strict";
+import { PDFDocument } from "pdf-lib";
+import { defaults } from "../src/semantic-settings.js";
+import { embed, resolveSemanticKey, SemanticProviderError } from "../src/semantic/provider.js";
+import { prepareMedia } from "../src/semantic/media.js";
+import type { EmbeddingInput, SourceRef } from "../src/semantic/types.js";
+
+function env(t: TestContext, name: string, value: string | undefined) { const prior = process.env[name]; if (value === undefined) delete process.env[name]; else process.env[name] = value; t.after(() => { if (prior === undefined) delete process.env[name]; else process.env[name] = prior; }); }
+const config = { ...defaults, keyEnv: "BILI_SYNTHETIC_EMBEDDING_KEY", retries: 0, dimensions: 768, mediaEnabled: true };
+const text = (id = "one", kind: "query" | "document" = "document"): EmbeddingInput => ({ id, kind, parts: [{ text: "合成测试，岑舒在窗边画蓝色花盆。" }] });
+const sourceRef: SourceRef = { sessionId: "synthetic-session", messageId: "synthetic-message", sourceHash: "a".repeat(64), start: 0, end: 1 };
+const vector = () => Array.from({ length: config.dimensions }, (_, i) => i === 0 ? 1 : 0);
+const json = (value: unknown, status = 200, headers: Record<string, string> = {}) => new Response(JSON.stringify(value), { status, headers });
+function wav(seconds: number): Buffer {
+    const rate = 8000, size = seconds * rate * 2, bytes = Buffer.alloc(44 + size);
+    bytes.write("RIFF"); bytes.writeUInt32LE(36 + size, 4); bytes.write("WAVEfmt ", 8); bytes.writeUInt32LE(16, 16);
+    bytes.writeUInt16LE(1, 20); bytes.writeUInt16LE(1, 22); bytes.writeUInt32LE(rate, 24); bytes.writeUInt32LE(rate * 2, 28); bytes.writeUInt16LE(2, 32); bytes.writeUInt16LE(16, 34); bytes.write("data", 36); bytes.writeUInt32LE(size, 40);
+    return bytes;
+}
+
+test("distinct contents use separate count+embed requests, retrieval prefixes and finite normalized vectors", async t => {
+    env(t, config.keyEnv, "synthetic-secret-do-not-log");
+    const calls: { url: string; payload: Record<string, unknown> }[] = [];
+    t.mock.method(globalThis, "fetch", async (url: string, init: RequestInit) => {
+        calls.push({ url, payload: JSON.parse(String(init.body)) });
+        assert.equal(new Headers(init.headers).get("x-goog-api-key"), "synthetic-secret-do-not-log");
+        assert.equal(init.redirect, "error");
+        return url.endsWith(":countTokens") ? json({ totalTokens: 12 }) : json({ embedding: { values: vector() }, usageMetadata: { promptTokenCount: 12, totalTokenCount: 12 } });
+    });
+    const result = await embed([text("doc"), text("query", "query")], config);
+    assert.equal(calls.length, 4); assert.equal(result.items.length, 2);
+    assert.equal(result.usage.requestCount, 4); assert.equal(result.usage.countRequests, 2); assert.equal(result.usage.totalTokenCount, 24);
+    assert.match(JSON.stringify(calls[1].payload), /title: none \| text:/);
+    assert.match(JSON.stringify(calls[3].payload), /task: search result \| query:/);
+    assert.ok(!calls.some(c => "taskType" in c.payload));
+    assert.equal(result.items[0].vector.length, 768);
+});
+
+test("overfull inputs fail after counting, before any embedding truncates them", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let n = 0;
+    t.mock.method(globalThis, "fetch", async () => { n++; return json({ totalTokens: 8193 }); });
+    await assert.rejects(embed([text()], config), /split it before embedding/); assert.equal(n, 1);
+});
+
+test("provider failures expose status only; authorization errors are not retried", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let n = 0;
+    t.mock.method(globalThis, "fetch", async () => { n++; return json({ error: { message: "synthetic-secret and private source text" } }, 401); });
+    await assert.rejects(embed([text()], { ...config, retries: 3 }), error => {
+        assert.ok(error instanceof SemanticProviderError); assert.equal(error.status, 401); assert.equal(error.retryable, false);
+        assert.ok(!error.message.includes("secret")); assert.ok(!error.message.includes("private")); return true;
+    }); assert.equal(n, 1);
+});
+
+test("429 retries with backoff and retry counts remain visible", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let n = 0;
+    t.mock.method(globalThis, "fetch", async (url: string) => {
+        if (++n === 1) return json({}, 429, { "retry-after": "0" });
+        return url.endsWith(":countTokens") ? json({ totalTokens: 9 }) : json({ embedding: { values: vector() } });
+    });
+    const result = await embed([text()], { ...config, retries: 1 }); assert.equal(result.usage.requestCount, 3); assert.equal(result.usage.countRequests, 2);
+});
+
+test("every HTTP attempt obtains budget first and a refused retry never reaches the provider", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let called = 0; const charged: string[] = [];
+    t.mock.method(globalThis, "fetch", async () => { called++; return json({}, 429); });
+    await assert.rejects(embed([text()], { ...config, retries: 3 }, undefined, {
+        beforeRequest(info) { charged.push(`${info.method}:${info.attempt}`); if (charged.length > 1) throw Error("Synthetic request budget exhausted"); },
+    }), /budget exhausted/);
+    assert.equal(called, 1); assert.deepEqual(charged, ["countTokens:0", "countTokens:1"]);
+});
+
+test("successful usage is recorded before a later input fails", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let called = 0, charged = 0, tokens = 0;
+    t.mock.method(globalThis, "fetch", async () => {
+        called++;
+        return called === 1 ? json({ totalTokens: 14 }) : called === 2 ? json({ embedding: { values: vector() } }) : json({}, 403);
+    });
+    await assert.rejects(embed([text("one"), text("two")], config, undefined, { beforeRequest() { charged++; }, onUsage(u) { tokens += u.totalTokenCount; } }), /403/);
+    assert.equal(charged, 3); assert.equal(tokens, 14);
+});
+
+test("aborted requests do not retry or call a provider", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let calls = 0;
+    t.mock.method(globalThis, "fetch", async () => { calls++; return json({}); });
+    const controller = new AbortController(); controller.abort();
+    await assert.rejects(embed([text()], config, controller.signal), /cancelled/); assert.equal(calls, 0);
+});
+
+test("transport timeout remains a transient error and consumes attempts, not silent success", async t => {
+    env(t, config.keyEnv, "synthetic-secret"); let requests = 0;
