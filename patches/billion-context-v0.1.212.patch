+import { createHash } from "node:crypto";
+import { DatabaseSync } from "node:sqlite";
+import { cleanSearchText, prepareSearchText } from "../search-text.js";
+import type { SearchTranscriptRow } from "../storage/store.js";
+import type { SearchIndexRow } from "../storage/search-index-types.js";
+import type { SourceRef } from "./types.js";
+import { extractMedia, resolveMediaBytes, type SourceMedia } from "./media-source.js";
+export type { SourceMedia } from "./media-source.js";
+
+export const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+export const hashBytes = (value: Uint8Array) => createHash("sha256").update(value).digest("hex");
+export const object = (value: unknown): Record<string, unknown> => value !== null && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
+const text = (value: unknown) => typeof value === "string" ? value : "";
+export interface SourceRecord { row: SearchIndexRow; sourceHash: string; media: SourceMedia[] }
+export function eligible(row: SearchTranscriptRow) { return !!row.id && row.contentType !== "reasoning" && ["user", "assistant", "tool"].includes(row.role) && !row.id.startsWith("acp_summary_"); }
+export function sanitized(row: SearchIndexRow): SearchIndexRow {
+    return { id: row.id, seq: row.seq, role: row.role, contentType: row.contentType,
+        text: cleanSearchText(text(row.text)), attachment: cleanSearchText(text(row.attachment)), toolName: cleanSearchText(text(row.toolName)), toolCallId: text(row.toolCallId),
+        sourceKind: cleanSearchText(text(row.sourceKind)), corrects: cleanSearchText(text(row.corrects)), timestamp: row.timestamp };
+}
+export function overlayRecord(row: SearchTranscriptRow, seq = 0): SourceRecord {
+    const clean = sanitized({ ...row, seq });
+    const media = row.media ?? [];
+    return { row: clean, sourceHash: hash(JSON.stringify([clean, media.map(item => [item.hash, item.mimeType, item.part])])), media };
+}
+export function recordText(record: SourceRecord, sessionId: string) {
+    return prepareSearchText(sessionId, record.row.id, record.row.text ?? "", record.row.attachment ?? "");
+}
+export function quoteRow(record: SourceRecord, sessionId: string, offset = 0, count = 1600): SearchIndexRow {
+    const prepared = recordText(record, sessionId);
+    return { ...record.row, text: prepared.text.slice(0, 160), prepared: { text: prepared.text.slice(offset, offset + count),
+        evidence: prepared.evidence, offset, totalChars: prepared.text.length } };
+}
+/** Canonical source is always opened read-only; vector storage has no authority over it. */
+export class SemanticSource {
+    readonly db: DatabaseSync | null;
+    constructor(file: string | null, private readonly allowedRoots: () => string[] = () => []) { this.db = file ? new DatabaseSync(file, { readOnly: true }) : null; this.db?.exec("PRAGMA busy_timeout=3000"); }
