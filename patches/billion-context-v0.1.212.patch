+    private transferred = { overlayRows: 0, overlayChars: 0, summaryRows: 0, archiveRows: 0 };
+    private pending = new Map<number, { sessionId: string; resolve: (value: SearchIndexResult | null) => void; timer: ReturnType<typeof setTimeout> | null; committed: number }>();
+    private readonly inactivityTimeoutMs: number;
