new file mode 100644
index 0000000000000000000000000000000000000000..84e48619600d7d353243300a2d46bac9ff7b7ae1
--- /dev/null
+++ b/src/collaborative-background.ts
@@ -0,0 +1,161 @@
+import { isDeepStrictEqual } from "node:util";
+import type { CoreMessage, CompressionBlock, CompressibleRange } from "acp-kernel";
+import { type ParsedRange } from "./compress-tool.js";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+import { backgroundFoldCancellations, compressionDraft } from "./collaborative-transaction.js";
+import { applyConfiguredCompressionInner } from "./external-summary-compress.js";
+import { planHistory } from "./collaborative-planner.js";
+import { deferredCandidatesCovered } from "./preflight.js";
+import { epochConfirmPending } from "./fold-reconcile.js";
+import { markDirty, type Session } from "./session.js";
+import { applyRanges, type RewriteCtx } from "./stream.js";
+
+type Ticket = {
+    key: string;
+    finished?: boolean;
+    invalidated?: boolean;
+    publish?: (current: RewriteCtx) => void;
+};
+const tickets = new WeakMap<Session, Ticket>();
+const waits = new WeakMap<Session, { key: string; ranges: CompressibleRange[]; until: number }>();
+
+function completeToolBoundary(messages: CoreMessage[]) {
+    const pending = new Set<string>();
+    for (const message of messages) {
+        if (message.contentType === "tool-call") {
+            if (!message.toolCallId) return false;
+            pending.add(message.toolCallId);
+        } else if (message.contentType === "tool-result" && message.toolCallId) {
+            pending.delete(message.toolCallId);
+        }
+    }
+    return !pending.size;
+}
+
+function coverage(block: CompressionBlock) {
+    return [block.startRef, block.endRef, block.topic, block.summary, block.effectiveMessageIds, block.directMessageIds, block.directBlockIds];
+}
+
+// Replay only the exact approved batch. The live kernel recalculates protection,
+// tool pairs, counters, refs and overlaps rather than installing an old state.
+function publisher(before: Session, reviewed: Session, messages: CoreMessage[], ranges: ParsedRange[]) {
+    const anchors = new Set(ranges.map(range => range.compressCallId));
+    const selected = (session: Session) => session.state.blocks.filter(block => block.compressCallId && anchors.has(block.compressCallId));
+    const blocks = selected(reviewed);
+    if (blocks.length !== ranges.length) throw Error("Unreplayable reviewed block batch");
+    const ids = new Set(blocks.flatMap(block => block.effectiveMessageIds));
+    const originals = new Map([...before.lastMessages ?? [], ...messages].filter(m => ids.has(m.id)).map(m => [m.id, m]));
+    const sourceBlocks = before.state.blocks.filter(b => b.effectiveMessageIds.some(id => ids.has(id)));
+    const originalRefs = new Map([...ids].map(id=>[id,before.state.messageRefs.byRaw[id]]));
+    const sourceContents = new Map(sourceBlocks.map(block=>[block.blockId,before.blockContents.get(block.blockId)]));
+    const reviewedContents = new Map(blocks.map(block=>[block.blockId,reviewed.blockContents.get(block.blockId)]));
+    return (ctx: RewriteCtx) => {
+        const current = new Map([...ctx.session.lastMessages ?? [], ...ctx.messages].map(m => [m.id, m]));
+        for (const id of ids) {
+            if (originalRefs.get(id) !== ctx.session.state.messageRefs.byRaw[id] ||
+                !isDeepStrictEqual(originals.get(id), current.get(id))) throw Error("Covered message or reference changed");
+            if (!originals.has(id) && !sourceBlocks.some(b => b.effectiveMessageIds.includes(id) && sourceContents.get(b.blockId)?.full)) throw Error("Missing original");
+        }
+        const liveBlocks = ctx.session.state.blocks.filter(b => b.effectiveMessageIds.some(id => ids.has(id)));
+        if (liveBlocks.length !== sourceBlocks.length) throw Error("Overlapping compression changed");
+        for (const block of sourceBlocks) {
+            const live = liveBlocks.find(b => b.blockId === block.blockId);
+            if (!live || live.active !== block.active || live.restoredInline !== block.restoredInline ||
+                !isDeepStrictEqual(coverage(live), coverage(block)) ||
+                !isDeepStrictEqual(ctx.session.blockContents.get(block.blockId), sourceContents.get(block.blockId))) throw Error("Source block changed");
+        }
+        const txn = compressionDraft(ctx.session);
+        const applied = applyRanges({ ranges, diagnostics: {ok:true,kind:"ok",invalidItems:0} }, {...ctx, session: txn.draft});
+        const added = selected(txn.draft);
+        if (applied.outcome !== "applied" || !isDeepStrictEqual(added.map(coverage), blocks.map(coverage))) throw Error("Current range or protection changed");
+        for (let i = 0; i < blocks.length; i++) {
+            const content = reviewedContents.get(blocks[i].blockId);
+            if (!content?.full || content.full.count !== new Set(blocks[i].effectiveMessageIds).size) throw Error("Missing reviewed originals");
+            txn.draft.blockContents.set(added[i].blockId, content);
+        }
+        txn.commit();
+    };
+}
+
+// Called at the request boundary, inside the existing session lock. A published
+// batch is re-prepared by the caller; no network operation runs inside its commit.
+export function takeBackgroundFold(ctx: RewriteCtx, key: string): boolean {
+    const job = tickets.get(ctx.session);
+    if (!job) return false;
+    if (job.key !== key) {
+        job.invalidated = true;
+        void backgroundFoldCancellations.get(ctx.session)?.();
+        return false;
+    }
+    if (!job.finished || job.invalidated) return false;
+    if (!completeToolBoundary(ctx.messages)) return false;
+    tickets.delete(ctx.session);
+    backgroundFoldCancellations.delete(ctx.session);
+    if (!job.publish || epochConfirmPending(ctx.session)) return false;
+    try { job.publish(ctx); ctx.log("[collaborative background] committed at a completed tool boundary"); return true; }
+    catch (error) { ctx.log("[collaborative background] discarded: " + String(error)); return false; }
+}
+
+export function startBackgroundFold(ctx: RewriteCtx, ranges: CompressibleRange[], key: string): void {
+    const {session, config} = ctx;
+    if (tickets.has(session) || epochConfirmPending(session) || !ranges.length) return;
+    if (Number(session.metadata.autoFoldBackoffUntil) > Date.now()) return;
+    const prior = waits.get(session);
+    if (prior?.key === key && prior.until > Date.now() && deferredCandidatesCovered(prior.ranges, ranges,
+        new Map(ctx.messages.map((m,i)=>[session.state.messageRefs.byRaw[m.id],i])), config.modelContextLimit)) return;
+    // Request-owned message objects are replaced (never reused as scratch) by
+    // prepare. Capture only the array and its stable refs until planning says now.
+    const messages = ctx.messages.slice();
+    const refs = messages.map(m => session.state.messageRefs.byRaw[m.id]);
+    const candidates = ranges.map(r => ({startId:r.startRef, endId:r.endRef}));
+    const ticket: Ticket = {key};
+    tickets.set(session, ticket);
+    const controller = new AbortController();
+    const run = async () => {
+        const decision = await planHistory(config as ResolvedKernelConfig, session, messages, candidates, false, controller.signal);
+        controller.signal.throwIfAborted();
+        if (decision.decision === "wait" || decision.decision === "uncertain") {
+            waits.set(session, {key, ranges, until: Date.now()+30*60_000});
+            return;
+        }
+        const selected = decision.decision === "legacy" ? candidates.slice(0,1) : decision.ranges;
+        const indices = new Map(refs.map((ref,index)=>[ref,index]));
+        for (const range of selected) {
+            const start = indices.get(range.startId), end = indices.get(range.endId);
+            if (start === undefined || end === undefined || end < start) return;
+            for (let i=start; i<=end; i++) {
+                if (session.state.messageRefs.byRaw[messages[i].id] !== refs[i]) return;
+            }
+        }
+        const base = compressionDraft(session).draft;
+        const reviewed = compressionDraft(base).draft;
+        let batch: ParsedRange[] | undefined;
+        const result = await applyConfiguredCompressionInner({content:selected}, {...ctx, session:reviewed, messages}, undefined,
+            controller.signal, "auto", undefined, ready => { batch=ready; });
+        controller.signal.throwIfAborted();
+        if (result.reason === "noop") { ctx.log("[collaborative background] selected history already covered; no new fold"); return; }
+        if (result.outcome !== "applied" || !batch) throw Error(result.text);
+        ticket.publish = publisher(base, reviewed, messages, batch);
+    };
+    ctx.log("[collaborative background] reviewing eligible history; foreground continues");
+    const done = run().catch(error => {
+        if (controller.signal.aborted) return;
+        session.metadata.autoFoldBackoffUntil=Date.now()+10*60_000;
+        markDirty(session);
+        ctx.log("[collaborative background] originals retained: "+String(error));
+    }).finally(() => {
+        ticket.finished=true;
+        if (!ticket.publish && tickets.get(session)===ticket) {
+            tickets.delete(session);
+            backgroundFoldCancellations.delete(session);
+        }
+    });
+    backgroundFoldCancellations.set(session, async () => {
+        controller.abort();
+        await done;
+        if (tickets.get(session)===ticket) {
+            tickets.delete(session);
+            backgroundFoldCancellations.delete(session);
+        }
+    });
+}
diff --git a/src/collaborative-planner.ts b/src/collaborative-planner.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ee2f51b4b5ee0f55d3d70c86a28fc8271610083
--- /dev/null
+++ b/src/collaborative-planner.ts
@@ -0,0 +1,44 @@
+import type { CoreMessage } from "acp-kernel";
+import type { Session } from "./session.js";
+import type { ResolvedKernelConfig } from "./compress-settings.js";
+import { SummaryCredentialStore } from "./external-summary-credentials.js";
+export type PlanRange = { startId: string; endId: string };
+export type PlanDecision = { decision: "now" | "wait" | "uncertain" | "legacy"; ranges: PlanRange[]; reason: string };
+/** Model proposes only; eligible boundaries and the kernel's atomic preview remain authoritative. */
+export async function planHistory(config: ResolvedKernelConfig, session: Session, messages: CoreMessage[], ranges: PlanRange[], manual: boolean, signal?: AbortSignal): Promise<PlanDecision> {
+    if (config.externalSummary?.modelPlanning === false) return {decision:"legacy",ranges:[],reason:"Model planning disabled"};
+    if (!ranges.length) return { decision: "wait", ranges: [], reason: "No eligible history" };
+    const target = config.externalSummary?.targets.find(t => t.model === "dsh-collaborative-v1");
+    if (!target) throw new Error("Collaborative planner target missing");
+    const url = new URL(target.url);
+    if (!["127.0.0.1", "localhost", "[::1]"].includes(url.hostname) || url.protocol !== "http:") throw new Error("Planner requires the authenticated local adapter");
+    url.pathname = "/v1/plan";
+    const key = target.apiKey ?? new SummaryCredentialStore().resolve(target.credentialRef ?? "", process.env);
+    if (!key) throw new Error("Planner credential unavailable");
+    const rows = messages.map((m, i) => ({ ref: session.state.messageRefs.byRaw[m.id], index: i, role: m.role, text: (m.text ?? "").slice(0,500), excerpt: (m.text?.length ?? 0) > 500 }));
+    const positions = new Map(rows.filter(r=>r.ref).map(r => [r.ref, r.index]));
+    const eligible = ranges.filter(r => positions.has(r.startId) && positions.has(r.endId));
+    const visible = rows.filter(r => r.ref && eligible.some(e => r.index >= positions.get(e.startId)! && r.index <= positions.get(e.endId)!));
+    const input = { manual, contextLimit: config.modelContextLimit, latestUsageTokens: session.stats.lastInputTokens,
+        recentProtectedTokens: config.preserveRecentTokens, candidates: eligible,
+        messages: visible.length > 600 ? [...visible.slice(0,500), ...visible.slice(-100)] : visible,
+        omittedMessageCount: Math.max(0,visible.length-600), recentContext: rows.slice(-6) };
+    const timeout = AbortSignal.timeout(config.externalSummary?.budget.totalTimeoutMs ?? 180000);
+    const response = await fetch(url, { method: "POST", headers: { authorization: "Bearer " + key, "content-type": "application/json" }, body: JSON.stringify(input), signal: signal ? AbortSignal.any([signal, timeout]) : timeout });
+    if (!response.ok) {
+        const body = await response.json().catch(() => null);
+        const receipt = String(body && typeof body==="object" && "error" in body ? body.error : "").match(/run=[0-9a-f-]{36} stage=planning\b/)?.[0] || "";
+        throw new Error("Planner HTTP " + response.status + " " + receipt);
+    }
+    const p = await response.json() as PlanDecision;
+    if (!["now","wait","uncertain","legacy"].includes(p.decision) || !Array.isArray(p.ranges) || p.ranges.length>32) throw new Error("Invalid planner response");
+    if(p.decision === "legacy") return p;
+    if ((p.decision === "now") !== (p.ranges.length > 0)) throw new Error("Invalid planner action");
+    const selected: Array<[number,number]> = [];
+    for (const r of p.ranges) {
+        const a=positions.get(r.startId), b=positions.get(r.endId);
+        if(a===undefined||b===undefined||a>b||!eligible.some(e=>a>=positions.get(e.startId)!&&b<=positions.get(e.endId)!)||selected.some(([x,y])=>a<=y&&b>=x)) throw new Error("Planner selected an invalid or overlapping range");
+        selected.push([a,b]);
+    }
+    return p;
+}
