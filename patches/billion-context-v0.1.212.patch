+test("prepared evidence reuses redaction and normalized text, with same-length in-memory edits and scope changes detected",()=>{
+ const state=createInitialState(),messages:CoreMessage[]=[{id:"x",role:"tool",contentType:"text",text:"needleA "+"资料".repeat(10000)+" token=abcdef__123456789"}];
